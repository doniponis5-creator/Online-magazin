// Редактор фото товара (расширение ИМ_ОнлайнМагазин): обрезка, масштаб, поворот, белый фон.
// Параметры: АдресКартинки — адрес исходного фото во временном хранилище,
// ИдентификаторВладельца — форма, в хранилище которой помещается результат.
// Возвращает адрес готового JPEG или Неопределено при отмене.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Данные = ПолучитьИзВременногоХранилища(Параметры.АдресКартинки);
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ИдентификаторВладельца = Параметры.ИдентификаторВладельца;
	ТекстHTML = ИМ_ОнлайнМагазинСервер.ТекстРедактораФото(Данные);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РедакторДокументСформирован(Элемент)

	Готово = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)

	Если НЕ Готово Тогда
		ПоказатьПредупреждение(, "Фото ещё загружается, подождите секунду.");
		Возврат;
	КонецЕсли;

	Документ = Элементы.Редактор.Документ;
	Документ.defaultView.imExport();
	Результат = Документ.getElementById("im-out").value;
	Если ПустаяСтрока(Результат) Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить фото. Попробуйте открыть другой файл (JPG или PNG).");
		Возврат;
	КонецЕсли;

	Адрес = СохранитьРезультат(Результат, ИдентификаторВладельца);
	Если Адрес = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось сохранить фото.");
		Возврат;
	КонецЕсли;
	Закрыть(Адрес);

КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)

	Закрыть(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СохранитьРезультат(Текст, ИдентификаторВладельца)

	Данные = ИМ_ОнлайнМагазинСервер.ДвоичныеДанныеИзDataURL(Текст);
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Данные, ИдентификаторВладельца);

КонецФункции

#КонецОбласти
