// Общий модуль ИМ_ОнлайнМагазинСервер (расширение ИМ_ОнлайнМагазин).
// Цены, остатки, настройки и фото товаров для сайта. Основная конфигурация не изменяется.

#Область ПрограммныйИнтерфейс

// Значения наличия на сайте. Пустая строка в регистре = «По остатку».
Функция ВариантыНаличия() Экспорт

	Возврат СтрРазделить("По остатку,В наличии,Нет в наличии", ",");

КонецФункции

// Помещает себестоимость единицы товара во временную таблицу ВТ_Себестоимость
// (Номенклатура, Себестоимость) по остаткам регистра СебестоимостьТоваров.
// Возвращает Истина, если регистр прочитан. Для товаров без остатка себестоимость неизвестна (0).
Функция ПодготовитьСебестоимость(МенеджерВТ, Отбор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СебО.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА СУММА(СебО.КоличествоОстаток) > 0
	|			ТОГДА СУММА(СебО.СтоимостьОстаток) / СУММА(СебО.КоличествоОстаток)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Себестоимость
	|ПОМЕСТИТЬ ВТ_Себестоимость
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.Остатки(" + ?(Отбор = Неопределено, "",
		", АналитикаУчетаНоменклатуры.Номенклатура В (&Отбор)") + ") КАК СебО
	|
	|СГРУППИРОВАТЬ ПО
	|	СебО.АналитикаУчетаНоменклатуры.Номенклатура";
	Запрос.УстановитьПараметр("Отбор", Отбор);
	Попытка
		Запрос.Выполнить();
		Возврат Истина;
	Исключение
		// Регистр недоступен в этой версии конфигурации — пустая таблица с нужной структурой.
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
		|	0 КАК Себестоимость
		|ПОМЕСТИТЬ ВТ_Себестоимость
		|ГДЕ
		|	ЛОЖЬ";
		Запрос.Выполнить();
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции


// Сведения о товаре для карточки: остаток, цена продажи, настройки сайта.
Функция СведенияОТоваре(Номенклатура) Экспорт

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЕстьСебестоимость = ПодготовитьСебестоимость(МенеджерВТ, Номенклатура);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Код КАК Код,
	|	Н.Артикул КАК Артикул,
	|	ЕСТЬNULL(Н.Родитель.Наименование, """") КАК ГруппаТовара,
	|	ЕСТЬNULL(Остатки.ВНаличии, 0) КАК Остаток,
	|	ЕСТЬNULL(Себест.Себестоимость, 0) КАК Себестоимость,
	|	ЕСТЬNULL(Настройки.Скрыть, ЛОЖЬ) КАК Скрыть,
	|	ЕСТЬNULL(Настройки.Наличие, """") КАК Наличие,
	|	ЕСТЬNULL(Настройки.ЦенаСайта, 0) КАК ЦенаСайта,
	|	ЕСТЬNULL(Настройки.СтараяЦена, 0) КАК СтараяЦена,
	|	ЕСТЬNULL(Настройки.Распродажа, ЛОЖЬ) КАК Распродажа,
	|	ЕСТЬNULL(Настройки.ТоварДня, ЛОЖЬ) КАК ТоварДня,
	|	ЕСТЬNULL(Настройки.Хит, ЛОЖЬ) КАК Хит,
	|	ЕСТЬNULL(Настройки.Новинка, ЛОЖЬ) КАК Новинка,
	|	ЕСТЬNULL(Настройки.СтоимостьДоставки, 0) КАК СтоимостьДоставки
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				ТовО.Номенклатура КАК Номенклатура,
	|				СУММА(ТовО.ВНаличииОстаток) КАК ВНаличии
	|			ИЗ
	|				РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура = &Номенклатура) КАК ТовО
	|			СГРУППИРОВАТЬ ПО
	|				ТовО.Номенклатура) КАК Остатки
	|		ПО Остатки.Номенклатура = Н.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Себестоимость КАК Себест
	|		ПО Себест.Номенклатура = Н.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИМ_ТоварыСайта КАК Настройки
	|		ПО Настройки.Номенклатура = Н.Ссылка
	|ГДЕ
	|	Н.Ссылка = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Сведения = Новый Структура("Код,Артикул,ГруппаТовара,Остаток,Себестоимость,Скрыть,Наличие,ЦенаСайта,СтараяЦена,Распродажа,ТоварДня,Хит,Новинка,СтоимостьДоставки,ЕстьСебестоимость");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Сведения, Выборка);
	КонецЕсли;
	Если ПустаяСтрока(Сведения.Наличие) ИЛИ ВариантыНаличия().Найти(Сведения.Наличие) = Неопределено Тогда
		Сведения.Наличие = "По остатку";
	КонецЕсли;
	Сведения.ЕстьСебестоимость = ЕстьСебестоимость;
	Возврат Сведения;

КонецФункции

// Записывает настройки товара. Если все значения по умолчанию — запись удаляется.
// Настройки — структура или строка таблицы с полями Скрыть, Наличие, ЦенаСайта, СтараяЦена,
// Распродажа, ТоварДня, Хит, Новинка.
Процедура ЗаписатьНастройки(Номенклатура, Настройки) Экспорт

	Набор = РегистрыСведений.ИМ_ТоварыСайта.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Номенклатура);
	Если НЕ НастройкиПоУмолчанию(Настройки) Тогда
		Запись = Набор.Добавить();
		Запись.Номенклатура = Номенклатура;
		ЗаполнитьЗначенияСвойств(Запись, Настройки, "Скрыть,ЦенаСайта,СтараяЦена,Распродажа,ТоварДня,Хит,Новинка,СтоимостьДоставки");
		Запись.Наличие = ?(ВариантыНаличия().Найти(Настройки.Наличие) = Неопределено
			ИЛИ Настройки.Наличие = "По остатку", "", Настройки.Наличие);
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Пользователь = ИмяПользователя();
	КонецЕсли;
	Набор.Записать(Истина);

КонецПроцедуры

Функция НастройкиПоУмолчанию(Настройки) Экспорт

	Возврат НЕ Настройки.Скрыть
		И (Настройки.Наличие = "По остатку" ИЛИ ВариантыНаличия().Найти(Настройки.Наличие) = Неопределено)
		И Настройки.ЦенаСайта = 0
		И Настройки.СтараяЦена = 0
		И НЕ Настройки.Распродажа
		И НЕ Настройки.ТоварДня
		И НЕ Настройки.Хит
		И НЕ Настройки.Новинка
		И Настройки.СтоимостьДоставки = 0;

КонецФункции

// Фото товара по порядку: массив структур (Номер, Главное, ДвоичныеДанные, ДатаИзменения).
Функция ФотоТовара(Номенклатура) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ф.Номер КАК Номер,
	|	Ф.Главное КАК Главное,
	|	Ф.Картинка КАК Картинка,
	|	Ф.ДатаИзменения КАК ДатаИзменения
	|ИЗ
	|	РегистрСведений.ИМ_ФотоТоваров КАК Ф
	|ГДЕ
	|	Ф.Номенклатура = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Картинка.Получить();
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Номер,Главное,ДвоичныеДанные,ДатаИзменения",
			Выборка.Номер, Выборка.Главное, Данные, Выборка.ДатаИзменения));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Перезаписывает все фото товара. Фото — массив структур (Главное, ДвоичныеДанные) в нужном порядке.
Процедура ЗаписатьФото(Номенклатура, Фото) Экспорт

	ЕстьГлавное = Ложь;
	Для Каждого Элемент Из Фото Цикл
		ЕстьГлавное = ЕстьГлавное ИЛИ Элемент.Главное;
	КонецЦикла;

	Набор = РегистрыСведений.ИМ_ФотоТоваров.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Номенклатура);
	Номер = 0;
	Для Каждого Элемент Из Фото Цикл
		Номер = Номер + 1;
		Запись = Набор.Добавить();
		Запись.Номенклатура = Номенклатура;
		Запись.Номер = Номер;
		// Главным считается отмеченное, а если не отмечено ни одно — первое.
		Запись.Главное = ?(ЕстьГлавное, Элемент.Главное, Номер = 1);
		// JPEG уже сжат — дополнительное сжатие не нужно.
		Запись.Картинка = Новый ХранилищеЗначения(Элемент.ДвоичныеДанные);
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
	КонецЦикла;
	Набор.Записать(Истина);

КонецПроцедуры

// Количество фото по товарам: соответствие Номенклатура → число.
Функция КоличествоФото(СписокНоменклатуры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ф.Номенклатура КАК Номенклатура,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.ИМ_ФотоТоваров КАК Ф
	|ГДЕ
	|	Ф.Номенклатура В (&Список)
	|
	|СГРУППИРОВАТЬ ПО
	|	Ф.Номенклатура";
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// HTML редактора фото с картинкой внутри (data URL). Шаблон — макет обработки «РедакторФото».
Функция ТекстРедактораФото(ДвоичныеДанные) Экспорт

	Шаблон = Обработки.ИМ_ОнлайнМагазин.ПолучитьМакет("РедакторФото").ПолучитьТекст();
	Base64 = СтрЗаменить(СтрЗаменить(Base64Строка(ДвоичныеДанные), Символы.ВК, ""), Символы.ПС, "");
	Возврат СтрЗаменить(Шаблон, "%IMAGE_DATA_URL%", "data:" + ТипКартинки(ДвоичныеДанные) + ";base64," + Base64);

КонецФункции

// Результат редактора (data URL JPEG) → двоичные данные.
Функция ДвоичныеДанныеИзDataURL(Текст) Экспорт

	Позиция = СтрНайти(Текст, ",");
	Если СтрНачинаетсяС(Текст, "data:image/") И Позиция > 0 Тогда
		Возврат Base64Значение(Сред(Текст, Позиция + 1));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипКартинки(ДвоичныеДанные)

	Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	Буфер = Новый БуферДвоичныхДанных(12);
	Прочитано = Поток.Прочитать(Буфер, 0, 12);
	Поток.Закрыть();
	Если Прочитано < 4 Тогда
		Возврат "image/jpeg";
	КонецЕсли;
	Если Буфер[0] = 137 И Буфер[1] = 80 Тогда
		Возврат "image/png";
	ИначеЕсли Буфер[0] = 71 И Буфер[1] = 73 Тогда
		Возврат "image/gif";
	ИначеЕсли Буфер[0] = 66 И Буфер[1] = 77 Тогда
		Возврат "image/bmp";
	ИначеЕсли Прочитано >= 12 И Буфер[0] = 82 И Буфер[8] = 87 Тогда
		Возврат "image/webp";
	КонецЕсли;
	Возврат "image/jpeg";

КонецФункции

#КонецОбласти
