// Карточка товара для сайта (расширение ИМ_ОнлайнМагазин): настройки и фото.
// Параметр формы: Номенклатура. При закрытии после записи возвращает Истина.

&НаКлиенте
Перем ОчередьРедактора; // идентификаторы строк новых фото, ожидающих редактора

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Номенклатура = Параметры.Номенклатура;
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Заголовок = Строка(Номенклатура);

	Для Каждого Вариант Из ИМ_ОнлайнМагазинСервер.ВариантыНаличия() Цикл
		Элементы.Наличие.СписокВыбора.Добавить(Вариант);
	КонецЦикла;

	ПрочитатьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если НЕ Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = "Изменения товара для сайта не сохранены.";
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Изменения не сохранены. Сохранить?", РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаписатьНаСервере();
		Закрыть(Истина);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть(Записано);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЦенаПриИзменении(Элемент)

	ОбновитьСкидку();

КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)

	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФото

&НаКлиенте
Процедура ФотоПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Фото.ТекущиеДанные;
	АдресПросмотра = ?(ТекущиеДанные = Неопределено, "", ТекущиеДанные.Адрес);

КонецПроцедуры

&НаКлиенте
Процедура ФотоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьРедактор(ВыбраннаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьНаСервере();
	Закрыть(Истина);

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьНаСервере();
	ПоказатьОповещениеПользователя("Сохранено для сайта", , Заголовок);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФото(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите фото товара";
	Диалог.МножественныйВыбор = Истина;
	Диалог.Фильтр = "Фото (*.jpg;*.jpeg;*.png;*.webp;*.bmp;*.gif)|*.jpg;*.jpeg;*.png;*.webp;*.bmp;*.gif";
	Оповещение = Новый ОписаниеОповещения("ДобавитьФотоЗавершение", ЭтотОбъект);
	НачатьПомещениеФайлов(Оповещение, , Диалог, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФотоЗавершение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПомещенныеФайлы = Неопределено ИЛИ ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НовыеСтроки = Новый Массив;
	Для Каждого Файл Из ПомещенныеФайлы Цикл
		Строка = Фото.Добавить();
		Строка.Адрес = Файл.Хранение;
		НовыеСтроки.Добавить(Строка.ПолучитьИдентификатор());
	КонецЦикла;
	ОбновитьОписанияФото();
	Модифицированность = Истина;
	// Каждое новое фото сразу открываем в редакторе: обрезка и уменьшение до размера для сайта.
	ОчередьРедактора = НовыеСтроки;
	РедактироватьСледующееИзОчереди();

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьФото(Команда)

	Если Элементы.Фото.ТекущаяСтрока <> Неопределено Тогда
		ОткрытьРедактор(Элементы.Фото.ТекущаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СделатьГлавным(Команда)

	ТекущиеДанные = Элементы.Фото.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущийИдентификатор = Элементы.Фото.ТекущаяСтрока;
	Для Каждого Строка Из Фото Цикл
		Строка.Главное = (Строка.ПолучитьИдентификатор() = ТекущийИдентификатор);
	КонецЦикла;
	ОбновитьОписанияФото();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ФотоВыше(Команда)

	СдвинутьФото(-1);

КонецПроцедуры

&НаКлиенте
Процедура ФотоНиже(Команда)

	СдвинутьФото(1);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФото(Команда)

	ТекущиеДанные = Элементы.Фото.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("УдалитьФотоЗавершение", ЭтотОбъект, Элементы.Фото.ТекущаяСтрока);
	ПоказатьВопрос(Оповещение, "Удалить это фото?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФотоЗавершение(Ответ, ИдентификаторСтроки) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Строка = Фото.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка <> Неопределено Тогда
		Фото.Удалить(Строка);
	КонецЕсли;
	ОбновитьОписанияФото();
	ФотоПриАктивизацииСтроки(Неопределено);
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьРедактор(ИдентификаторСтроки)

	Строка = Фото.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыРедактора = Новый Структура("АдресКартинки, ИдентификаторВладельца", Строка.Адрес, УникальныйИдентификатор);
	Оповещение = Новый ОписаниеОповещения("РедакторЗавершение", ЭтотОбъект, ИдентификаторСтроки);
	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.РедакторФото", ПараметрыРедактора, ЭтотОбъект, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура РедакторЗавершение(НовыйАдрес, ИдентификаторСтроки) Экспорт

	Если ЗначениеЗаполнено(НовыйАдрес) Тогда
		Строка = Фото.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка <> Неопределено Тогда
			Строка.Адрес = НовыйАдрес;
			Элементы.Фото.ТекущаяСтрока = ИдентификаторСтроки;
			АдресПросмотра = НовыйАдрес;
			ОбновитьОписанияФото();
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	РедактироватьСледующееИзОчереди();

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьСледующееИзОчереди()

	Если ОчередьРедактора = Неопределено ИЛИ ОчередьРедактора.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Следующая = ОчередьРедактора[0];
	ОчередьРедактора.Удалить(0);
	ОткрытьРедактор(Следующая);

КонецПроцедуры

&НаКлиенте
Процедура СдвинутьФото(Направление)

	ТекущиеДанные = Элементы.Фото.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Индекс = Фото.Индекс(ТекущиеДанные);
	НовыйИндекс = Индекс + Направление;
	Если НовыйИндекс < 0 ИЛИ НовыйИндекс >= Фото.Количество() Тогда
		Возврат;
	КонецЕсли;
	Фото.Сдвинуть(Индекс, Направление);
	ОбновитьОписанияФото();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСкидку()

	РассчитатьПоказатели(ЭтотОбъект);
	Модифицированность = Истина;

КонецПроцедуры

// Скидка и маржа по цене на сайте. Маржа может быть отрицательной — продажа ниже себестоимости.
&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьПоказатели(Данные)

	Данные.Скидка = ?(Данные.СтараяЦена > 0 И Данные.ЦенаСайта > 0 И Данные.СтараяЦена > Данные.ЦенаСайта,
		Окр((1 - Данные.ЦенаСайта / Данные.СтараяЦена) * 100, 0), 0);
	Если Данные.ЦенаСайта > 0 И Данные.Себестоимость > 0 Тогда
		Данные.Маржа = Данные.ЦенаСайта - Данные.Себестоимость;
		Данные.МаржаПроцент = Окр(Данные.Маржа / Данные.ЦенаСайта * 100, 1);
	Иначе
		Данные.Маржа = 0;
		Данные.МаржаПроцент = 0;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьОписанияФото()

	ЕстьГлавное = Фото.НайтиСтроки(Новый Структура("Главное", Истина)).Количество() > 0;
	Номер = 0;
	Для Каждого Строка Из Фото Цикл
		Номер = Номер + 1;
		Если НЕ ЕстьГлавное И Номер = 1 Тогда
			Строка.Главное = Истина;
		КонецЕсли;
		Строка.Номер = Номер;
		Данные = ПолучитьИзВременногоХранилища(Строка.Адрес);
		Размер = ?(ТипЗнч(Данные) = Тип("ДвоичныеДанные"), Данные.Размер(), 0);
		Строка.Описание = ?(Строка.Главное, "Главное фото · ", "")
			+ Формат(Окр(Размер / 1024, 0), "ЧН=0; ЧГ=") + " КБ";
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьНаСервере()

	Сведения = ИМ_ОнлайнМагазинСервер.СведенияОТоваре(Номенклатура);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Сведения, "Скрыть,Наличие,ЦенаСайта,СтараяЦена,Распродажа,ТоварДня,Хит,Новинка,СтоимостьДоставки,Себестоимость,Остаток");
	РассчитатьПоказатели(ЭтотОбъект);

	Сводка = "Код: " + Сведения.Код
		+ ?(ПустаяСтрока(Сведения.Артикул), "", " · Артикул: " + Сведения.Артикул)
		+ ?(ПустаяСтрока(Сведения.ГруппаТовара), "", " · Группа: " + Сведения.ГруппаТовара)
		+ " · Остаток: " + Формат(Сведения.Остаток, "ЧН=0; ЧГ=")
		+ " · Себестоимость: " + ?(Сведения.Себестоимость > 0,
			Формат(Сведения.Себестоимость, "ЧДЦ=2; ЧГ=") + " сом", "нет данных (нет остатка)");

	Фото.Очистить();
	Для Каждого Элемент Из ИМ_ОнлайнМагазинСервер.ФотоТовара(Номенклатура) Цикл
		Строка = Фото.Добавить();
		Строка.Главное = Элемент.Главное;
		Строка.Адрес = ПоместитьВоВременноеХранилище(Элемент.ДвоичныеДанные, УникальныйИдентификатор);
	КонецЦикла;
	ОбновитьОписанияФото();
	АдресПросмотра = ?(Фото.Количество() > 0, Фото[0].Адрес, "");
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()

	Настройки = Новый Структура("Скрыть,Наличие,ЦенаСайта,СтараяЦена,Распродажа,ТоварДня,Хит,Новинка,СтоимостьДоставки");
	ЗаполнитьЗначенияСвойств(Настройки, ЭтотОбъект);

	СписокФото = Новый Массив;
	Для Каждого Строка Из Фото Цикл
		Данные = ПолучитьИзВременногоХранилища(Строка.Адрес);
		Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
			СписокФото.Добавить(Новый Структура("Главное, ДвоичныеДанные", Строка.Главное, Данные));
		КонецЕсли;
	КонецЦикла;

	НачатьТранзакцию();
	Попытка
		ИМ_ОнлайнМагазинСервер.ЗаписатьНастройки(Номенклатура, Настройки);
		ИМ_ОнлайнМагазинСервер.ЗаписатьФото(Номенклатура, СписокФото);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Не удалось сохранить товар для сайта: " + ОписаниеОшибки();
	КонецПопытки;

	Модифицированность = Ложь;
	Записано = Истина;

КонецПроцедуры

#КонецОбласти
