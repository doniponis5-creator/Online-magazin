// Общий модуль ИМ_ЗаказыСайтаСервер (расширение ИМ_ОнлайнМагазин).
// Заказы с сайта, оплаченные через O!Деньги → документы 1С:
//   Партнёр и контрагент (поиск по телефону, иначе создание) → Заказ клиента → ПКО в онлайн-кассу
//   → Реализация, если весь товар есть на складе. Если товара нет — остаётся заказ «К обеспечению».
// Основная конфигурация не изменяется: создаются обычные документы через типовые механизмы заполнения.
// Повторная обработка безопасна: заказ ищется по метке «САЙТ:<номер>» в комментарии.
// Бонусы SBonus: списанные на сайте бонусы — ручная скидка по строкам товаров (как кнопка «Списать бонус»
// на кассе, комментарий «SBonus+ скидка: N сом»); ПКО — только деньги O!Деньги. После проведённой
// реализации начисляется бонус за покупку (POST /1c/purchase, чек «РТУ-<номер>», «SBonus+ начислено»).

#Область ПрограммныйИнтерфейс

// Регламентное задание «Загрузка заказов с сайта» (каждые 5 минут).
Процедура ЗагрузитьЗаказыСайта() Экспорт

	Настройки = НастройкиМагазина();
	Если НЕ Настройки.Включено Тогда
		Возврат;
	КонецЕсли;
	Ошибка = ПроверитьНастройки(Настройки);
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ЗаписатьВЖурнал("Настройки", Ошибка, Истина);
		Возврат;
	КонецЕсли;

	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/pending?limit=20");
	Если НЕ Ответ.Успех Тогда
		ЗаписатьВЖурнал("Сервер", "Не удалось получить заказы: " + Ответ.Текст, Истина);
		Возврат;
	КонецЕсли;

	Данные = ПрочитатьJSONСтроку(Ответ.Текст);
	Заказы = Данные.Получить("orders");
	Если Заказы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ДанныеЗаказа Из Заказы Цикл
		НомерСайта = ДанныеЗаказа.Получить("order_id");
		Попытка
			Результат = ОбработатьЗаказ(ДанныеЗаказа, Настройки);
			Тело = Новый Структура("order_number_1c, pko_number_1c, rtu_number_1c, realized, bonus_earned, note",
				Результат.НомерЗаказа, Результат.НомерПКО, Результат.НомерРеализации, Результат.Реализовано,
				Результат.БонусНачислен, Результат.Примечание);
			ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/" + НомерСайта + "/mark-done", Тело);
			ЗаписатьВЖурнал("Заказ", НомерСайта + " → заказ " + Результат.НомерЗаказа
				+ ?(Результат.Реализовано, ", реализация " + Результат.НомерРеализации, ", товар к обеспечению"));
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписатьВЖурнал("Заказ", НомерСайта + ": " + ТекстОшибки, Истина);
			ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/" + НомерСайта + "/mark-failed",
				Новый Структура("note", Лев(ТекстОшибки, 900)));
		КонецПопытки;
	КонецЦикла;

	// Новые заказы разобрали — теперь старые, по которым наконец пришёл товар.
	Попытка
		ДооформитьОтгрузки(Настройки);
	Исключение
		ЗаписатьВЖурнал("Отгрузка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
	КонецПопытки;

КонецПроцедуры

// Дооформление отгрузок: заказы сайта, по которым товара не было, а теперь он есть.
//
// Владелец держит товар «В наличии» на сайте, даже когда склад пуст: покупатель
// платит, 1С делает Заказ клиента и ПКО, а Реализацию сделать не из чего. Раньше
// такой заказ отгружали руками, и это стоило дорого: бонусы за покупку не
// начислялись, а в «Панели сайта» он навсегда оставался в «Ждут отгрузки».
Процедура ДооформитьОтгрузки(Настройки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	З.Ссылка КАК Заказ,
	|	З.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ЗаказКлиента КАК З
	|ГДЕ
	|	НЕ З.ПометкаУдаления
	|	И З.Проведен
	|	И З.Дата >= &Начало
	|	И З.Комментарий ПОДОБНО ""САЙТ:%""
	|УПОРЯДОЧИТЬ ПО
	|	З.Дата";
	// Глубже трёх месяцев не смотрим: такое старьё уже разобрано руками.
	Запрос.УстановитьПараметр("Начало", НачалоДня(ТекущаяДатаСеанса()) - 90 * 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Метка = МеткаИзКомментария(Выборка.Комментарий);
		Если ПустаяСтрока(Метка) Тогда
			Продолжить;
		КонецЕсли;
		Если НайтиДокументПоМетке("РеализацияТоваровУслуг", Метка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТоварыЗаказаВНаличии(Выборка.Заказ, Настройки.Склад) Тогда
			Продолжить;
		КонецЕсли;

		НомерСайта = Сред(Метка, 6);
		Попытка
			Реализация = СоздатьРеализацию(Выборка.Заказ, Настройки, Метка);
			Бонус = Новый Структура("Начислено, Примечание", 0, "");
			Если Реализация.Проведен Тогда
				Бонус = НачислитьБонусЗаРеализацию(Реализация,
					ТелефонИзКомментария(Выборка.Комментарий), Настройки);
			КонецЕсли;
			ПКО = НайтиДокументПоМетке("ПриходныйКассовыйОрдер", Метка);
			Тело = Новый Структура("order_number_1c, pko_number_1c, rtu_number_1c, realized, bonus_earned, note",
				Строка(Выборка.Заказ.Номер), ?(ПКО = Неопределено, "", Строка(ПКО.Номер)),
				Строка(Реализация.Номер), Реализация.Проведен, Бонус.Начислено,
				СокрЛП("Отгружено после поступления товара. " + Бонус.Примечание));
			ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/" + НомерСайта + "/mark-done", Тело);
			ЗаписатьВЖурнал("Отгрузка", НомерСайта + " → реализация " + Реализация.Номер
				+ ?(Реализация.Проведен, " проведена", " записана, но НЕ проведена"));
		Исключение
			ЗаписатьВЖурнал("Отгрузка", НомерСайта + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// «САЙТ:SC-260919-8U8BE (интернет-магазин…» → «САЙТ:SC-260919-8U8BE»
Функция МеткаИзКомментария(Комментарий)

	Текст = СокрЛП(Строка(Комментарий));
	Если НЕ СтрНачинаетсяС(Текст, "САЙТ:") Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Текст, " ");
	Возврат ?(Позиция = 0, Текст, Лев(Текст, Позиция - 1));

КонецФункции

// В комментарии заказа телефон лежит куском «Тел. +996700123456».
Функция ТелефонИзКомментария(Комментарий)

	Для Каждого Часть Из СтрРазделить(Строка(Комментарий), "|", Ложь) Цикл
		Кусок = СокрЛП(Часть);
		Если СтрНачинаетсяС(Кусок, "Тел. ") Тогда
			Возврат СокрЛП(Сред(Кусок, 6));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Хватает ли на складе товаров самого документа «Заказ клиента».
Функция ТоварыЗаказаВНаличии(Заказ, Склад)

	Нужно = Новый Соответствие;
	Для Каждого Строка Из Заказ.Товары Цикл
		Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Услуга = (Строка.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга);
		Исключение
			// В другой конфигурации перечисления может не быть — считаем товаром.
			Услуга = Ложь;
		КонецПопытки;
		Если Услуга Тогда
			Продолжить;
		КонецЕсли;
		Было = ?(Нужно[Строка.Номенклатура] = Неопределено, 0, Нужно[Строка.Номенклатура]);
		Нужно.Вставить(Строка.Номенклатура, Было + Строка.Количество);
	КонецЦикла;
	Возврат ХватаетНаСкладе(Нужно, Склад);

КонецФункции

// Настройки магазина из регистра ИМ_НастройкиМагазина (одна запись «Основные»).
Функция НастройкиМагазина() Экспорт

	Настройки = Новый Структура("Включено, Организация, Склад, Касса, Соглашение, УслугаДоставки, АдресСервера, КлючAPI",
		Ложь, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, "", "");
	Запись = РегистрыСведений.ИМ_НастройкиМагазина.СоздатьМенеджерЗаписи();
	Запись.Ключ = "Основные";
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		ЗаполнитьЗначенияСвойств(Настройки, Запись);
	КонецЕсли;

	// Оплата O!Деньги по умолчанию приходит в кассу «О! Business» (О кириллицей или латиницей).
	Если НЕ ЗначениеЗаполнено(Настройки.Касса) Тогда
		Для Каждого Имя Из СтрРазделить("О! Business;O! Business;О!Business;O!Business", ";") Цикл
			Касса = Справочники.Кассы.НайтиПоНаименованию(Имя, Истина);
			Если ЗначениеЗаполнено(Касса) Тогда
				Настройки.Касса = Касса;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Адрес и ключ сервера по умолчанию берём у SBonus (константы расширения SBonusPlus), если они есть.
	Если ПустаяСтрока(Настройки.АдресСервера) Тогда
		Настройки.АдресСервера = ЗначениеКонстантыЕслиЕсть("SB_APIUrl", "https://api.smartcentr.store");
	КонецЕсли;
	Если ПустаяСтрока(Настройки.КлючAPI) Тогда
		Настройки.КлючAPI = ЗначениеКонстантыЕслиЕсть("SB_WebhookSecret", "");
	КонецЕсли;
	Возврат Настройки;

КонецФункции

Функция ПроверитьНастройки(Настройки) Экспорт

	Пропущено = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Настройки.Организация) Тогда Пропущено.Добавить("организация"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.Склад) Тогда Пропущено.Добавить("склад"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.Касса) Тогда Пропущено.Добавить("касса O!Деньги"); КонецЕсли;
	Если ПустаяСтрока(Настройки.КлючAPI) Тогда Пропущено.Добавить("ключ API"); КонецЕсли;
	Если Пропущено.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Не заполнено в настройках: " + СтрСоединить(Пропущено, ", ");

КонецФункции

// Проверка связи с сервером для кнопки в форме настроек.
Функция ПроверитьСвязь() Экспорт

	Настройки = НастройкиМагазина();
	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/pending?limit=1");
	Если Ответ.Успех Тогда
		Данные = ПрочитатьJSONСтроку(Ответ.Текст);
		Возврат "Связь есть. Оплаченных заказов в очереди: " + Формат(Данные.Получить("count"), "ЧН=0; ЧГ=");
	КонецЕсли;
	Возврат "Нет связи (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);

КонецФункции

#КонецОбласти

#Область ПанельСайта

// Панель сайта: сводка и настройки сайта прямо из 1С, чтобы владелец не лазил на сервер.
// Все три функции возвращают Неопределено при неудаче и кладут причину в Ошибка.

Функция АдресИКлюч(Ошибка)

	Настройки = НастройкиМагазина();
	Если ПустаяСтрока(Настройки.АдресСервера) ИЛИ ПустаяСтрока(Настройки.КлючAPI) Тогда
		Ошибка = "В настройках заказов не заполнен адрес сервера или ключ API.";
		Возврат Неопределено;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

// Сводка по сайту: заказы, каталог, покупатели, каналы кода входа.
Функция СводкаСайта(Ошибка = "") Экспорт

	Настройки = АдресИКлюч(Ошибка);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/dashboard");
	Если НЕ Ответ.Успех Тогда
		Ошибка = "Сервер не ответил (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		Возврат Неопределено;
	КонецЕсли;
	Ошибка = "";
	Возврат ПрочитатьJSONСтроку(Ответ.Текст);

КонецФункции

// Настройки сайта так, как их видит сервер: список ключей со значениями.
Функция НастройкиСайта(Ошибка = "") Экспорт

	Настройки = АдресИКлюч(Ошибка);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/settings");
	Если НЕ Ответ.Успех Тогда
		Ошибка = "Сервер не ответил (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		Возврат Неопределено;
	КонецЕсли;
	Ошибка = "";
	Возврат ПрочитатьJSONСтроку(Ответ.Текст);

КонецФункции

// Сохранить настройки сайта. Значения — Соответствие: ключ настройки → значение строкой.
// Сервер проверяет пределы сам и отвечает ошибкой, если значение не годится.
Функция СохранитьНастройкиСайта(Значения, Ошибка = "") Экспорт

	Настройки = АдресИКлюч(Ошибка);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тело = Новый Структура("values", Значения);
	Ответ = ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/settings", Тело);
	Если НЕ Ответ.Успех Тогда
		Ошибка = "Не сохранено (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		Возврат Неопределено;
	КонецЕсли;
	Ошибка = "";
	Возврат ПрочитатьJSONСтроку(Ответ.Текст);

КонецФункции

// «Знания для чата»: текст владельца — часы работы, гарантия, возврат, акции.
// Чат на сайте и в Telegram отвечает по нему. Неопределено — сервер не ответил.
Функция ЗнанияДляЧата(Ошибка = "") Экспорт

	Настройки = АдресИКлюч(Ошибка);
	Если Настройки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/notes");
	Если НЕ Ответ.Успех Тогда
		Ошибка = "Знания для чата не загружены (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		Возврат Неопределено;
	КонецЕсли;
	Ошибка = "";
	Текст = ПрочитатьJSONСтроку(Ответ.Текст).Получить("text");
	Возврат ?(Текст = Неопределено, "", Строка(Текст));

КонецФункции

Функция СохранитьЗнанияДляЧата(Текст, Ошибка = "") Экспорт

	Настройки = АдресИКлюч(Ошибка);
	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ответ = ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/notes", Новый Структура("text", Текст));
	Если НЕ Ответ.Успех Тогда
		Ошибка = "Знания для чата не сохранены (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		Возврат Ложь;
	КонецЕсли;
	Ошибка = "";
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область КаталогНаСайт

// Регламентное задание «Отправка каталога на сайт» (каждые 10 минут).
Процедура ОтправитьКаталогНаСайтПоРасписанию() Экспорт

	ОтправитьКаталогНаСайт();

	// Тем же заданием — остаток по рассрочке для чата на сайте. Отдельная попытка:
	// сбой одного не должен останавливать другое.
	Попытка
		ОтправитьРассрочкуНаСайт();
	Исключение
		ЗаписатьВЖурнал("Рассрочка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
	КонецПопытки;

КонецПроцедуры

// Отправка каталога (задание и кнопка в форме).
// Отправляет полный снимок каталога: товары в наличии и настроенные в расширении (кроме скрытых),
// цены и отметки сайта, фото. Себестоимость не отправляется.
// Возвращает текст результата для формы.
Функция ОтправитьКаталогНаСайт() Экспорт

	Настройки = НастройкиМагазина();
	Если НЕ Настройки.Включено ИЛИ ПустаяСтрока(Настройки.КлючAPI) Тогда
		Возврат "Обмен с сайтом выключен или не задан ключ API — каталог не отправлен.";
	КонецЕсли;

	Товары = ТоварыДляСайта();
	Фото = ФотоДляСайта(Товары);

	// Какие фото уже на сервере: загружаем только новые и изменённые.
	Ответ = ЗапросGET(Настройки, "/api/v1/webhook/1c/shop/photos-index");
	Если НЕ Ответ.Успех Тогда
		ТекстОшибки = "Каталог не отправлен: сервер недоступен (" + Ответ.Код + ") " + Лев(Ответ.Текст, 200);
		ЗаписатьВЖурнал("Каталог", ТекстОшибки, Истина);
		Возврат ТекстОшибки;
	КонецЕсли;
	НаСервере = ПрочитатьJSONСтроку(Ответ.Текст).Получить("photos");
	Если НаСервере = Неопределено Тогда
		НаСервере = Новый Соответствие;
	КонецЕсли;

	Загружено = 0;
	Ошибок = 0;
	БазаАдресаФото = Настройки.АдресСервера + "/api/v1/shop/photos/";
	Для Каждого Товар Из Товары Цикл
		Адреса = Новый Массив;
		Для Каждого ОписаниеФото Из Фото.Получить(Товар.Получить("id")) Цикл
			Если НаСервере.Получить(ОписаниеФото.Ключ) <> ОписаниеФото.MD5 Тогда
				Результат = ЗапросPOSTДвоичные(Настройки, "/api/v1/webhook/1c/shop/photos/" + ОписаниеФото.Ключ, ОписаниеФото.Данные);
				Если НЕ Результат.Успех Тогда
					Ошибок = Ошибок + 1;
					ЗаписатьВЖурнал("Каталог", "Фото " + ОписаниеФото.Ключ + " не загружено: " + Результат.Код + " " + Лев(Результат.Текст, 200), Истина);
					Продолжить;
				КонецЕсли;
				Загружено = Загружено + 1;
			КонецЕсли;
			Адреса.Добавить(БазаАдресаФото + ОписаниеФото.Ключ + ".jpg");
		КонецЦикла;
		Товар.Вставить("photos", Адреса);
	КонецЦикла;

	Ответ = ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/catalog", Новый Структура("items", Товары));
	Если НЕ Ответ.Успех Тогда
		ТекстОшибки = "Каталог не принят сервером (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300);
		ЗаписатьВЖурнал("Каталог", ТекстОшибки, Истина);
		Возврат ТекстОшибки;
	КонецЕсли;

	Итог = "Каталог отправлен на сайт: товаров " + Формат(Товары.Количество(), "ЧН=0; ЧГ=")
		+ ", новых фото " + Формат(Загружено, "ЧН=0; ЧГ=")
		+ ?(Ошибок > 0, ", фото с ошибкой " + Ошибок, "")
		+ ". Сайт обновится в течение 10 минут.";
	ЗаписатьВЖурнал("Каталог", Итог, Ошибок > 0);
	Возврат Итог;

КонецФункции

// Товары для сайта — массив соответствий в формате каталога сайта (как scripts/1c-export/export_catalog.py).
Функция ТоварыДляСайта()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Ссылка,
	|	Н.Код КАК Код,
	|	Н.Наименование КАК Наименование,
	|	Н.Артикул КАК Артикул,
	|	ЕСТЬNULL(Н.Родитель.Наименование, """") КАК ГруппаТовара,
	|	ЕСТЬNULL(Н.Родитель.Родитель.Наименование, """") КАК ГруппаВерхняя,
	|	ЕСТЬNULL(Н.Марка.Наименование, """") КАК Марка,
	|	ЕСТЬNULL(Н.Производитель.Наименование, """") КАК Производитель,
	|	ЕСТЬNULL(Остатки.ВНаличии, 0) КАК Остаток,
	|	ЕСТЬNULL(Настройки.Наличие, """") КАК Наличие,
	|	ЕСТЬNULL(Настройки.ЦенаСайта, 0) КАК ЦенаСайта,
	|	ЕСТЬNULL(Настройки.СтараяЦена, 0) КАК СтараяЦена,
	|	ЕСТЬNULL(Настройки.Распродажа, ЛОЖЬ) КАК Распродажа,
	|	ЕСТЬNULL(Настройки.ТоварДня, ЛОЖЬ) КАК ТоварДня,
	|	ЕСТЬNULL(Настройки.ДляВас, ЛОЖЬ) КАК ДляВас,
	|	ЕСТЬNULL(Настройки.Хит, ЛОЖЬ) КАК Хит,
	|	ЕСТЬNULL(Настройки.Новинка, ЛОЖЬ) КАК Новинка,
	|	ЕСТЬNULL(Настройки.СтоимостьДоставки, 0) КАК СтоимостьДоставки,
	|	ЕСТЬNULL(Настройки.АкцияДо, ДАТАВРЕМЯ(1, 1, 1)) КАК АкцияДо,
	|	ЕСТЬNULL(Настройки.ГарантияМесяцев, 0) КАК ГарантияМесяцев,
	|	Настройки.Описание КАК Описание,
	|	Настройки.Характеристики КАК Характеристики
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				ТовО.Номенклатура КАК Номенклатура,
	|				СУММА(ТовО.ВНаличииОстаток) КАК ВНаличии
	|			ИЗ
	|				РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТовО
	|			СГРУППИРОВАТЬ ПО
	|				ТовО.Номенклатура) КАК Остатки
	|		ПО Остатки.Номенклатура = Н.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИМ_ТоварыСайта КАК Настройки
	|		ПО Настройки.Номенклатура = Н.Ссылка
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И НЕ ЕСТЬNULL(Настройки.Скрыть, ЛОЖЬ)
	|	И (ЕСТЬNULL(Остатки.ВНаличии, 0) > 0
	|			ИЛИ НЕ Настройки.Номенклатура ЕСТЬ NULL)";

	Товары = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = Новый Соответствие;
		Товар.Вставить("id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Товар.Вставить("code", СокрЛП(Выборка.Код));
		Товар.Вставить("name", СокрЛП(Выборка.Наименование));
		Товар.Вставить("article", СокрЛП(Выборка.Артикул));
		Товар.Вставить("group", СокрЛП(Выборка.ГруппаТовара));
		Товар.Вставить("parentGroup", СокрЛП(Выборка.ГруппаВерхняя));
		Товар.Вставить("brand", СокрЛП(?(ЗначениеЗаполнено(Выборка.Марка), Выборка.Марка, Выборка.Производитель)));
		Товар.Вставить("stock", Макс(0, Выборка.Остаток));
		Товар.Вставить("availability", ?(ПустаяСтрока(Выборка.Наличие), "По остатку", Выборка.Наличие));
		Товар.Вставить("price", Выборка.ЦенаСайта);
		Товар.Вставить("oldPrice", Выборка.СтараяЦена);
		Товар.Вставить("sale", Выборка.Распродажа);
		Товар.Вставить("dealOfDay", Выборка.ТоварДня);
		Товар.Вставить("forYou", Выборка.ДляВас);
		Товар.Вставить("hit", Выборка.Хит);
		Товар.Вставить("isNew", Выборка.Новинка);
		Товар.Вставить("deliveryPrice", Выборка.СтоимостьДоставки);
		Товар.Вставить("warrantyMonths", Выборка.ГарантияМесяцев);
		// Срок акции: сайт покажет обратный отсчёт над картинкой товара.
		// Пустая дата — поля нет вовсе, отсчёта не будет.
		Если ЗначениеЗаполнено(Выборка.АкцияДо) Тогда
			Товар.Вставить("promoUntil", Формат(Выборка.АкцияДо, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		КонецЕсли;
		Товар.Вставить("description", ИМ_ОнлайнМагазинСервер.ТекстПоля(Выборка.Описание));
		Товар.Вставить("specs", ХарактеристикиДляСайта(ИМ_ОнлайнМагазинСервер.ТекстПоля(Выборка.Характеристики)));
		Товар.Вставить("photos", Новый Массив);
		Товары.Добавить(Товар);
	КонецЦикла;
	Возврат Товары;

КонецФункции

// «Название=Значение» построчно → массив соответствий {label, value} для сайта.
Функция ХарактеристикиДляСайта(Текст)

	Результат = Новый Массив;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Название = СокрЛП(Лев(Строка, Позиция - 1));
		Значение = СокрЛП(Сред(Строка, Позиция + 1));
		Если ПустаяСтрока(Название) ИЛИ ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Пара = Новый Соответствие;
		Пара.Вставить("label", Название);
		Пара.Вставить("value", Значение);
		Результат.Добавить(Пара);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Фото отправляемых товаров: GUID товара → массив структур (Ключ, MD5, Данные), главное фото первым.
Функция ФотоДляСайта(Товары)

	Ссылки = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Ссылки.Добавить(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Товар.Получить("id"))));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ф.Номенклатура КАК Номенклатура,
	|	Ф.Номер КАК Номер,
	|	Ф.Картинка КАК Картинка
	|ИЗ
	|	РегистрСведений.ИМ_ФотоТоваров КАК Ф
	|ГДЕ
	|	Ф.Номенклатура В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Ф.Номенклатура,
	|	Ф.Главное УБЫВ,
	|	Ф.Номер";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Результат = Новый Соответствие;
	Для Каждого Товар Из Товары Цикл
		Результат.Вставить(Товар.Получить("id"), Новый Массив);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Картинка.Получить();
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Продолжить;
		КонецЕсли;
		Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
		Хеш.Добавить(Данные);
		MD5 = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
		Идентификатор = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
		Список = Результат.Получить(Идентификатор);
		Ключ = Идентификатор + "-" + Формат(Список.Количество() + 1, "ЧГ=") + "-" + Лев(MD5, 10);
		Список.Добавить(Новый Структура("Ключ, MD5, Данные", Ключ, MD5, Данные));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СозданиеДокументов

Функция ОбработатьЗаказ(ДанныеЗаказа, Настройки)

	НомерСайта = ДанныеЗаказа.Получить("order_id");
	Метка = "САЙТ:" + НомерСайта;
	Результат = Новый Структура("НомерЗаказа, НомерПКО, НомерРеализации, Реализовано, БонусНачислен, Примечание",
		"", "", "", Ложь, 0, "");

	Строки = ПодготовитьСтроки(ДанныеЗаказа, Настройки);
	ВсеВНаличии = ВсеТоварыВНаличии(Строки, Настройки.Склад);

	Заказ = НайтиДокументПоМетке("ЗаказКлиента", Метка);
	Если Заказ = Неопределено Тогда
		НачатьТранзакцию();
		Попытка
			Партнер = НайтиИлиСоздатьПартнера(ДанныеЗаказа.Получить("customer_name"), ДанныеЗаказа.Получить("customer_phone"));
			Контрагент = НайтиИлиСоздатьКонтрагента(Партнер);
			Заказ = СоздатьЗаказКлиента(ДанныеЗаказа, Строки, Партнер, Контрагент, Настройки, Метка, ВсеВНаличии);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	Результат.НомерЗаказа = Заказ.Номер;

	ПКО = НайтиДокументПоМетке("ПриходныйКассовыйОрдер", Метка);
	Если ПКО = Неопределено Тогда
		ПКО = СоздатьПКО(ДанныеЗаказа, Заказ, Настройки, Метка);
	КонецЕсли;
	Результат.НомерПКО = ПКО.Номер;

	Если ВсеВНаличии Тогда
		Реализация = НайтиДокументПоМетке("РеализацияТоваровУслуг", Метка);
		Попытка
			Если Реализация = Неопределено Тогда
				Реализация = СоздатьРеализацию(Заказ, Настройки, Метка, СуммаБонусов(ДанныеЗаказа));
			КонецЕсли;
			Результат.НомерРеализации = Реализация.Номер;
			Результат.Реализовано = Реализация.Проведен;
			Если НЕ Реализация.Проведен Тогда
				Результат.Примечание = "Реализация записана, но не проведена — проверьте документ";
			Иначе
				Бонус = НачислитьБонусЗаРеализацию(Реализация, ДанныеЗаказа.Получить("customer_phone"), Настройки);
				Результат.БонусНачислен = Бонус.Начислено;
				Если ЗначениеЗаполнено(Бонус.Примечание) Тогда
					Результат.Примечание = Бонус.Примечание;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Деньги и заказ уже в 1С — реализацию сотрудник оформит вручную.
			Результат.Примечание = "Реализация не создана: " + Лев(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 500);
		КонецПопытки;
	Иначе
		Результат.Примечание = "Товара нет в наличии на складе — заказ ждёт поступления";
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПодготовитьСтроки(ДанныеЗаказа, Настройки)

	Строки = Новый Массив;
	Для Каждого Строка Из ДанныеЗаказа.Получить("lines") Цикл
		Номенклатура = НоменклатураПоДаннымСайта(Строка);
		Если Номенклатура = Неопределено Тогда
			ВызватьИсключение "Не найден товар в 1С: " + Строка.Получить("name") + " (код " + Строка.Получить("code") + ")";
		КонецЕсли;
		Строки.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма, Скидка, Услуга",
			Номенклатура, Число(Строка.Получить("qty")), Число(Строка.Получить("price")), Число(Строка.Получить("sum")), 0, Ложь));
	КонецЦикла;
	РаспределитьСкидкуБонусами(Строки, СуммаБонусов(ДанныеЗаказа));

	Доставка = ДанныеЗаказа.Получить("delivery");
	ЦенаДоставки = ?(Доставка = Неопределено, 0, Число(Доставка.Получить("price")));
	Если ЦенаДоставки > 0 Тогда
		Если НЕ ЗначениеЗаполнено(Настройки.УслугаДоставки) Тогда
			ВызватьИсключение "В заказе платная доставка, но в настройках не указана услуга «Доставка»";
		КонецЕсли;
		Строки.Добавить(Новый Структура("Номенклатура, Количество, Цена, Сумма, Скидка, Услуга",
			Настройки.УслугаДоставки, 1, ЦенаДоставки, ЦенаДоставки, 0, Истина));
	КонецЕсли;
	Возврат Строки;

КонецФункции

Функция СуммаБонусов(ДанныеЗаказа)

	Значение = ДанныеЗаказа.Получить("bonus_spent");
	Возврат ?(Значение = Неопределено, 0, Окр(Число(Значение), 2));

КонецФункции

// Бонусы — скидка пропорционально сумме строк товаров (доставка без скидки), остаток копеек — на последнюю строку.
Процедура РаспределитьСкидкуБонусами(Строки, Бонусы)

	Если Бонусы <= 0 Тогда
		Возврат;
	КонецЕсли;
	Всего = 0;
	Для Каждого Строка Из Строки Цикл
		Если НЕ Строка.Услуга Тогда
			Всего = Всего + Строка.Сумма;
		КонецЕсли;
	КонецЦикла;
	Если Всего <= 0 Тогда
		ВызватьИсключение "Бонусы списаны, но в заказе нет товаров для скидки";
	КонецЕсли;
	Бонусы = Мин(Бонусы, Всего);

	Осталось = Бонусы;
	Последняя = Неопределено;
	Для Каждого Строка Из Строки Цикл
		Если Строка.Услуга ИЛИ Строка.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Доля = Мин(Окр(Бонусы * Строка.Сумма / Всего, 2), Осталось);
		Строка.Скидка = Доля;
		Осталось = Осталось - Доля;
		Последняя = Строка;
	КонецЦикла;
	Если Осталось > 0 И Последняя <> Неопределено Тогда
		Последняя.Скидка = Последняя.Скидка + Осталось;
	КонецЕсли;
	Для Каждого Строка Из Строки Цикл
		Строка.Сумма = Строка.Сумма - Строка.Скидка;
	КонецЦикла;

КонецПроцедуры

Функция НоменклатураПоДаннымСайта(Строка)

	Идентификатор = Строка.Получить("oneCId");
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Попытка
			Ссылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
			Если ЗначениеЗаполнено(Ссылка) И НЕ ПустаяСтрока(Ссылка.Наименование) Тогда
				Возврат Ссылка;
			КонецЕсли;
		Исключение
			// битый идентификатор — ищем по коду
		КонецПопытки;
	КонецЕсли;
	Код = Строка.Получить("code");
	Если ЗначениеЗаполнено(Код) Тогда
		Ссылка = Справочники.Номенклатура.НайтиПоКоду(Код);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Свободный остаток = в наличии − уже к отгрузке. Услуги не проверяются.
Функция ВсеТоварыВНаличии(Строки, Склад)

	Нужно = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Если НЕ Строка.Услуга Тогда
			Нужно.Вставить(Строка.Номенклатура, ?(Нужно[Строка.Номенклатура] = Неопределено, 0, Нужно[Строка.Номенклатура]) + Строка.Количество);
		КонецЕсли;
	КонецЦикла;
	Если Нужно.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ХватаетНаСкладе(Нужно, Склад);

КонецФункции

// Нужно: соответствие «номенклатура → количество». Истина, когда хватает всего.
Функция ХватаетНаСкладе(Нужно, Склад)

	Если Нужно.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Список = Новый Массив;
	Для Каждого Элемент Из Нужно Цикл
		Список.Добавить(Элемент.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Номенклатура КАК Номенклатура,
	|	СУММА(Ост.ВНаличииОстаток - Ост.КОтгрузкеОстаток) КАК Свободно
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад И Номенклатура В (&Список)) КАК Ост
	|СГРУППИРОВАТЬ ПО
	|	Ост.Номенклатура";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Список", Список);

	Свободно = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Свободно.Вставить(Выборка.Номенклатура, Выборка.Свободно);
	КонецЦикла;

	Для Каждого Элемент Из Нужно Цикл
		Есть = Свободно[Элемент.Ключ];
		Если Есть = Неопределено ИЛИ Есть < Элемент.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СоздатьЗаказКлиента(ДанныеЗаказа, Строки, Партнер, Контрагент, Настройки, Метка, ВсеВНаличии)

	Док = Документы.ЗаказКлиента.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Попытка
		Док.Заполнить(Партнер);
	Исключение
		// типовое заполнение по партнёру необязательно — поля ниже заполняются явно
	КонецПопытки;

	Док.Партнер = Партнер;
	Док.Контрагент = Контрагент;
	Док.Организация = Настройки.Организация;
	Док.Склад = Настройки.Склад;
	Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Если ЗначениеЗаполнено(Настройки.Соглашение) Тогда
		Док.Соглашение = Настройки.Соглашение;
	КонецЕсли;
	ЗаполнитьШапкуПоПоследнейПродаже(Док, Настройки);
	Если НЕ ЗначениеЗаполнено(Док.Валюта) Тогда
		Док.Валюта = Настройки.Касса.ВалютаДенежныхСредств;
	КонецЕсли;
	Док.ДатаОтгрузки = НачалоДня(ТекущаяДатаСеанса());
	Док.Статус = ?(ВсеВНаличии, Перечисления.СтатусыЗаказовКлиентов.КОтгрузке, Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);
	Док.СкидкиРассчитаны = Истина;
	Док.Комментарий = КомментарийЗаказа(ДанныеЗаказа, Метка);

	Для Каждого Строка Из Строки Цикл
		СтрокаТоваров = Док.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Строка.Номенклатура;
		СтрокаТоваров.Количество = Строка.Количество;
		СтрокаТоваров.КоличествоУпаковок = Строка.Количество;
		СтрокаТоваров.Цена = Строка.Цена;
		Если Строка.Скидка > 0 Тогда
			// как кнопка «Списать бонус» SBonus: ручная скидка по строке
			Процент = Окр(Строка.Скидка / (Строка.Цена * Строка.Количество) * 100, 2);
			Попытка
				СтрокаТоваров.ПроцентРучнойСкидки = Процент;
			Исключение
				Попытка
					СтрокаТоваров.ПроцентРучнойСкидкиНаценки = Процент;
				Исключение
				КонецПопытки;
			КонецПопытки;
			Попытка
				СтрокаТоваров.СуммаРучнойСкидки = Строка.Скидка;
			Исключение
			КонецПопытки;
		КонецЕсли;
		СтрокаТоваров.Сумма = Строка.Сумма;
		СтрокаТоваров.СуммаСНДС = Строка.Сумма;
		СтрокаТоваров.Склад = Настройки.Склад;
		Попытка
			СтрокаТоваров.СтавкаНДС = Строка.Номенклатура.СтавкаНДС;
		Исключение
			// ставка НДС из карточки товара необязательна
		КонецПопытки;
		Если НЕ Строка.Услуга Тогда
			СтрокаТоваров.ВариантОбеспечения = ?(ВсеВНаличии,
				Перечисления.ВариантыОбеспечения.Отгрузить, Перечисления.ВариантыОбеспечения.КОбеспечению);
		КонецЕсли;
	КонецЦикла;

	СуммаЗаказа = 0;
	Для Каждого Строка Из Строки Цикл
		СуммаЗаказа = СуммаЗаказа + Строка.Сумма;
	КонецЦикла;
	Попытка
		Док.СуммаДокумента = СуммаЗаказа;
	Исключение
	КонецПопытки;
	// Один этап оплаты — его сумма должна совпасть с суммой после скидки бонусами (как в SBonusPlus).
	Попытка
		Если Док.ЭтапыГрафикаОплаты.Количество() = 1 Тогда
			Док.ЭтапыГрафикаОплаты[0].СуммаПлатежа = СуммаЗаказа;
			Попытка
				Док.ЭтапыГрафикаОплаты[0].ПроцентПлатежа = 100;
			Исключение
			КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		// Не провёлся (например, не хватает соглашения) — сохраняем черновик, чтобы оплата не потерялась.
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Док.Комментарий = Док.Комментарий + " | НЕ ПРОВЕДЁН: " + Лев(ТекстОшибки, 300);
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	Возврат Док.Ссылка;

КонецФункции

// НДС, соглашение, договор и т.п. берём из последней проведённой реализации организации —
// так новые документы оформляются так же, как обычные продажи магазина.
Процедура ЗаполнитьШапкуПоПоследнейПродаже(Док, Настройки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Р.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Р
	|ГДЕ
	|	Р.Проведен
	|	И Р.Организация = &Организация
	|УПОРЯДОЧИТЬ ПО
	|	Р.Дата УБЫВ";
	Запрос.УстановитьПараметр("Организация", Настройки.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Образец = Выборка.Ссылка;
	Для Каждого Имя Из СтрРазделить("НалогообложениеНДС,ЦенаВключаетНДС,Валюта,Подразделение,Менеджер", ",") Цикл
		Попытка
			Если НЕ ЗначениеЗаполнено(Док[Имя]) Тогда
				Док[Имя] = Образец[Имя];
			КонецЕсли;
		Исключение
			// реквизита нет в этой версии — пропускаем
		КонецПопытки;
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Док.Соглашение) И НЕ ЗначениеЗаполнено(Настройки.Соглашение) Тогда
		Попытка
			Док.Соглашение = Образец.Соглашение;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция СоздатьПКО(ДанныеЗаказа, Заказ, Настройки, Метка)

	// Деньги O!Деньги; бонусы в кассу не приходят — они уже скидка в заказе.
	Сумма = ДанныеЗаказа.Получить("pay_amount");
	Сумма = ?(Сумма = Неопределено, Число(ДанныеЗаказа.Получить("total")), Число(Сумма));
	Док = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Попытка
		Док.Заполнить(Заказ);
	Исключение
		Док.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
		Док.Организация = Настройки.Организация;
		Док.Партнер = Заказ.Партнер;
		Док.Контрагент = Заказ.Контрагент;
	КонецПопытки;

	Док.Касса = Настройки.Касса;
	Док.Валюта = Настройки.Касса.ВалютаДенежныхСредств;
	Док.СуммаДокумента = Сумма;
	Док.ПринятоОт = ДанныеЗаказа.Получить("customer_name");

	Если Док.РасшифровкаПлатежа.Количество() = 0 Тогда
		Строка = Док.РасшифровкаПлатежа.Добавить();
		Строка.Партнер = Заказ.Партнер;
		Попытка
			Строка.ОснованиеПлатежа = Заказ;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Пока Док.РасшифровкаПлатежа.Количество() > 1 Цикл
		Док.РасшифровкаПлатежа.Удалить(Док.РасшифровкаПлатежа.Количество() - 1);
	КонецЦикла;
	Строка = Док.РасшифровкаПлатежа[0];
	Строка.Сумма = Сумма;
	Строка.СуммаВзаиморасчетов = Сумма;

	Док.Комментарий = Метка + " | O!Деньги " + ДанныеЗаказа.Получить("obank_trans_id");
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Док.Комментарий = Док.Комментарий + " | НЕ ПРОВЕДЁН: " + Лев(ТекстОшибки, 300);
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	Возврат Док.Ссылка;

КонецФункции

Функция СоздатьРеализацию(Заказ, Настройки, Метка, Бонусы = 0)

	Если НЕ Заказ.Проведен Тогда
		ВызватьИсключение "Заказ клиента не проведён — реализацию оформите вручную";
	КонецЕсли;
	Док = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Док.Заполнить(Заказ);
	Если НЕ ЗначениеЗаполнено(Док.Склад) Тогда
		Док.Склад = Настройки.Склад;
	КонецЕсли;
	Попытка
		Док.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;
	Исключение
		// статусы реализаций могут быть отключены
	КонецПопытки;
	Док.Комментарий = Метка + " | оплачено онлайн (O!Деньги)"
		+ ?(Бонусы > 0, " | SBonus+ скидка: " + Формат(Бонусы, "ЧДЦ=0; ЧГ=") + " сом", "");
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Док.Комментарий = Док.Комментарий + " | НЕ ПРОВЕДЕНА: " + Лев(ТекстОшибки, 300);
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	Возврат Док.Ссылка;

КонецФункции

Функция КомментарийЗаказа(ДанныеЗаказа, Метка)

	Части = Новый Массив;
	Части.Добавить(Метка + " (интернет-магазин, оплачено O!Деньги)");
	Бонусы = СуммаБонусов(ДанныеЗаказа);
	Если Бонусы > 0 Тогда
		Части.Добавить("SBonus+ скидка: " + Формат(Бонусы, "ЧДЦ=0; ЧГ=") + " сом");
	КонецЕсли;
	Части.Добавить("Тел. " + ДанныеЗаказа.Получить("customer_phone"));
	Доставка = ДанныеЗаказа.Получить("delivery");
	Если Доставка <> Неопределено И Доставка.Получить("method") = "delivery" Тогда
		Части.Добавить("ДОСТАВКА: " + Доставка.Получить("city") + ", " + Доставка.Получить("address"));
	Иначе
		Части.Добавить("САМОВЫВОЗ");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеЗаказа.Получить("comment")) Тогда
		Части.Добавить("Комментарий: " + ДанныеЗаказа.Получить("comment"));
	КонецЕсли;
	Возврат Лев(СтрСоединить(Части, " | "), 1000);

КонецФункции

Функция НайтиДокументПоМетке(ИмяДокумента, Метка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Д
	|ГДЕ
	|	НЕ Д.ПометкаУдаления
	|	И Д.Комментарий ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", "%" + Метка + " %");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	// метка может стоять в конце комментария
	Запрос.УстановитьПараметр("Шаблон", "%" + Метка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Бонус за покупку после проведённой реализации — как кнопка «Начислить бонус» SBonusPlus.
// Повтор безопасен: чек «РТУ-<номер>» уже есть → SBonus отвечает 409, а комментарий «SBonus+ начислено» не дублируется.
Функция НачислитьБонусЗаРеализацию(Реализация, Телефон, Настройки)

	Результат = Новый Структура("Начислено, Примечание", 0, "");
	Если СтрНайти(НРег(Реализация.Комментарий), "sbonus+ начислено") > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Филиал = ЗначениеКонстантыЕслиЕсть("SB_BranchID", "");
	Если ПустаяСтрока(Филиал) ИЛИ ПустаяСтрока(Телефон) Тогда
		Результат.Примечание = "Бонус не начислен: нет филиала SBonus (константа SB_BranchID) или телефона";
		Возврат Результат;
	КонецЕсли;

	Сумма = 0;
	Позиции = Новый Массив;
	Для Каждого Строка Из Реализация.Товары Цикл
		Если СтрНайти(НРег(Строка.Номенклатура.Наименование), "наценка") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Сумма + Строка.Сумма;
		Позиции.Добавить(Новый Структура("sku, name, quantity, price, sum",
			СокрЛП(Строка.Номенклатура.Код), СокрЛП(Строка.Номенклатура.Наименование), Строка.Количество, Строка.Цена, Строка.Сумма));
	КонецЦикла;
	Если Сумма <= 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Тело = Новый Структура("customer_phone, purchase_amount, branch_id, receipt_number, items",
		Телефон, Сумма, Филиал, "РТУ-" + СокрЛП(Реализация.Номер), Позиции);
	Ответ = ЗапросPOST(Настройки, "/api/v1/webhook/1c/purchase", Тело);

	Отметить = Ложь;
	Если Ответ.Код = 200 ИЛИ Ответ.Код = 201 Тогда
		Попытка
			Результат.Начислено = Число(ПрочитатьJSONСтроку(Ответ.Текст).Получить("bonus_earned"));
		Исключение
		КонецПопытки;
		Отметить = Истина;
		ЗаписатьВЖурнал("Бонус", "РТУ-" + Реализация.Номер + " | " + Телефон + " | +" + Результат.Начислено);
	ИначеЕсли Ответ.Код = 409 Тогда
		Отметить = Истина; // уже начислено раньше
	ИначеЕсли СтрНайти(Ответ.Текст, "BONUS_BELOW_MIN_PURCHASE") > 0 Тогда
		Результат.Примечание = "Бонус не начислен: сумма покупки ниже минимума SBonus";
	Иначе
		Результат.Примечание = "Бонус не начислен (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300)
			+ ". Начислите кнопкой «Начислить бонус» в реализации.";
		ЗаписатьВЖурнал("Бонус", "РТУ-" + Реализация.Номер + ": " + Результат.Примечание, Истина);
	КонецЕсли;

	Если Отметить Тогда
		Попытка
			Объект = Реализация.ПолучитьОбъект();
			Объект.Комментарий = СокрЛП(Объект.Комментарий) + " | SBonus+ начислено";
			Объект.ОбменДанными.Загрузка = Истина; // только комментарий: без перепроведения и проверок
			Объект.Записать();
		Исключение
			ЗаписатьВЖурнал("Бонус", "Не удалось отметить «SBonus+ начислено» в РТУ-" + Реализация.Номер + ": "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Истина);
		КонецПопытки;
	КонецЕсли;
	Возврат Результат;

