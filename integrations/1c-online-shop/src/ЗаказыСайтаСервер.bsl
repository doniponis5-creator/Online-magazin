Функция РазобратьURL(URL)

	Результат = Новый Структура("Хост, Порт, Путь, Защищенное", "", 443, "", Истина);
	Рабочий = СокрЛП(URL);
	Если СтрНачинаетсяС(НРег(Рабочий), "https://") Тогда
		Рабочий = Сред(Рабочий, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Рабочий), "http://") Тогда
		Рабочий = Сред(Рабочий, 8);
		Результат.Порт = 80;
		Результат.Защищенное = Ложь;
	КонецЕсли;
	ПозицияСлеша = СтрНайти(Рабочий, "/");
	Если ПозицияСлеша > 0 Тогда
		Результат.Путь = Сред(Рабочий, ПозицияСлеша);
		Рабочий = Лев(Рабочий, ПозицияСлеша - 1);
	КонецЕсли;
	Если Прав(Результат.Путь, 1) = "/" Тогда
		Результат.Путь = Лев(Результат.Путь, СтрДлина(Результат.Путь) - 1);
	КонецЕсли;
	ПозицияДвоеточия = СтрНайти(Рабочий, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Порт = Число(Сред(Рабочий, ПозицияДвоеточия + 1));
		Рабочий = Лев(Рабочий, ПозицияДвоеточия - 1);
	КонецЕсли;
	Результат.Хост = Рабочий;
	Возврат Результат;

