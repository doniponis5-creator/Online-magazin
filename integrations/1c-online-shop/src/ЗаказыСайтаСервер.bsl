#КонецОбласти

#Область ПартнерыИКонтрагенты

Функция НайтиИлиСоздатьПартнера(ФИО, Телефон)

	Последние9 = Прав(СтрЗаменить(Телефон, "+", ""), 9);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КИ.Ссылка КАК Партнер
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	НЕ КИ.Ссылка.ПометкаУдаления
	|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И (КИ.НомерТелефона ПОДОБНО &Шаблон
	|			ИЛИ КИ.Представление ПОДОБНО &Шаблон)";
	Запрос.УстановитьПараметр("Шаблон", "%" + Последние9 + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Партнер;
	КонецЕсли;

	Объект = Справочники.Партнеры.СоздатьЭлемент();
	Объект.Наименование = СокрЛП(ФИО);
	Объект.НаименованиеПолное = СокрЛП(ФИО);
	Объект.Клиент = Истина;
	Объект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо;
	Объект.Комментарий = "Создан интернет-магазином (сайт), " + Формат(ТекущаяДатаСеанса(), "ДЛФ=D");

	// Реквизиты «Телефон» и «whatsapp» есть только в расширении МЛ — заполняем, если они есть.
	Для Каждого Имя Из СтрРазделить("Телефон,whatsapp", ",") Цикл
		Если Метаданные.Справочники.Партнеры.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Попытка
				Объект[Имя] = Телефон;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Попытка
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Объект, Телефон,
			Справочники.ВидыКонтактнойИнформации.ТелефонПартнера, , Истина);
	Исключение
		Строка = Объект.КонтактнаяИнформация.Добавить();
		Строка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		Строка.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		Строка.Представление = Телефон;
		Попытка
			Строка.НомерТелефона = Телефон;
		Исключение
		КонецПопытки;
	КонецПопытки;

	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция НайтиИлиСоздатьКонтрагента(Партнер)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК К
	|ГДЕ
	|	К.Партнер = &Партнер
	|	И НЕ К.ПометкаУдаления";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Партнер.Наименование;
	Объект.НаименованиеПолное = Партнер.НаименованиеПолное;
	Объект.Партнер = Партнер;
	Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	Попытка
		Страна = Справочники.СтраныМира.НайтиПоНаименованию("КЫРГЫЗСТАН");
		Если ЗначениеЗаполнено(Страна) Тогда
			Объект.СтранаРегистрации = Страна;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Объект.Комментарий = "Создан интернет-магазином (сайт)";
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти

#Область РассрочкаНаСайт

// Остаток по рассрочке для чата на сайте: «сколько я должен, сколько месяцев осталось».
//
// Источник — регистр ГрафикПлатежей, тот же, что у «Журнала платежей → К поступлению»
// и у кассы SBonus: в нём только неоплаченные части графика, Сумма — сколько ещё
// ждём на эту дату. Отправляется полный снимок; кто выплатил — пропадает на сайте.
//
// Здесь ничего не считаем, кроме выборки: остаток, просрочку и ближайший платёж
// считает сервер (app/shop/shop_installments.py). Телефоны отправляются как есть
// («0558311031/0558882507»), сервер разбирает их сам.
//
// Покупатель видит только свой долг: сайт спрашивает сервер по телефону, который
// человек подтвердил кодом при входе. Номер, написанный в чате, ничего не открывает.
Процедура ОтправитьРассрочкуНаСайт() Экспорт

	Настройки = НастройкиМагазина();
	Если НЕ Настройки.Включено ИЛИ ПустаяСтрока(Настройки.КлючAPI) Тогда
		Возврат;
	КонецЕсли;

	Клиенты = РассрочкаДляСайта();
	Ответ = ЗапросPOST(Настройки, "/api/v1/webhook/1c/shop/installments", Новый Структура("clients", Клиенты));
	Если НЕ Ответ.Успех Тогда
		ЗаписатьВЖурнал("Рассрочка", "Сервер не принял остатки (" + Ответ.Код + "): " + Лев(Ответ.Текст, 300), Истина);
	КонецЕсли;

КонецПроцедуры

// Тот же снимок строкой JSON — для проверки на копии базы без отправки на сервер
// (scripts/1c-export/check_installments.py).
Функция РассрочкаДляСайтаJSON() Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Новый Структура("clients", РассрочкаДляСайта()));
	Возврат Запись.Закрыть();

КонецФункции

// Массив клиентов: name, phones (строкой), items — покупки с графиком неоплаченных частей.
Функция РассрочкаДляСайта()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Г.ОбъектОплаты КАК Документ,
	|	Г.ДатаПлатежа КАК ДатаПлатежа,
	|	Г.Валюта КАК Валюта,
	|	Г.Сумма КАК Сумма,
	|	ВЫРАЗИТЬ(Г.ОбъектОплаты КАК Документ.РеализацияТоваровУслуг).Партнер КАК Партнер,
	|	ВЫРАЗИТЬ(Г.ОбъектОплаты КАК Документ.РеализацияТоваровУслуг).Контрагент КАК Контрагент,
	|	ВЫРАЗИТЬ(Г.ОбъектОплаты КАК Документ.РеализацияТоваровУслуг).Номер КАК Номер,
	|	ВЫРАЗИТЬ(Г.ОбъектОплаты КАК Документ.РеализацияТоваровУслуг).Дата КАК Дата,
	|	ВЫРАЗИТЬ(Г.ОбъектОплаты КАК Документ.РеализацияТоваровУслуг).СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	РегистрСведений.ГрафикПлатежей КАК Г
	|ГДЕ
	|	Г.ПоступлениеСписание = ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|	И Г.ОбластьПланирования = ЗНАЧЕНИЕ(Перечисление.ОбластиПланированияПлатежей.РасчетыСКлиентами)
	|	И Г.ОбъектОплаты ССЫЛКА Документ.РеализацияТоваровУслуг
	|	И Г.Сумма > 0
	|УПОРЯДОЧИТЬ ПО
	|	Партнер,
	|	Дата,
	|	Документ,
	|	ДатаПлатежа";

	// Долги в долларах с сомами не складываем: сайт говорит только о сомах.
	Сомы = Неопределено;
	Попытка
		Сомы = Константы["ВалютаРегламентированногоУчета"].Получить();
	Исключение
	КонецПопытки;

	Клиенты = Новый Массив;
	ПоПартнеру = Новый Соответствие;     // Партнер → соответствие клиента
	ПоДокументу = Новый Соответствие;    // Документ → соответствие покупки
	Контрагенты = Новый Соответствие;    // Партнер → массив контрагентов
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Сомы) И Выборка.Валюта <> Сомы Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Выборка.Партнер) Тогда
			Продолжить;
		КонецЕсли;
		ИмяКлиента = СокрЛП(Строка(Выборка.Партнер));
		// «Клиент розничная» — общий покупатель кассы, в нём долги разных людей.
		Если СтрНайти(НРег(ИмяКлиента), "розничн") > 0 Тогда
			Продолжить;
		КонецЕсли;

		Клиент = ПоПартнеру.Получить(Выборка.Партнер);
		Если Клиент = Неопределено Тогда
			Клиент = Новый Соответствие;
			Клиент.Вставить("name", ИмяКлиента);
			Клиент.Вставить("items", Новый Массив);
			ПоПартнеру.Вставить(Выборка.Партнер, Клиент);
			Контрагенты.Вставить(Выборка.Партнер, Новый Массив);
			Клиенты.Добавить(Клиент);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Контрагент)
			И Контрагенты.Получить(Выборка.Партнер).Найти(Выборка.Контрагент) = Неопределено Тогда
			Контрагенты.Получить(Выборка.Партнер).Добавить(Выборка.Контрагент);
		КонецЕсли;

		Покупка = ПоДокументу.Получить(Выборка.Документ);
		Если Покупка = Неопределено Тогда
			Покупка = Новый Соответствие;
			Покупка.Вставить("doc", СокрЛП(Выборка.Номер));
			Покупка.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-dd"));
			Покупка.Вставить("total", Выборка.СуммаДокумента);
			Покупка.Вставить("schedule", Новый Массив);
			ПоДокументу.Вставить(Выборка.Документ, Покупка);
			Клиент.Получить("items").Добавить(Покупка);
		КонецЕсли;
		Часть = Новый Соответствие;
		Часть.Вставить("date", Формат(Выборка.ДатаПлатежа, "ДФ=yyyy-MM-dd"));
		Часть.Вставить("sum", Выборка.Сумма);
		Покупка.Получить("schedule").Добавить(Часть);
	КонецЦикла;

	Для Каждого Пара Из ПоПартнеру Цикл
		Пара.Значение.Вставить("phones", ТелефоныКлиента(Пара.Ключ, Контрагенты.Получить(Пара.Ключ)));
	КонецЦикла;
	Возврат Клиенты;

КонецФункции

// Все телефоны клиента одной строкой через « / »: контактная информация партнёра
// и его контрагентов, плюс реквизиты «Телефон» и «whatsapp» расширения МЛ, если оно есть.
Функция ТелефоныКлиента(Партнер, СписокКонтрагентов)

	Телефоны = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КИ.Представление КАК Представление
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Ссылка = &Партнер
	|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КИ.Представление
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Ссылка В (&Контрагенты)
	|	И КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Контрагенты", СписокКонтрагентов);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Телефоны.Добавить(СокрЛП(Выборка.Представление));
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить("Телефон,whatsapp", ",") Цикл
		Если Метаданные.Справочники.Партнеры.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Попытка
				Телефоны.Добавить(СокрЛП(Строка(Партнер[Имя])));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Телефон Из Телефоны Цикл
		Если НЕ ПустаяСтрока(Телефон) И Результат.Найти(Телефон) = Неопределено Тогда
			Результат.Добавить(Телефон);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, " / ");

КонецФункции

#КонецОбласти

#Область HTTP

Функция ЗапросGET(Настройки, Путь)

	Попытка
		Адрес = РазобратьURL(Настройки.АдресСервера);
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 30,
			?(Адрес.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено));
		Запрос = Новый HTTPЗапрос(Адрес.Путь + Путь);
		Запрос.Заголовки.Вставить("X-Api-Key", Настройки.КлючAPI);
		Ответ = Соединение.Получить(Запрос);
		Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Возврат Новый Структура("Успех, Код, Текст", Ответ.КодСостояния = 200, Ответ.КодСостояния, Текст);
	Исключение
		Возврат Новый Структура("Успех, Код, Текст", Ложь, 0, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ЗапросPOST(Настройки, Путь, Данные)

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
		ЗаписатьJSON(Запись, Данные);
		Тело = Запись.Закрыть();

		Адрес = РазобратьURL(Настройки.АдресСервера);
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 30,
			?(Адрес.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено));
		Запрос = Новый HTTPЗапрос(Адрес.Путь + Путь);
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки.Вставить("X-Signature", HMACSHA256(Настройки.КлючAPI, Тело));
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Возврат Новый Структура("Успех, Код, Текст", Ответ.КодСостояния = 200, Ответ.КодСостояния, Текст);
	Исключение
		Возврат Новый Структура("Успех, Код, Текст", Ложь, 0, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ЗапросPOSTДвоичные(Настройки, Путь, ДвоичныеДанные)

	Попытка
		Адрес = РазобратьURL(Настройки.АдресСервера);
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 60,
			?(Адрес.Защищенное, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено));
		Запрос = Новый HTTPЗапрос(Адрес.Путь + Путь);
		Запрос.Заголовки.Вставить("Content-Type", "image/jpeg");
		Запрос.Заголовки.Вставить("X-Signature", HMACSHA256(Настройки.КлючAPI, ДвоичныеДанные));
		Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанные);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Возврат Новый Структура("Успех, Код, Текст", Ответ.КодСостояния = 200, Ответ.КодСостояния, Текст);
	Исключение
		Возврат Новый Структура("Успех, Код, Текст", Ложь, 0, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция РазобратьURL(URL)

	Результат = Новый Структура("Хост, Порт, Путь, Защищенное", "", 443, "", Истина);
	Рабочий = СокрЛП(URL);
	Если СтрНачинаетсяС(НРег(Рабочий), "https://") Тогда
		Рабочий = Сред(Рабочий, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Рабочий), "http://") Тогда
		Рабочий = Сред(Рабочий, 8);
		Результат.Порт = 80;
		Результат.Защищенное = Ложь;
	КонецЕсли;
	ПозицияСлеша = СтрНайти(Рабочий, "/");
	Если ПозицияСлеша > 0 Тогда
		Результат.Путь = Сред(Рабочий, ПозицияСлеша);
		Рабочий = Лев(Рабочий, ПозицияСлеша - 1);
	КонецЕсли;
	Если Прав(Результат.Путь, 1) = "/" Тогда
		Результат.Путь = Лев(Результат.Путь, СтрДлина(Результат.Путь) - 1);
	КонецЕсли;
	ПозицияДвоеточия = СтрНайти(Рабочий, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Порт = Число(Сред(Рабочий, ПозицияДвоеточия + 1));
		Рабочий = Лев(Рабочий, ПозицияДвоеточия - 1);
	КонецЕсли;
	Результат.Хост = Рабочий;
	Возврат Результат;

КонецФункции

Функция ПрочитатьJSONСтроку(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат ?(ТипЗнч(Результат) = Тип("Соответствие"), Результат, Новый Соответствие);

КонецФункции

// HMAC-SHA256 (hex) — как в SBonusPlus: ключ и сообщение в UTF-8.
Функция HMACSHA256(Ключ, Сообщение)

	РазмерБлока = 64;
	БуферКлюча = ПолучитьБуферДвоичныхДанныхИзСтроки(Ключ, КодировкаТекста.UTF8, Ложь);
	Если БуферКлюча.Размер > РазмерБлока Тогда
		Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(БуферКлюча));
		БуферКлюча = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Хеш.ХешСумма);
	КонецЕсли;

	Внутренний = Новый БуферДвоичныхДанных(РазмерБлока);
	Внешний = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		Байт = ?(Индекс < БуферКлюча.Размер, БуферКлюча[Индекс], 0);
		Внутренний[Индекс] = ПобитовоеИсключительноеИли(Байт, 54);
		Внешний[Индекс] = ПобитовоеИсключительноеИли(Байт, 92);
	КонецЦикла;

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Внутренний));
	Хеш.Добавить(?(ТипЗнч(Сообщение) = Тип("ДвоичныеДанные"), Сообщение,
		ПолучитьДвоичныеДанныеИзСтроки(Сообщение, КодировкаТекста.UTF8, Ложь)));
	ВнутреннийХеш = Хеш.ХешСумма;

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Внешний));
	Хеш.Добавить(ВнутреннийХеш);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));

КонецФункции

#КонецОбласти

#Область Служебные

Функция ЗначениеКонстантыЕслиЕсть(Имя, ПоУмолчанию)

	Если Метаданные.Константы.Найти(Имя) = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Значение = Константы[Имя].Получить();
		Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), ПоУмолчанию);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

