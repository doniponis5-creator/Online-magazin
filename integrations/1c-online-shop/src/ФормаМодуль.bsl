// Обработка «Онлайн магазин» (расширение ИМ_ОнлайнМагазин).
// Управление витриной сайта: скрыть товар, наличие, цена, скидка, распродажа, товар дня.
// Основная конфигурация НЕ изменяется: настройки хранятся в регистре расширения ИМ_ТоварыСайта.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТолькоВНаличии = Истина;
	Показывать = "Все";
	ЗаполнитьСписокГрупп();
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

// Сохранённые настройки формы (флажок «Только в наличии») загружаются после создания формы.
&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	Если ПустаяСтрока(Показывать) Тогда
		Показывать = "Все";
	КонецЕсли;
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЕстьИзменения() Тогда
		Отказ = Истина;
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = "Изменения для сайта не сохранены.";
			Возврат;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Изменения для сайта не сохранены. Сохранить?", РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		СброситьПризнакИзменения();
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Изменено = Истина;
		РассчитатьПоказатели(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьКарточку(ВыбраннаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьКарточкуТовара(Команда)
	
	Если Элементы.Товары.ТекущаяСтрока <> Неопределено Тогда
		ОткрытьКарточку(Элементы.Товары.ТекущаяСтрока);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКаталогНаСайт(Команда)

	Если ЕстьИзменения() Тогда
		СохранитьНаСервере();
	КонецЕсли;
	ПоказатьПредупреждение(, ОтправитьКаталогНаСервере());

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьКаталогНаСервере()

	Возврат ИМ_ЗаказыСайтаСервер.ОтправитьКаталогНаСайт();

КонецФункции

&НаКлиенте
Процедура ОткрытьНастройкиЗаказов(Команда)

	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.НастройкиМагазина", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПанельСайта(Команда)

	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.ПанельСайта", , ЭтотОбъект);

КонецПроцедуры

// Любое поле отбора меняет список сразу: нажимать «Обновить» после каждого
// слова владелец не будет, а несохранённые правки терять нельзя.
&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	Если ЕстьИзменения() Тогда
		Оповещение = Новый ОписаниеОповещения("ОтборЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Есть несохранённые изменения. Сохранить перед сменой отбора?",
			РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
	КонецЕсли;
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СброситьОтбор(Команда)

	Поиск = "";
	ГруппаОтбора = "";
	Показывать = "Все";
	ТолькоВНаличии = Истина;
	ОтборПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	Если ЕстьИзменения() Тогда
		Оповещение = Новый ОписаниеОповещения("ОбновитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Есть несохранённые изменения. Сохранить перед обновлением?", РежимДиалогаВопрос.ДаНетОтмена);
		Возврат;
	КонецЕсли;
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьНаСервере();
	КонецЕсли;
	ЗаполнитьТоварыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	Количество = СохранитьНаСервере();
	ПоказатьОповещениеПользователя("Онлайн магазин", , "Сохранено товаров: " + Формат(Количество, "ЧН=0; ЧГ="));

КонецПроцедуры

&НаКлиенте
Процедура СкрытьВыделенные(Команда)

	УстановитьДляВыделенных("Скрыть", Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыделенные(Команда)

	УстановитьДляВыделенных("Скрыть", Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьКарточку(ИдентификаторСтроки)
	
	Строка = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Несохранённые правки строки записываем, чтобы карточка показала актуальные значения.
	Если Строка.Изменено Тогда
		СохранитьНаСервере();
	КонецЕсли;
	ПараметрыКарточки = Новый Структура("Номенклатура", Строка.Номенклатура);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияКарточки", ЭтотОбъект, ИдентификаторСтроки);
	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.КарточкаТовара", ПараметрыКарточки, ЭтотОбъект, Строка.Номенклатура, , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияКарточки(Результат, ИдентификаторСтроки) Экспорт
	
	ОбновитьСтрокуНаСервере(ИдентификаторСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокуНаСервере(ИдентификаторСтроки)
	
	Строка = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сведения = ИМ_ОнлайнМагазинСервер.СведенияОТоваре(Строка.Номенклатура);
	ЗаполнитьЗначенияСвойств(Строка, Сведения, "Остаток,Себестоимость,Скрыть,Наличие,ЦенаСайта,СтараяЦена,Распродажа,ТоварДня,ДляВас,Хит,Новинка,СтоимостьДоставки");
	РассчитатьПоказатели(Строка);
	Строка.Фото = КоличествоФотоТовара(Строка.Номенклатура);
	Строка.Изменено = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоФотоТовара(Номенклатура)
	
	Список = Новый Массив;
	Список.Добавить(Номенклатура);
	Количество = ИМ_ОнлайнМагазинСервер.КоличествоФото(Список)[Номенклатура];
	Возврат ?(Количество = Неопределено, 0, Количество);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДляВыделенных(ИмяКолонки, Значение)

	Для Каждого ИдентификаторСтроки Из Элементы.Товары.ВыделенныеСтроки Цикл
		Строка = Товары.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка <> Неопределено И Строка[ИмяКолонки] <> Значение Тогда
			Строка[ИмяКолонки] = Значение;
			Строка.Изменено = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Скидка и маржа по цене на сайте. Маржа может быть отрицательной — продажа ниже себестоимости.
&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьПоказатели(Данные)

	Данные.Скидка = ?(Данные.СтараяЦена > 0 И Данные.ЦенаСайта > 0 И Данные.СтараяЦена > Данные.ЦенаСайта,
		Окр((1 - Данные.ЦенаСайта / Данные.СтараяЦена) * 100, 0), 0);
	Если Данные.ЦенаСайта > 0 И Данные.Себестоимость > 0 Тогда
		Данные.Маржа = Данные.ЦенаСайта - Данные.Себестоимость;
		Данные.МаржаПроцент = Окр(Данные.Маржа / Данные.ЦенаСайта * 100, 1);
	Иначе
		Данные.Маржа = 0;
		Данные.МаржаПроцент = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЕстьИзменения()

	Возврат Товары.НайтиСтроки(Новый Структура("Изменено", Истина)).Количество() > 0;

КонецФункции

&НаКлиенте
Процедура СброситьПризнакИзменения()

	Для Каждого Строка Из Товары.НайтиСтроки(Новый Структура("Изменено", Истина)) Цикл
		Строка.Изменено = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТоварыНаСервере()

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЕстьСебестоимость = ИМ_ОнлайнМагазинСервер.ПодготовитьСебестоимость(МенеджерВТ);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Код КАК Код,
	|	Н.Артикул КАК Артикул,
	|	ЕСТЬNULL(Н.Родитель.Наименование, """") КАК ГруппаТовара,
	|	ЕСТЬNULL(Остатки.ВНаличии, 0) КАК Остаток,
	|	ЕСТЬNULL(Себест.Себестоимость, 0) КАК Себестоимость,
	|	ЕСТЬNULL(Настройки.Скрыть, ЛОЖЬ) КАК Скрыть,
	|	ЕСТЬNULL(Настройки.Наличие, """") КАК Наличие,
	|	ЕСТЬNULL(Настройки.ЦенаСайта, 0) КАК ЦенаСайта,
	|	ЕСТЬNULL(Настройки.СтараяЦена, 0) КАК СтараяЦена,
	|	ЕСТЬNULL(Настройки.Распродажа, ЛОЖЬ) КАК Распродажа,
	|	ЕСТЬNULL(Настройки.ТоварДня, ЛОЖЬ) КАК ТоварДня,
	|	ЕСТЬNULL(Настройки.ДляВас, ЛОЖЬ) КАК ДляВас,
	|	ЕСТЬNULL(Настройки.Хит, ЛОЖЬ) КАК Хит,
	|	ЕСТЬNULL(Настройки.Новинка, ЛОЖЬ) КАК Новинка,
	|	ЕСТЬNULL(Настройки.СтоимостьДоставки, 0) КАК СтоимостьДоставки,
	|	ЕСТЬNULL(Настройки.АкцияДо, ДАТАВРЕМЯ(1, 1, 1)) КАК АкцияДо,
	|	Настройки.Описание КАК ОписаниеТовара
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|		ЛЕВОЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				ТовО.Номенклатура КАК Номенклатура,
	|				СУММА(ТовО.ВНаличииОстаток) КАК ВНаличии
	|			ИЗ
	|				РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТовО
	|			СГРУППИРОВАТЬ ПО
	|				ТовО.Номенклатура) КАК Остатки
	|		ПО Остатки.Номенклатура = Н.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Себестоимость КАК Себест
	|		ПО Себест.Номенклатура = Н.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИМ_ТоварыСайта КАК Настройки
	|		ПО Настройки.Номенклатура = Н.Ссылка
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И (НЕ &ТолькоВНаличии
	|			ИЛИ ЕСТЬNULL(Остатки.ВНаличии, 0) > 0
	|			ИЛИ НЕ Настройки.Номенклатура ЕСТЬ NULL)
	|	И (&БезГруппы ИЛИ ЕСТЬNULL(Н.Родитель.Наименование, """") = &Группа)
	|	/*УСЛОВИЯПОИСКА*/
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаТовара,
	|	Н.Наименование";

	// Поиск по словам: «пылесос arnica» находит товар, даже если в названии
	// между словами что-то ещё. Одно поле ПОДОБНО так не умеет.
	Слова = СловаПоиска(Поиск);
	Условия = "";
	Для Индекс = 0 По Слова.Количество() - 1 Цикл
		Имя = "Слово" + Формат(Индекс, "ЧН=0; ЧГ=");
		Условия = Условия + "
		|	И (Н.Наименование ПОДОБНО &" + Имя + " СПЕЦСИМВОЛ ""~""
		|			ИЛИ Н.Артикул ПОДОБНО &" + Имя + " СПЕЦСИМВОЛ ""~""
		|			ИЛИ Н.Код ПОДОБНО &" + Имя + " СПЕЦСИМВОЛ ""~"")";
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "/*УСЛОВИЯПОИСКА*/", Условия);

	Запрос.УстановитьПараметр("ТолькоВНаличии", ТолькоВНаличии);
	Для Индекс = 0 По Слова.Количество() - 1 Цикл
		Запрос.УстановитьПараметр("Слово" + Формат(Индекс, "ЧН=0; ЧГ="),
			"%" + ЭкранироватьДляПодобно(Слова[Индекс]) + "%");
	КонецЦикла;
	Группа = СокрЛП(ГруппаОтбора);
	Запрос.УстановитьПараметр("БезГруппы", ПустаяСтрока(Группа));
	Запрос.УстановитьПараметр("Группа", Группа);

	Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.ЕстьОписание = НЕ ПустаяСтрока(ИМ_ОнлайнМагазинСервер.ТекстПоля(Выборка.ОписаниеТовара));
		Если ИМ_ОнлайнМагазинСервер.ВариантыНаличия().Найти(Строка.Наличие) = Неопределено Тогда
			Строка.Наличие = "По остатку";
		КонецЕсли;
		РассчитатьПоказатели(Строка);
		Строка.Изменено = Ложь;
	КонецЦикла;

	КоличествоФото = ИМ_ОнлайнМагазинСервер.КоличествоФото(Товары.Выгрузить(, "Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	Для Каждого Строка Из Товары Цикл
		Количество = КоличествоФото[Строка.Номенклатура];
		Строка.Фото = ?(Количество = Неопределено, 0, Количество);
	КонецЦикла;
	
	ПрименитьРежимПоказа();

	Итог = "Товаров: " + Формат(Товары.Количество(), "ЧН=0; ЧГ=")
		+ ?(ОписаниеОтбора() = "", "", " · отбор: " + ОписаниеОтбора())
		+ ?(ЕстьСебестоимость, "", ". Себестоимость не прочитана");
	Убыточных = 0;
	Для Каждого Строка Из Товары Цикл
		Если Строка.Маржа < 0 Тогда
			Убыточных = Убыточных + 1;
		КонецЕсли;
	КонецЦикла;
	Если Убыточных > 0 Тогда
		Итог = Итог + ". Цена ниже себестоимости: " + Формат(Убыточных, "ЧН=0; ЧГ=");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	
	Сохранено = 0;
	НачатьТранзакцию();
	Попытка
		Для Каждого Строка Из Товары.НайтиСтроки(Новый Структура("Изменено", Истина)) Цикл
			ИМ_ОнлайнМагазинСервер.ЗаписатьНастройки(Строка.Номенклатура, Строка);
			Строка.Изменено = Ложь;
			Сохранено = Сохранено + 1;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение "Не удалось сохранить настройки сайта: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Сохранено;
	
КонецФункции

// Строка поиска → слова без пустых. Больше четырёх не берём: это уже не поиск.
&НаСервереБезКонтекста
Функция СловаПоиска(Текст)

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(СокрЛП(Текст), " ", Ложь) Цикл
		Если НЕ ПустаяСтрока(Слово) Тогда
			Слова.Добавить(СокрЛП(Слово));
		КонецЕсли;
		Если Слова.Количество() >= 4 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Режим показа применяется после запроса: фото и описание считаются отдельно,
// тащить их в условия запроса дороже, чем отсеять готовые строки.
&НаСервере
Процедура ПрименитьРежимПоказа()

	Если ПустаяСтрока(Показывать) ИЛИ Показывать = "Все" Тогда
		Возврат;
	КонецЕсли;

	Лишние = Новый Массив;
	Для Каждого Строка Из Товары Цикл
		Если Показывать = "На сайте" Тогда
			Оставить = НЕ Строка.Скрыть;
		ИначеЕсли Показывать = "Скрытые" Тогда
			Оставить = Строка.Скрыть;
		ИначеЕсли Показывать = "Без цены" Тогда
			Оставить = (Строка.ЦенаСайта = 0);
		ИначеЕсли Показывать = "С ценой" Тогда
			Оставить = (Строка.ЦенаСайта > 0);
		ИначеЕсли Показывать = "Без фото" Тогда
			Оставить = (Строка.Фото = 0);
		ИначеЕсли Показывать = "Без описания" Тогда
			Оставить = НЕ Строка.ЕстьОписание;
		ИначеЕсли Показывать = "Распродажа" Тогда
			Оставить = Строка.Распродажа;
		ИначеЕсли Показывать = "Товар дня" Тогда
			Оставить = Строка.ТоварДня;
		ИначеЕсли Показывать = "Специально для вас" Тогда
			Оставить = Строка.ДляВас;
		ИначеЕсли Показывать = "Хит" Тогда
			Оставить = Строка.Хит;
		ИначеЕсли Показывать = "Новинка" Тогда
			Оставить = Строка.Новинка;
		Иначе
			Оставить = Истина;
		КонецЕсли;
		Если НЕ Оставить Тогда
			Лишние.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Лишние Цикл
		Товары.Удалить(Строка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОписаниеОтбора()

	Части = Новый Массив;
	Если НЕ ПустаяСтрока(СокрЛП(Поиск)) Тогда
		Части.Добавить("«" + СокрЛП(Поиск) + "»");
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(ГруппаОтбора)) Тогда
		Части.Добавить(СокрЛП(ГруппаОтбора));
	КонецЕсли;
	Если НЕ ПустаяСтрока(Показывать) И Показывать <> "Все" Тогда
		Части.Добавить(НРег(Показывать));
	КонецЕсли;
	Если ТолькоВНаличии Тогда
		Части.Добавить("только в наличии");
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");

КонецФункции

// Список групп для отбора: только те, где есть товары.
&НаСервере
Процедура ЗаполнитьСписокГрупп()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(Н.Родитель.Наименование, """") КАК Группа
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|УПОРЯДОЧИТЬ ПО
	|	Группа";

	Элементы.ГруппаОтбора.СписокВыбора.Очистить();
	Элементы.ГруппаОтбора.СписокВыбора.Добавить("", "Все группы");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ПустаяСтрока(Выборка.Группа) Тогда
			Элементы.ГруппаОтбора.СписокВыбора.Добавить(Выборка.Группа);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭкранироватьДляПодобно(Текст)

	Результат = Текст;
	Для Каждого Символ Из СтрРазделить("~,%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
