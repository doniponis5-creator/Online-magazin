// Настройки заказов с сайта (расширение ИМ_ОнлайнМагазин): куда 1С оформляет оплаченные заказы.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Настройки = ИМ_ЗаказыСайтаСервер.НастройкиМагазина();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки, "Включено,Организация,Склад,Касса,Соглашение,УслугаДоставки,АдресСервера,КлючAPI");
	Состояние = ИМ_ЗаказыСайтаСервер.ПроверитьНастройки(Настройки);
	Если ПустаяСтрока(Состояние) Тогда
		Состояние = "Настройки заполнены. Заказы загружаются каждые 5 минут, каталог отправляется на сайт каждые 10 минут, пока включён флажок.";
	КонецЕсли;
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьНаСервере();
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьНаСервере();
	ПоказатьОповещениеПользователя("Настройки сохранены");

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)

	ЗаписатьНаСервере();
	Состояние = ПроверитьСвязьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКаталог(Команда)

	ЗаписатьНаСервере();
	Состояние = ОтправитьКаталогНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСейчас(Команда)

	ЗаписатьНаСервере();
	Состояние = ЗагрузитьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаписатьНаСервере()

	Запись = РегистрыСведений.ИМ_НастройкиМагазина.СоздатьМенеджерЗаписи();
	Запись.Ключ = "Основные";
	ЗаполнитьЗначенияСвойств(Запись, ЭтотОбъект, "Включено,Организация,Склад,Касса,Соглашение,УслугаДоставки,АдресСервера,КлючAPI");
	Запись.Записать(Истина);
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтправитьКаталогНаСервере()

	Возврат ИМ_ЗаказыСайтаСервер.ОтправитьКаталогНаСайт();

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьСвязьНаСервере()

	Возврат ИМ_ЗаказыСайтаСервер.ПроверитьСвязь();

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере()

	Настройки = ИМ_ЗаказыСайтаСервер.НастройкиМагазина();
	Ошибка = ИМ_ЗаказыСайтаСервер.ПроверитьНастройки(Настройки);
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	Если НЕ Настройки.Включено Тогда
		Возврат "Включите флажок «Загружать заказы с сайта» и повторите.";
	КонецЕсли;
	ИМ_ЗаказыСайтаСервер.ЗагрузитьЗаказыСайта();
	Возврат "Загрузка выполнена " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T")
		+ ". Результат — в журнале регистрации (события «ОнлайнМагазин»).";

КонецФункции

#КонецОбласти
