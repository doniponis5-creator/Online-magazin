&НаСервереБезКонтекста
Функция Плитка(Подпись, Значение, Единица, Пояснение, Сравнение = "", Тревога = Ложь)

	Класс = ?(Тревога, "card kpi warn", "card kpi");
	Хвост = ?(ПустаяСтрока(Единица), "", " <span class='cur'>" + Э(Единица) + "</span>");
	Возврат "<div class='" + Класс + "'><div class='lab'>" + Э(Подпись) + "</div>"
		+ "<div class='val'>" + Э(Значение) + Хвост + "</div>"
		+ "<div class='sub'>" + Э(Пояснение) + "</div>"
		+ ?(ПустаяСтрока(Сравнение), "", "<div class='cmp'>" + Сравнение + "</div>")
		+ "</div>";

