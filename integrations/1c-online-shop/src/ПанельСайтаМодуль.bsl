// Код статуса от сервера → человеческое слово и цвет наклейки.
// Счёт O!Деньги живёт сутки: кто не заплатил за сутки, уже не заплатит.
&НаСервереБезКонтекста
Функция ВидСтатуса(Код, Отгружен = Ложь, Создан = '00010101')

	Если Код = "awaiting_payment" Тогда
		Если Создан <> '00010101' И ТекущаяДатаСеанса() - Создан > 86400 Тогда
			Возврат Новый Структура("Название, Фон, Цвет", "Не оплатил", "#eef1f5", "#5d6d7e");
		КонецЕсли;
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт оплаты", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "paid" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Оплачен, ждёт 1С", "#e7effd", "#1b4894");
	ИначеЕсли Код = "in_1c" Тогда
		Если Отгружен Тогда
			Возврат Новый Структура("Название, Фон, Цвет", "Отгружен", "#e4f3ec", "#14663c");
		КонецЕсли;
		// Деньги взяты, документы есть, товара на складе не было — заказ надо везти.
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт отгрузки", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "failed" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Ошибка загрузки", "#fbe7e5", "#93261c");
	ИначеЕсли Код = "cancelled" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Отменён", "#eef1f5", "#5d6d7e");
	КонецЕсли;
	Возврат Новый Структура("Название, Фон, Цвет", ?(ПустаяСтрока(Код), "—", Код), "#eef1f5", "#5d6d7e");

КонецФункции

// «сегодня 12:31» читается быстрее, чем «19.09.2026 12:31».
&НаСервереБезКонтекста
Функция КогдаЗаказ(Дата)

	Если Дата = '00010101' Тогда
		Возврат "—";
	КонецЕсли;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Если Дата >= Сегодня Тогда
		Возврат "сегодня " + Формат(Дата, "ДФ='HH:mm'");
	ИначеЕсли Дата >= Сегодня - 86400 Тогда
		Возврат "вчера " + Формат(Дата, "ДФ='HH:mm'");
	ИначеЕсли Год(Дата) = Год(Сегодня) Тогда
		Возврат Формат(Дата, "ДФ='dd.MM HH:mm'");
	КонецЕсли;
	Возврат Формат(Дата, "ДФ='dd.MM.yy HH:mm'");

КонецФункции

// Названия товаров заказа: до трёх строк, остальное числом.
// Сервер присылает только первые позиции, всего их — в itemsTotal.
&НаСервереБезКонтекста
Функция ТоварыЗаказа(Заказ)

	Позиции = Заказ.Получить("items");
	Если ТипЗнч(Позиции) <> Тип("Массив") ИЛИ Позиции.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Если ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Название = СтрокаИз(Позиция, "name");
		Если ПустаяСтрока(Название) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЧислоИз(Позиция, "qty");
		Части.Добавить(Э(Название) + ?(Количество > 1, " × " + Ч(Количество), ""));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Всего = ЦелоеИз(Заказ, "itemsTotal");
	Ещё = Всего - Части.Количество();
	Результат = СтрСоединить(Части, "<br>");
	Если Ещё > 0 Тогда
		Результат = Результат + "<small>и ещё " + Ч(Ещё) + "</small>";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Заказы за период: когда сделан, когда оплачен, кто, что, на сколько.
&НаСервереБезКонтекста
Функция ТаблицаЗаказов(Список)

	Если Список.Количество() = 0 Тогда
		Возврат "<div class='note'>Таких заказов за период нет.</div>";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Создан</th><th>Оплачен</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th class='num'>Бонусами</th><th>Статус</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Создан = МестнаяДатаИзISO(Заказ.Получить("createdAt"));
		Оплачен = МестнаяДатаИзISO(Заказ.Получить("paidAt"));
		Статус = ВидСтатуса(СтрокаИз(Заказ, "status"), Заказ.Получить("realized") = Истина, Создан);
		Бонусами = ЧислоИз(Заказ, "bonusSpent");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Покупатель = ?(ПустаяСтрока(Имя), "<span class='dim'>без имени</span>", Э(Имя))
			+ ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Э(КогдаЗаказ(Создан)) + "</td>"
			+ "<td class='dim'>" + ?(Оплачен = '00010101', "—", Э(КогдаЗаказ(Оплачен))) + "</td>"
			+ "<td>" + Покупатель + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td class='num'>" + ?(Бонусами > 0, Э(Ч(Бонусами)), "<span class='dim'>—</span>") + "</td>"
			+ "<td><span class='pill' style='background:" + Статус.Фон + ";color:" + Статус.Цвет + "'>"
			+ Э(Статус.Название) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");
	Возврат СтрСоединить(Строки, "");

КонецФункции

// Оплаченные заказы, по которым надо что-то сделать: привезти товар, вернуть
// деньги, оформить вручную. Покупатель о нехватке не знает — знает владелец.
// Показывается всегда, какой бы период ни был выбран: такое нельзя пропустить.
&НаСервереБезКонтекста
Функция КарточкаВнимания(Список)

	Если Список.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Оплачен</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th>Что сделать</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Вид = СтрокаИз(Заказ, "kind");
		Если Вид = "failed" Тогда
			Дело = "Не попал в 1С — оформите заказ вручную";
			Цвет = "#93261c";
			Фон = "#fbe7e5";
		ИначеЕсли Вид = "waiting_1c" Тогда
			Дело = "1С не забирает — включите компьютер с 1С";
			Цвет = "#1b4894";
			Фон = "#e7effd";
		Иначе
			Дело = "Товара нет на складе — привезите или верните деньги";
			Цвет = "#8a5a10";
			Фон = "#fdf0dc";
		КонецЕсли;
		Оплачен = МестнаяДатаИзISO(Заказ.Получить("paidAt"));
		Дней = ?(Оплачен = '00010101', 0, Цел((ТекущаяДатаСеанса() - Оплачен) / 86400));
		Когда = Э(КогдаЗаказ(Оплачен)) + ?(Дней > 0, "<small>ждёт " + Ч(Дней) + " дн.</small>", "");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Когда + "</td>"
			+ "<td>" + Э(Имя) + ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>") + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td><span class='pill' style='background:" + Фон + ";color:" + Цвет + "'>" + Э(Дело) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");

	Возврат "<div class='card full' style='border:2px solid #e8672d'><div class='head'>"
		+ "<b>&#9888; Оплачено — нужно действие</b><span>" + Э(Ч(Список.Количество()) + " заказ(ов) · покупатель о нехватке не знает")
		+ "</span></div>" + СтрСоединить(Строки, "") + "</div>";

КонецФункции

// Склад и сайт не совпадают — одна строка: сколько и где смотреть. Сам список
// на вкладке «Склад и сайт»: длинный, он заслонял графики.
&НаСервереБезКонтекста
Функция СтрокаСклада(Склад)

	Части = Новый Массив;
	Если Склад.БезОстатка > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#fbe7e5;color:#93261c;font-weight:600'>на сайте «В наличии», на складе 0: "
			+ Ч(Склад.БезОстатка) + "</span>");
	КонецЕсли;
	Если Склад.БезЦены > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#e7effd;color:#1b4894'>на складе есть, цены нет: "
			+ Ч(Склад.БезЦены) + "</span>");
	КонецЕсли;
	Если Склад.НетВНаличии > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#eef1f5;color:#5d6d7e'>на складе есть, на сайте «нет»: "
			+ Ч(Склад.НетВНаличии) + "</span>");
	КонецЕсли;
	// Товар приехал, а сайт всё ещё пишет «Скоро»: пора поставить «По остатку».
	Если Склад.Предзаказ > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#eef1f5;color:#5d6d7e'>предзаказ, а товар пришёл: "
			+ Ч(Склад.Предзаказ) + "</span>");
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<div class='strip'><b>&#9888; Склад и сайт не совпадают</b>" + СтрСоединить(Части, "")
		+ "<a href='#sklad'>открыть список &#8594;</a></div>";

КонецФункции

&НаСервереБезКонтекста
Функция ТекстПанели(Данные, НазваниеПериода, НазваниеОтбора, Склад)

	Заказы     = Раздел(Данные, "orders");
	Каталог    = Раздел(Данные, "catalog");
	Покупатели = Раздел(Данные, "customers");
	Коды       = Раздел(Данные, "codes");
	Каналы     = Раздел(Данные, "channels");

	СтарыйСервер = (ТипЗнч(Данные.Получить("period")) <> Тип("Соответствие"));
	ЗаПериод = ?(СтарыйСервер, ПериодИзСтарогоОтвета(Данные), Раздел(Данные, "period"));
	Итоги     = Раздел(ЗаПериод, "stats");
	Сравнение = Раздел(ЗаПериод, "compare");
	Было      = Раздел(Сравнение, "stats");

	// ── Какой период на экране и с чем сравниваем ─────────────────────────────
	НачалоПериода = ДеньИзISO(СтрокаИз(ЗаПериод, "from"));
	КонецПериода  = ДеньИзISO(СтрокаИз(ЗаПериод, "to"));
	Шапка = "<div class='cap'><b>" + Э(?(СтарыйСервер, "Сегодня", НазваниеПериода)) + "</b>" + Э(ОписаниеДат(НачалоПериода, КонецПериода));
	Если НЕ СтарыйСервер Тогда
		Шапка = Шапка + " · сравниваем: " + Э(СтрокаИз(Сравнение, "label")) + " ("
			+ Э(ОписаниеДат(ДеньИзISO(СтрокаИз(Сравнение, "from")), ДеньИзISO(СтрокаИз(Сравнение, "to")))) + ")";
	КонецЕсли;
	Шапка = Шапка + "</div>";
	Если СтарыйСервер Тогда
		Шапка = Шапка + "<div class='hint'>Сервер ещё не обновлён: показано только «сегодня», без сравнения. "
			+ "Даты «с» и «по» заработают после обновления сервера.</div>";
	КонецЕсли;

	// ── Плитки за период ─────────────────────────────────────────────────────
	Люди = ЧислоИз(Итоги, "people");
	Продаж = ЧислоИз(Итоги, "sales");
	Плитки = Новый Массив;
	Плитки.Добавить(Плитка("Люди на сайте", Ч(Люди), "",
		"страниц открыто " + Ч(ЧислоИз(Итоги, "views")),
		?(СтарыйСервер, "", Изменение(Люди, ЧислоИз(Было, "people")))));
	Плитки.Добавить(Плитка("Заказы", Ч(ЧислоИз(Итоги, "orders")), "",
		"оплачено " + Ч(Продаж),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "orders"), ЧислоИз(Было, "orders")))));
	Плитки.Добавить(Плитка("Выручка", Ч(ЧислоИз(Итоги, "money")), "сом",
		"деньгами через O!Деньги" + ?(ЧислоИз(Итоги, "bonus") > 0, " · бонусами " + Ч(ЧислоИз(Итоги, "bonus")), ""),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "money"), ЧислоИз(Было, "money"), "сом"))));
	Плитки.Добавить(Плитка("Средний чек", Ч(ЧислоИз(Итоги, "avgCheck")), "сом",
		"купили " + Формат(ЧислоИз(Итоги, "conversion"), "ЧДЦ=1; ЧН=0") + "% зашедших",
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "avgCheck"), ЧислоИз(Было, "avgCheck"), "сом"))));
	Плитки.Добавить(Плитка("Новые покупатели", Ч(ЧислоИз(Итоги, "newCustomers")), "",
		"входов в кабинет " + Ч(ЧислоИз(Итоги, "logins")),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "newCustomers"), ЧислоИз(Было, "newCustomers")))));
	// Эта плитка — про всё время, не про период: неотгруженный заказ ждёт, пока его не отвезут.
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Плитки.Добавить(Плитка("Ждут отгрузки", Ч(ЖдутОтгрузки), "",
			"оплачены, но товара не было на складе", "", Истина));
	КонецЕсли;

	// ── Графики по дням ──────────────────────────────────────────────────────
	Дни = МассивИз(Данные, "daily");
	Графики = Новый Массив;
	Графики.Добавить(КарточкаГрафика("Люди на сайте по дням", Ч(Люди) + " чел.",
		Дни, "people", "#1f9254", "#7cc79d"));
	Графики.Добавить(КарточкаГрафика("Заказы по дням", Ч(ЧислоИз(Итоги, "orders")),
		Дни, "orders", "#2563eb", "#93b4f5"));
	Графики.Добавить(КарточкаГрафика("Выручка по дням (по дню оплаты)", Ч(ЧислоИз(Итоги, "money")) + " сом",
		Дни, "paid", "#7a5af8", "#bfb0fb", Истина));

	// ── Путь покупателя, что покупают, что смотрят, статусы ──────────────────
	Статусы = Раздел(ЗаПериод, "statuses");
	СписокСтатусов = Новый Массив;
	СписокСтатусов.Добавить(НовыйСтатус("Ждут оплаты", ЦелоеИз(Статусы, "awaitingPayment"), "#e8a33d"));
	СписокСтатусов.Добавить(НовыйСтатус("Не оплатили", ЦелоеИз(Статусы, "abandoned"), "#c9cfd8"));
	СписокСтатусов.Добавить(НовыйСтатус("Оплачены, ждут 1С", ЦелоеИз(Статусы, "paidWaiting1C"), "#2563eb"));
	СписокСтатусов.Добавить(НовыйСтатус("Ждут отгрузки", ЦелоеИз(Статусы, "awaitingShipment"), "#e8672d"));
	СписокСтатусов.Добавить(НовыйСтатус("Отгружены", ЦелоеИз(Статусы, "shipped"), "#1f9254"));
	СписокСтатусов.Добавить(НовыйСтатус("С ошибкой", ЦелоеИз(Статусы, "failed"), "#d33b2e"));
	СписокСтатусов.Добавить(НовыйСтатус("Отменены", ЦелоеИз(Статусы, "cancelled"), "#8e99a8"));
	ВсегоСтатусов = 0;
	Для Каждого Статус Из СписокСтатусов Цикл
		ВсегоСтатусов = ВсегоСтатусов + Статус.Значение;
	КонецЦикла;
	ТелоСтатусов = ?(ВсегоСтатусов = 0, "<div class='note'>За период заказов не было.</div>",
		ПолосаСтатусов(СписокСтатусов, ВсегоСтатусов))
		+ "<div class='lines' style='margin-top:8px'>"
		+ Строчка("Бонусами оплачено за период", Ч(ЧислоИз(Итоги, "bonus")) + " сом", Истина)
		+ Строчка("Бонусами за всё время", Ч(ЧислоИз(Заказы, "bonusSpent")) + " сом")
		+ "</div>";

	Анализ = Новый Массив;
	Анализ.Добавить(Карточка("Путь покупателя", "сколько людей дошло", ПутьПокупателя(Итоги), "card c4"));
	Анализ.Добавить(Карточка("Что покупают", "шт · сом", ЧтоПокупают(МассивИз(ЗаПериод, "topProducts")), "card c4"));
	Анализ.Добавить(Карточка("Что смотрят", "разных людей", ЧтоСмотрят(МассивИз(ЗаПериод, "topViewed")), "card c4"));
	Анализ.Добавить(Карточка("Заказы за период", "всего " + Ч(ВсегоСтатусов), ТелоСтатусов, "card c4"));

	// ── Сайт сейчас: каталог, покупатели, код входа (от периода не зависят) ──
	ТоваровВсего   = ЦелоеИз(Каталог, "items");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	ДатаКаталога   = МестнаяДатаИзISO(Каталог.Получить("updatedAt"));
	ТелоКаталога = "<div class='lines'>"
		+ Строчка("Товаров в каталоге", Ч(ТоваровВсего))
		+ Строчка("Из них с ценой", Ч(ЦелоеИз(Каталог, "withPrice")))
		+ Строчка("Готовы к продаже", Ч(ГотовыКПродаже))
		+ Строчка("Обновлён", ?(ДатаКаталога = '00010101', "ещё не выгружался",
			Формат(ДатаКаталога, "ДФ='dd.MM.yyyy HH:mm'")), Истина)
		+ "</div>";

	ТелоПокупателей = "<div class='lines'>"
		+ Строчка("Всего в SBonus", Ч(ЦелоеИз(Покупатели, "active")))
		+ Строчка("Зарегистрировались на сайте", Ч(ЦелоеИз(Покупатели, "fromSite")))
		+ Строчка("Заказов с сайта за всё время", Ч(ЦелоеИз(Заказы, "total")), Истина)
		+ Строчка("Оплачено за всё время", Ч(ЧислоИз(Заказы, "paidTotal")) + " сом")
		+ "</div>";

	Телеграм = СтрокаИз(Каналы, "telegram");
	ВотсАп = СтрокаИз(Каналы, "whatsapp");
	ТелоКаналов = "<div class='lines'>"
		+ Строчка(Огонёк(Телеграм) + "Telegram", Телеграм)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "telegramToday")) + " / " + Ч(ЦелоеИз(Коды, "telegramWeek")))
		+ Строчка(Огонёк(ВотсАп) + "WhatsApp (запасной)", ВотсАп, Истина)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "whatsappToday")) + " / " + Ч(ЦелоеИз(Коды, "whatsappWeek")))
		+ "</div>";

	Сейчас = Новый Массив;
	Сейчас.Добавить(Карточка("Каталог на сайте", "сейчас", ТелоКаталога));
	Сейчас.Добавить(Карточка("Покупатели", "всё время", ТелоПокупателей));
	Сейчас.Добавить(Карточка("Код для входа на сайт", "сейчас", ТелоКаналов));

	// ── Список заказов за период ─────────────────────────────────────────────
	СписокЗаказов = МассивИз(ЗаПериод, "orders");
	Найдено = ЦелоеИз(ЗаПериод, "ordersFound");
	Примечание = "найдено " + Ч(Найдено);
	Если ЧислоИз(ЗаПериод, "ordersAmount") > 0 Тогда
		Примечание = Примечание + " на " + Ч(ЧислоИз(ЗаПериод, "ordersAmount")) + " сом";
	КонецЕсли;
	Если Найдено > СписокЗаказов.Количество() Тогда
		Примечание = Примечание + " · показаны последние " + Ч(СписокЗаказов.Количество());
	КонецЕсли;
	Заголовок = ?(СтарыйСервер, "Последние заказы", "Заказы за период: " + НРег(НазваниеОтбора));
	ТаблицаПериода = "<div class='card full'><div class='head'><b>" + Э(Заголовок) + "</b>"
		+ "<span>" + Э(Примечание) + "</span></div>"
		+ ТаблицаЗаказов(СписокЗаказов) + "</div>";

	// Самое срочное — сразу под плитками: деньги взяты, а товара нет.
	Внимание = КарточкаВнимания(МассивИз(Данные, "attention"));

	Тело = "<div class='wrap'>" + Шапка + СтрокаСклада(Склад)
		+ "<div class='row'>" + СтрСоединить(Плитки, "") + "</div>"
		+ ?(ПустаяСтрока(Внимание), "", "<div class='row'>" + Внимание + "</div>")
		+ "<div class='row'>" + СтрСоединить(Графики, "") + "</div>"
		+ "<div class='row'>" + СтрСоединить(Анализ, "") + "</div>"
		+ "<div class='row'>" + ТаблицаПериода + "</div>"
		+ "<div class='row'>" + СтрСоединить(Сейчас, "") + "</div>"
		+ "</div>";
	Возврат Страница(Тело);

КонецФункции

// Зелёный кружок — канал отвечает, красный — нет. Сервер пишет состояние словами.
&НаСервереБезКонтекста
Функция Огонёк(СостояниеКанала)

	Цвет = ?(НРег(СостояниеКанала) = "работает", "#1f9254", "#d33b2e");
	Возврат "<i class='dot' style='background:" + Цвет + "'></i>";

КонецФункции

#КонецОбласти

#Область Баннеры

// Баннеры главной сайта (07.10). Список живёт на сервере, здесь — показ, правка и отправка.
// Картинка уходит на сервер сразу, как только её выбрали; поля (название, ссылка, даты, порядок) —
// кнопкой «Сохранить баннеры». «Куда ведёт» пишут как удобно: код товара (ЦБ-00001882), раздел
// («Холодильники»), страницу сайта (/ru/catalog?sale=1) или адрес другого сайта (https://…).

&НаКлиенте
Процедура БаннерыПриАктивизацииСтроки(Элемент)

	ОбновитьВидТекущегоБаннера();

КонецПроцедуры

&НаКлиенте
Процедура БаннерыПолеПриИзменении(Элемент)

	ОбновитьВидТекущегоБаннера();
	Состояние = "Баннеры изменены — нажмите «Сохранить баннеры», чтобы сайт их показал.";

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьБаннеры(Команда)

	ЗагрузитьБаннерыНаСервере();
	ВыделитьБаннер(0);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьБаннеры(Команда)

	Индекс = ИндексТекущегоБаннера();
	Ошибка = СохранитьБаннерыНаСервере();
	ВыделитьБаннер(Индекс);
	Если НЕ ПустаяСтрока(Ошибка) Тогда
		ПоказатьПредупреждение(, Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КартинкаДляКомпьютера(Команда)

	ВыбратьКартинкуБаннера("desktop");

КонецПроцедуры

&НаКлиенте
Процедура КартинкаДляТелефона(Команда)

	ВыбратьКартинкуБаннера("mobile");

КонецПроцедуры

&НаКлиенте
Процедура УбратьКартинкуТелефона(Команда)

	Индекс = ИндексТекущегоБаннера();
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	Итог = ЗагрузитьКартинкуБаннераНаСервере(Неопределено, "mobile", Индекс);
	ВыделитьБаннер(Итог.Индекс);
	Если НЕ ПустаяСтрока(Итог.Ошибка) Тогда
		ПоказатьПредупреждение(, Итог.Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКартинкуБаннера(Вид)

	Индекс = ИндексТекущегоБаннера();
	Если Индекс < 0 Тогда
		ПоказатьПредупреждение(, "Сначала добавьте баннер в список (кнопка «Добавить» над списком) и выберите его строку.");
		Возврат;
	КонецЕсли;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = ?(Вид = "desktop", "Картинка для компьютера — широкая, 2400×1000",
		"Картинка для телефона — квадрат, 1080×1080");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Картинка (*.jpg;*.jpeg;*.png;*.webp)|*.jpg;*.jpeg;*.png;*.webp";
	Оповещение = Новый ОписаниеОповещения("КартинкаБаннераВыбрана", ЭтотОбъект, Новый Структура("Вид, Индекс", Вид, Индекс));
	НачатьПомещениеФайлов(Оповещение, , Диалог, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура КартинкаБаннераВыбрана(ПомещенныеФайлы, Параметры) Экспорт

	Если ПомещенныеФайлы = Неопределено ИЛИ ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Итог = ЗагрузитьКартинкуБаннераНаСервере(ПомещенныеФайлы[0].Хранение, Параметры.Вид, Параметры.Индекс);
	ВыделитьБаннер(Итог.Индекс);
	// Сервер не принял картинку (мелкая, не те пропорции, не картинка) — причина окном, её нельзя пропустить.
	Если НЕ ПустаяСтрока(Итог.Ошибка) Тогда
		ПоказатьПредупреждение(, Итог.Ошибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИндексТекущегоБаннера()

	Если Элементы.Баннеры.ТекущаяСтрока = Неопределено Тогда
		Возврат -1;
	КонецЕсли;
	Строка = Баннеры.НайтиПоИдентификатору(Элементы.Баннеры.ТекущаяСтрока);
	Возврат ?(Строка = Неопределено, -1, Баннеры.Индекс(Строка));

КонецФункции

&НаКлиенте
Процедура ВыделитьБаннер(Индекс)

	Если Индекс >= 0 И Индекс < Баннеры.Количество() Тогда
		Элементы.Баннеры.ТекущаяСтрока = Баннеры[Индекс].ПолучитьИдентификатор();
	КонецЕсли;
	ОбновитьВидТекущегоБаннера();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидТекущегоБаннера()

	Данные = Элементы.Баннеры.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		ВидБаннераHTML = ВидБаннера(Неопределено);
	Иначе
		ВидБаннераHTML = ВидБаннера(Новый Структура("Компьютер, Телефон, Ссылка, Включен, С, По, Размер, РазмерТелефон",
			Данные.АдресКомпьютер, Данные.АдресТелефон, Данные.Ссылка, Данные.Включен, Данные.С, Данные.По,
			Данные.Компьютер, Данные.Телефон));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьБаннерыНаСервере()

	БаннерыЗагружены = Истина;
	ПодсказкаБаннеров = ПодсказкаПоБаннерам();
	Ошибка = "";
	КодОтвета = 0;
	Ответ = ИМ_ЗаказыСайтаСервер.БаннерыСайта(Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Состояние = ОшибкаБаннеров(Ошибка, КодОтвета);
		Возврат;
	КонецЕсли;
	ЗаполнитьБаннеры(Ответ);
	Состояние = ?(Баннеры.Количество() = 0,
		"Баннеров пока нет: сайт показывает свой баннер (новинки, Kemal Usman, хиты). Добавьте свой кнопкой «Добавить».",
		"Баннеров: " + Баннеры.Количество() + ".");
	Модифицированность = Ложь;

КонецПроцедуры

// Ответ — текст ошибки для владельца; пусто — сохранено.
&НаСервере
Функция СохранитьБаннерыНаСервере()

	Список = Новый Массив;
	Для Каждого Строка Из Баннеры Цикл
		Ссылка = СсылкаДляСервера(Строка.Ссылка);
		Ошибка = ОшибкаСсылки(Ссылка, Строка.Заголовок);
		Если НЕ ПустаяСтрока(Ошибка) Тогда
			Состояние = "Баннеры не сохранены: " + Ошибка;
			Возврат Ошибка;
		КонецЕсли;
		Список.Добавить(Новый Структура("id, title, link, active, starts, ends",
			Строка.Ид, СокрЛП(Строка.Заголовок), Ссылка, Строка.Включен, Строка.С, Строка.По));
	КонецЦикла;
	Ошибка = "";
	КодОтвета = 0;
	Ответ = ИМ_ЗаказыСайтаСервер.СохранитьБаннерыСайта(Список, Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Ошибка = ОшибкаБаннеров(Ошибка, КодОтвета);
		Состояние = "Баннеры не сохранены: " + Ошибка;
		Возврат Ошибка;
	КонецЕсли;
	ЗаполнитьБаннеры(Ответ);
	Модифицированность = Ложь;
	Состояние = "Баннеры сохранены (" + Баннеры.Количество() + "). Сайт покажет их в течение минуты.";
	Возврат "";

КонецФункции

// Ссылка на товар — только на товар, который есть в 1С: иначе на сайте баннер вёл бы на пустую страницу.
&НаСервере
Функция ОшибкаСсылки(Ссылка, Заголовок)

	Чей = "«" + ?(ПустаяСтрока(Заголовок), "Баннер без названия", СокрЛП(Заголовок)) + "»: ";
	Как = " В «Куда ведёт» пишут код товара (ЦБ-00001882), раздел (Холодильники), страницу сайта (/ru/catalog?sale=1)"
		+ " или адрес другого сайта (https://…).";
	Если СтрНачинаетсяС(НРег(Ссылка), "http://") Тогда
		Возврат Чей + "адрес сайта должен начинаться с https:// (защищённый)." + Как;
	КонецЕсли;
	Если СтрНачинаетсяС(Ссылка, "product:") Тогда
		Код = СокрЛП(Сред(Ссылка, 9));
		Товар = Справочники.Номенклатура.НайтиПоКоду(Код);
		Если ПустаяСтрока(Код) ИЛИ Товар.Пустая() Тогда
			Возврат Чей + "товар с кодом «" + Код + "» не найден." + Как;
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

// Новый баннер ещё без номера на сервере — сначала сохраняем список (он сохранит и прочие правки).
// Потом в строке меняются только картинки: несохранённые правки других строк не теряются.
&НаСервере
Функция ЗагрузитьКартинкуБаннераНаСервере(Адрес, Вид, Индекс)

	Итог = Новый Структура("Индекс, Ошибка", Индекс, "");
	Если Индекс < 0 ИЛИ Индекс >= Баннеры.Количество() Тогда
		Итог.Индекс = -1;
		Возврат Итог;
	КонецЕсли;
	Если Баннеры[Индекс].Ид = 0 Тогда
		Итог.Ошибка = СохранитьБаннерыНаСервере();
		Если НЕ ПустаяСтрока(Итог.Ошибка) Тогда
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;
	Данные = Неопределено;
	Если Адрес <> Неопределено Тогда
		Данные = ПолучитьИзВременногоХранилища(Адрес);
		УдалитьИзВременногоХранилища(Адрес);
		Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Итог.Ошибка = "Файл не прочитан — выберите картинку ещё раз.";
			Состояние = Итог.Ошибка;
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;
	Строка = Баннеры[Индекс];
	Ошибка = "";
	КодОтвета = 0;
	Ответ = ИМ_ЗаказыСайтаСервер.ЗагрузитьКартинкуБаннера(Строка.Ид, Вид, Данные, Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Итог.Ошибка = "Картинка " + ?(Вид = "desktop", "для компьютера", "для телефона") + " не поставлена: "
			+ ОшибкаБаннеров(Ошибка, КодОтвета);
		Состояние = Итог.Ошибка;
		Возврат Итог;
	КонецЕсли;
	Список = Ответ.Получить("banners");
	Если ТипЗнч(Список) = Тип("Массив") Тогда
		Для Каждого Элемент Из Список Цикл
			Если ЦелоеИз(Элемент, "id") = Строка.Ид Тогда
				ЗаполнитьКартинкуБаннера(Строка, Элемент.Получить("desktop"), "Компьютер");
				ЗаполнитьКартинкуБаннера(Строка, Элемент.Получить("mobile"), "Телефон");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Данные = Неопределено Тогда
		Состояние = "Картинка для телефона убрана: телефон покажет картинку для компьютера.";
	Иначе
		Состояние = "Картинка поставлена (" + ?(Вид = "desktop", Строка.Компьютер, Строка.Телефон)
			+ "). Сайт покажет её в течение минуты.";
	КонецЕсли;
	Возврат Итог;

КонецФункции

&НаСервере
Процедура ЗаполнитьБаннеры(Ответ)

	Баннеры.Очистить();
	Список = Ответ.Получить("banners");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Список Цикл
		Строка = Баннеры.Добавить();
		Строка.Ид = ЦелоеИз(Элемент, "id");
		Строка.Включен = (Элемент.Получить("active") = Истина);
		Строка.Заголовок = СтрокаИз(Элемент, "title");
		Строка.Ссылка = СсылкаДляПоказа(СтрокаИз(Элемент, "link"));
		Строка.С = ДеньИзISO(Элемент.Получить("starts"));
		Строка.По = ДеньИзISO(Элемент.Получить("ends"));
		ЗаполнитьКартинкуБаннера(Строка, Элемент.Получить("desktop"), "Компьютер");
		ЗаполнитьКартинкуБаннера(Строка, Элемент.Получить("mobile"), "Телефон");
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинкуБаннера(Строка, Данные, Вид)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Строка[Вид] = ?(Вид = "Компьютер", "нет", "как у компьютера");
		Строка["Адрес" + Вид] = "";
		Возврат;
	КонецЕсли;
	Строка[Вид] = Формат(ЦелоеИз(Данные, "w"), "ЧГ=") + "×" + Формат(ЦелоеИз(Данные, "h"), "ЧГ=");
	Строка["Адрес" + Вид] = СтрокаИз(Данные, "url");

КонецПроцедуры

// Что пишет владелец → что понимает сервер: product:<код>, cat:<раздел>, /страница, https://адрес.
&НаСервере
Функция СсылкаДляСервера(Текст)

	Ссылка = СокрЛП(Текст);
	Если ПустаяСтрока(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Начало = НРег(Ссылка);
	Если СтрНачинаетсяС(Начало, "https://") ИЛИ СтрНачинаетсяС(Начало, "http://") ИЛИ СтрНачинаетсяС(Ссылка, "/")
		ИЛИ СтрНачинаетсяС(Начало, "product:") ИЛИ СтрНачинаетсяС(Начало, "cat:") Тогда
		Возврат Ссылка;
	КонецЕсли;
	Разделы = ИМ_ОнлайнМагазинСервер.РазделыСайта();
	Для Каждого Раздел Из Разделы Цикл
		Если Раздел <> "Авто" И НРег(Раздел) = Начало Тогда
			Возврат "cat:" + Раздел;
		КонецЕсли;
	КонецЦикла;
	Возврат "product:" + Ссылка;

КонецФункции

// Обратно — как удобно читать: код товара и раздел без приставок.
&НаСервереБезКонтекста
Функция СсылкаДляПоказа(Ссылка)

	Если СтрНачинаетсяС(Ссылка, "product:") Тогда
		Возврат Сред(Ссылка, 9);
	ИначеЕсли СтрНачинаетсяС(Ссылка, "cat:") Тогда
		Возврат Сред(Ссылка, 5);
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

&НаСервереБезКонтекста
Функция ОшибкаБаннеров(Ошибка, КодОтвета)

	Если КодОтвета = 404 И СтрНайти(Ошибка, "баннер") = 0 Тогда
		Возврат "Сервер сайта ещё не обновлён — баннеры заработают после его обновления.";
	КонецЕсли;
	Возврат Ошибка;

КонецФункции

&НаСервереБезКонтекста
Функция ПодсказкаПоБаннерам()

	Возврат "Картинка для компьютера — широкая 2400×1000, для телефона — квадрат 1080×1080: JPG, PNG или WebP до 5 МБ."
		+ " Картинку не пережимаем — сайт сам отдаёт каждому экрану нужный размер, поэтому она остаётся чёткой."
		+ " Нет картинки для телефона — на телефоне покажется широкая (мелко), лучше положить квадрат."
		+ Символы.ПС
		+ "«Куда ведёт»: код товара (ЦБ-00001882), раздел («Холодильники»), страница сайта (/ru/catalog?sale=1)"
		+ " или адрес другого сайта (https://kemalusman.kg — откроется в новой вкладке). Пусто — баннер без ссылки."
		+ Символы.ПС
		+ "Порядок на сайте — как в списке (стрелки над списком). «С» и «По» — когда показывать, пусто — всегда."
		+ " Без картинки для компьютера баннер не показывается. Нет ни одного баннера — сайт показывает свой."
		+ " Название — для вас и для незрячих покупателей (его читает экранный диктор).";

КонецФункции

// Как увидят на сайте: картинка для компьютера, для телефона, куда ведёт и когда показывается.
&НаКлиентеНаСервереБезКонтекста
Функция ВидБаннера(Данные)

	Стиль = "<style>body{font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#263244;margin:10px}"
		+ "img{display:block;max-width:100%;border:1px solid #e3e8ee;border-radius:12px}"
		+ ".k{margin:12px 0 4px;font-size:12px;font-weight:600;color:#5d6d7e}.m{max-width:46%}"
		+ ".no{padding:14px;border:1px dashed #c4cdd8;border-radius:12px;color:#5d6d7e}.bad{color:#d33b2e}</style>";
	Если Данные = Неопределено Тогда
		Тело = "<div class='no'>Баннеров нет. Нажмите «Добавить» над списком, напишите название и выберите картинку.</div>";
		Возврат "<html><head><meta charset='utf-8'>" + Стиль + "</head><body>" + Тело + "</body></html>";
	КонецЕсли;

	Куски = Новый Массив;
	Куски.Добавить("<div class='k'>Компьютер</div>");
	Если ПустаяСтрока(Данные.Компьютер) Тогда
		Куски.Добавить("<div class='no bad'>Нет картинки — баннер не покажется. Кнопка «Картинка для компьютера…».</div>");
	Иначе
		Куски.Добавить("<img src='" + ЭкранироватьАтрибут(Данные.Компьютер) + "'>");
	КонецЕсли;
	Куски.Добавить("<div class='k'>Телефон</div>");
	Если ПустаяСтрока(Данные.Телефон) Тогда
		Куски.Добавить("<div class='no'>Покажется картинка для компьютера.</div>");
	Иначе
		Куски.Добавить("<img class='m' src='" + ЭкранироватьАтрибут(Данные.Телефон) + "'>");
	КонецЕсли;

	Ссылка = СокрЛП(Данные.Ссылка);
	Куски.Добавить("<div class='k'>Куда ведёт</div><div>"
		+ ?(ПустаяСтрока(Ссылка), "никуда — баннер без ссылки", ЭкранироватьТекст(Ссылка)) + "</div>");

	Если НЕ Данные.Включен Тогда
		Когда = "<span class='bad'>выключен — не показывается</span>";
	ИначеЕсли НЕ ЗначениеЗаполнено(Данные.С) И НЕ ЗначениеЗаполнено(Данные.По) Тогда
		Когда = "всегда";
	Иначе
		Когда = ?(ЗначениеЗаполнено(Данные.С), "с " + Формат(Данные.С, "ДФ=dd.MM.yyyy") + " ", "")
			+ ?(ЗначениеЗаполнено(Данные.По), "по " + Формат(Данные.По, "ДФ=dd.MM.yyyy"), "");
	КонецЕсли;
	Куски.Добавить("<div class='k'>Когда</div><div>" + Когда + "</div>");

	Возврат "<html><head><meta charset='utf-8'>" + Стиль + "</head><body>" + СтрСоединить(Куски, "") + "</body></html>";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьТекст(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Возврат СтрЗаменить(Результат, ">", "&gt;");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭкранироватьАтрибут(Текст)

	Возврат СтрЗаменить(ЭкранироватьТекст(Текст), "'", "&#39;");

КонецФункции

#КонецОбласти
