// Пиксели и проценты для стилей: без пробелов в разрядах и с точкой.
&НаСервереБезКонтекста
Функция К(Значение)

	Возврат Формат(Значение, "ЧДЦ=1; ЧРД='.'; ЧГ=0; ЧН=0");

КонецФункции

// Подпись над столбиком денег: «13 900» не влезает, «13,9к» — влезает.
&НаСервереБезКонтекста
Функция Коротко(Значение)

	Если Значение >= 1000000 Тогда
		Возврат Формат(Значение / 1000000, "ЧДЦ=1; ЧН=0") + "м";
	ИначеЕсли Значение >= 10000 Тогда
		Возврат Формат(Значение / 1000, "ЧДЦ=0; ЧН=0") + "к";
	ИначеЕсли Значение >= 1000 Тогда
		Возврат Формат(Значение / 1000, "ЧДЦ=1; ЧН=0") + "к";
	КонецЕсли;
	Возврат Ч(Значение);

КонецФункции

&НаСервереБезКонтекста
Функция Э(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, "'", "&#39;");
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ДеньНеделиКратко(Дата)

	Дни = СтрРазделить("пн,вт,ср,чт,пт,сб,вс", ",");
	Возврат Дни[ДеньНедели(Дата) - 1];

КонецФункции

// «24.09.2026, чт» для одного дня, «18.09 — 24.09.2026 (7 дн.)» для отрезка.
&НаСервереБезКонтекста
Функция ОписаниеДат(Начало, Конец)

	Если Начало = '00010101' Тогда
		Возврат "";
	КонецЕсли;
	Если Начало = Конец Тогда
		Возврат Формат(Начало, "ДФ=dd.MM.yyyy") + ", " + ДеньНеделиКратко(Начало);
	КонецЕсли;
	Дней = Цел((Конец - Начало) / 86400) + 1;
	Первый = ?(Год(Начало) = Год(Конец), Формат(Начало, "ДФ=dd.MM"), Формат(Начало, "ДФ=dd.MM.yyyy"));
	Возврат Первый + " — " + Формат(Конец, "ДФ=dd.MM.yyyy") + " (" + Ч(Дней) + " дн.)";

