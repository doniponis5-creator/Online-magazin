// Панель сайта (расширение ИМ_ОнлайнМагазин): сводка по магазину и настройки сайта.
// Владелец смотрит и меняет всё отсюда, на сервер заходить не нужно.
// Сводка и настройки живут на сервере SBonus; здесь только показ и отправка.
//
// Сверху — период: сегодня, вчера, 7 дней, месяц или свои даты «с» и «по».
// Все цифры сводки считаются за этот период и сравниваются с прошлым таким же:
// «вчера» — с тем же днём неделю назад, «30 дней» — с предыдущими 30 днями.
//
// Три вкладки. «Сводка» — HTML-панель: плитки, графики по дням, карточки разделов,
// список заказов; HTML собирается здесь целиком, без интернета и внешних библиотек.
// «Склад и сайт» — таблица товаров, у которых склад и сайт не совпадают; считается
// прямо по 1С, двойной щелчок открывает карточку товара. «Настройки сайта» — поля.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период = "Сегодня";
	ОтборЗаказов = "Все заказы";
	ПоказатьРасхождения = "Все";
	УстановитьДатыПериода();
	ОбновитьВсёНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ПериодПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ДатаПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборЗаказовПриИзменении(Элемент)

	ЗагрузитьСводку();

КонецПроцедуры

// В сводке строка «Склад и сайт не совпадают» — ссылка на вкладку со списком.
&НаКлиенте
Процедура СводкаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = "";
	Если ДанныеСобытия.Свойство("Href") И ДанныеСобытия.Href <> Неопределено Тогда
		Ссылка = Строка(ДанныеСобытия.Href);
	КонецЕсли;
	Если СтрНайти(Ссылка, "#sklad") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСклад;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасхожденияПриИзменении(Элемент)

	Элементы.Расхождения.ОтборСтрок = ОтборРасхождений(ПоказатьРасхождения);

КонецПроцедуры

&НаКлиенте
Процедура РасхожденияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьКарточкуСтроки(ВыбраннаяСтрока);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьВсёНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуРасхождения(Команда)

	Если Элементы.Расхождения.ТекущаяСтрока <> Неопределено Тогда
		ОткрытьКарточкуСтроки(Элементы.Расхождения.ТекущаяСтрока);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСайт(Команда)

	НачатьЗапускПриложения(Новый ОписаниеОповещения, "https://smarket.kg");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Карточка товара — та же, что в списке «Онлайн магазин»: там цена сайта и
// «Наличие на сайте». Закрыли карточку — список и сводка пересчитываются.
&НаКлиенте
Процедура ОткрытьКарточкуСтроки(ИдентификаторСтроки)

	Строка = Расхождения.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Строка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияКарточки", ЭтотОбъект);
	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.КарточкаТовара",
		Новый Структура("Номенклатура", Строка.Номенклатура), ЭтотОбъект, Строка.Номенклатура, , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияКарточки(Результат, ДополнительныеПараметры) Экспорт

	ПослеЗакрытияКарточкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПослеЗакрытияКарточкиНаСервере()

	ЗагрузитьРасхождения();
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервере
Процедура ОбновитьВсёНаСервере()

	ЗагрузитьРасхождения();
	ЗагрузитьСводку();
	ЗагрузитьНастройки();
	ЗагрузитьЗнания();

КонецПроцедуры

// Готовый период («Вчера», «7 дней»…) сам ставит даты «с» и «по».
&НаСервере
Процедура УстановитьДатыПериода()

	Если ПустаяСтрока(Период) Тогда
		Период = "Сегодня";
	КонецЕсли;
	Даты = ДатыПериода(Период, НачалоДня(ТекущаяДатаСеанса()));
	ДатаС = Даты.Начало;
	ДатаПо = Даты.Конец;

КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()

	// «Свой период» — даты не трогаем: владелец сейчас впишет их сам.
	Если Период <> "Свой период" Тогда
		УстановитьДатыПериода();
	КонецЕсли;
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()

	Если НЕ ЗначениеЗаполнено(ДатаПо) Тогда
		ДатаПо = ?(ЗначениеЗаполнено(ДатаС), ДатаС, НачалоДня(ТекущаяДатаСеанса()));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
		ДатаС = ДатаПо;
	КонецЕсли;
	Если ДатаС > ДатаПо Тогда
		Обмен = ДатаС;
		ДатаС = ДатаПо;
		ДатаПо = Обмен;
	КонецЕсли;
	ДатаС = НачалоДня(ДатаС);
	ДатаПо = НачалоДня(ДатаПо);
	// Даты совпали с готовым периодом — так и назовём: «Вчера» понятнее двух дат.
	Период = ПериодПоДатам(ДатаС, ДатаПо);
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ГотовыеПериоды()

	Возврат СтрРазделить("Сегодня,Вчера,7 дней,30 дней,Этот месяц,Прошлый месяц", ",");

КонецФункции

&НаСервереБезКонтекста
Функция ДатыПериода(Имя, Сегодня)

	Если Имя = "Вчера" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 86400, Сегодня - 86400);
	ИначеЕсли Имя = "7 дней" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 6 * 86400, Сегодня);
	ИначеЕсли Имя = "30 дней" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 29 * 86400, Сегодня);
	ИначеЕсли Имя = "Этот месяц" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоМесяца(Сегодня), Сегодня);
	ИначеЕсли Имя = "Прошлый месяц" Тогда
		Прошлый = ДобавитьМесяц(НачалоМесяца(Сегодня), -1);
		Возврат Новый Структура("Начало, Конец", Прошлый, НачалоДня(КонецМесяца(Прошлый)));
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", Сегодня, Сегодня);

КонецФункции

&НаСервереБезКонтекста
Функция ПериодПоДатам(Начало, Конец)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Для Каждого Имя Из ГотовыеПериоды() Цикл
		Даты = ДатыПериода(Имя, Сегодня);
		Если Даты.Начало = Начало И Даты.Конец = Конец Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "Свой период";

КонецФункции

// Какие заказы перечислить в таблице внизу: слово на форме → ключ для сервера.
&НаСервереБезКонтекста
Функция КлючОтбора(Отбор)

	Если Отбор = "Продажи" Тогда
		Возврат "sales";
	ИначеЕсли Отбор = "Ждут оплаты" Тогда
		Возврат "awaiting";
	ИначеЕсли Отбор = "Не оплатили" Тогда
		Возврат "abandoned";
	ИначеЕсли Отбор = "Оплачены, не отгружены" Тогда
		Возврат "unshipped";
	ИначеЕсли Отбор = "Отменены" Тогда
		Возврат "cancelled";
	КонецЕсли;
	Возврат "all";

КонецФункции

// Склад и сайт не совпадают: таблица на вкладке, счётчики — для строки в сводке.
&НаСервере
Процедура ЗагрузитьРасхождения()

	Расхождения.Очистить();
	СкладБезОстатка = 0;
	СкладБезЦены = 0;
	СкладНетВНаличии = 0;
	Для Каждого Найдено Из ИМ_ЗаказыСайтаСервер.РасхожденияСкладаИСайта() Цикл
		Строка = Расхождения.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Найдено);
		Если Найдено.Проблема = "Продаётся без остатка" Тогда
			СкладБезОстатка = СкладБезОстатка + 1;
			Строка.Порядок = 1;
		ИначеЕсли Найдено.Проблема = "Нет цены на сайте" Тогда
			СкладБезЦены = СкладБезЦены + 1;
			Строка.Порядок = 2;
		Иначе
			СкладНетВНаличии = СкладНетВНаличии + 1;
			Строка.Порядок = 3;
		КонецЕсли;
	КонецЦикла;
	// Сначала то, что опаснее: продаётся без остатка; внутри — дорогие и многочисленные выше.
	Расхождения.Сортировать("Порядок, ЦенаСайта Убыв, Остаток Убыв");

	Всего = Расхождения.Количество();
	Элементы.СтраницаСклад.Заголовок = ?(Всего = 0, "Склад и сайт", "Склад и сайт (" + Формат(Всего, "ЧГ=0") + ")");
	Если Всего = 0 Тогда
		ИтогСклад = "Всё сходится: что на сайте «в наличии», то есть на складе.";
	Иначе
		ИтогСклад = "Продаётся без остатка: " + Формат(СкладБезОстатка, "ЧН=0; ЧГ=0")
			+ " · нет цены на сайте: " + Формат(СкладБезЦены, "ЧН=0; ЧГ=0")
			+ " · «нет в наличии» при остатке: " + Формат(СкладНетВНаличии, "ЧН=0; ЧГ=0")
			+ ". Двойной щелчок по строке — карточка товара: там цена сайта и «Наличие на сайте».";
	КонецЕсли;
	Элементы.Расхождения.ОтборСтрок = ОтборРасхождений(ПоказатьРасхождения);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОтборРасхождений(Показать)

	Если ПустаяСтрока(Показать) ИЛИ Показать = "Все" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый ФиксированнаяСтруктура("Проблема", Показать);

КонецФункции

&НаСервере
Процедура ЗагрузитьСводку()

	Если НЕ ЗначениеЗаполнено(ДатаС) ИЛИ НЕ ЗначениеЗаполнено(ДатаПо) Тогда
		УстановитьДатыПериода();
	КонецЕсли;
	Если ПустаяСтрока(ОтборЗаказов) Тогда
		ОтборЗаказов = "Все заказы";
	КонецЕсли;

	Ошибка = "";
	Отбор = Новый Структура("ДатаС, ДатаПо, Заказы", ДатаС, ДатаПо, КлючОтбора(ОтборЗаказов));
	Данные = ИМ_ЗаказыСайтаСервер.СводкаСайта(Ошибка, Отбор);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		ТекстHTML = ПанельОшибки(Ошибка);
		Возврат;
	КонецЕсли;

	Склад = Новый Структура("БезОстатка, БезЦены, НетВНаличии", СкладБезОстатка, СкладБезЦены, СкладНетВНаличии);
	ТекстHTML = ТекстПанели(Данные, Период, ОтборЗаказов, Склад);

	Заказы  = Раздел(Данные, "orders");
	Каталог = Раздел(Данные, "catalog");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	Ошибки1С       = ЦелоеИз(Заказы, "failed");

	Состояние = "Обновлено " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ".";
	Если ТипЗнч(Данные.Получить("period")) <> Тип("Соответствие") Тогда
		Состояние = Состояние + " Сервер ещё старый: даты «с» и «по» заработают после его обновления.";
	КонецЕсли;
	Если ГотовыКПродаже = 0 Тогда
		Состояние = Состояние + " Внимание: купить на сайте нечего — ни у одного товара нет и цены, и остатка.";
	КонецЕсли;
	Если Ошибки1С > 0 Тогда
		Состояние = Состояние + " Заказов с ошибкой загрузки в 1С: " + Формат(Ошибки1С, "ЧН=0; ЧГ=") + ".";
	КонецЕсли;
	Если СкладБезОстатка > 0 Тогда
		Состояние = Состояние + " На сайте «В наличии», а на складе 0: " + Формат(СкладБезОстатка, "ЧН=0; ЧГ=")
			+ " товар(ов) — вкладка «Склад и сайт».";
	КонецЕсли;
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Состояние = Состояние + " Оплачено, но не отгружено: " + Формат(ЖдутОтгрузки, "ЧН=0; ЧГ=")
			+ " — товара не было на складе, надо привезти и отгрузить.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.НастройкиСайта(Ошибка);
	Если Данные = Неопределено Тогда
		Если ПустаяСтрока(Состояние) Тогда
			Состояние = Ошибка;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Список = Данные.Получить("settings");
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Настройка Из Список Цикл
		Ключ = Строка(Настройка.Получить("key"));
		Значение = Строка(Настройка.Получить("value"));
		Если Ключ = "SITE_WELCOME_BONUS_AMOUNT" Тогда
			ПриветственныйБонус = Число(Значение);
		ИначеЕсли Ключ = "SITE_BONUS_MAX_PCT" Тогда
			МаксимумБонусами = Число(Значение);
		ИначеЕсли Ключ = "SITE_BONUS_MAX_ORDER_SOM" Тогда
			МаксимумБонусамиСом = Число(Значение);
		ИначеЕсли Ключ = "SITE_CHAT_MARKUP_LARGE_PCT" Тогда
			НаценкаКрупная = Число(Значение);
		ИначеЕсли Ключ = "SITE_CHAT_MARKUP_SMALL_PCT" Тогда
			НаценкаМелкая = Число(Значение);
		ИначеЕсли Ключ = "SITE_WA_BOT" Тогда
			РоботВотсАп = (Значение = "1");
		ИначеЕсли Ключ = "SITE_WA_DELAY_MIN" Тогда
			РоботЖдатьМинут = Число(Значение);
		ИначеЕсли Ключ = "SITE_GUEST_CHECKOUT" Тогда
			ЗаказБезВхода = (Значение = "1");
		КонецЕсли;
	КонецЦикла;
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Значения = Новый Соответствие;
	Значения.Вставить("SITE_WELCOME_BONUS_AMOUNT", Формат(ПриветственныйБонус, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_BONUS_MAX_PCT", Формат(МаксимумБонусами, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_BONUS_MAX_ORDER_SOM", Формат(МаксимумБонусамиСом, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_GUEST_CHECKOUT", ?(ЗаказБезВхода, "1", "0"));
	Значения.Вставить("SITE_WA_BOT", ?(РоботВотсАп, "1", "0"));
	Значения.Вставить("SITE_WA_DELAY_MIN", Формат(РоботЖдатьМинут, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_CHAT_MARKUP_LARGE_PCT", Формат(НаценкаКрупная, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_CHAT_MARKUP_SMALL_PCT", Формат(НаценкаМелкая, "ЧН=0; ЧГ=; ЧДЦ=0"));

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.СохранитьНастройкиСайта(Значения, Ошибка);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		Возврат;
	КонецЕсли;
	Состояние = "Настройки сохранены " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ". Сайт применяет их сразу.";
	ЗагрузитьНастройки();

	// Знания отправляем, только если они были загружены: иначе пустое поле
	// затёрло бы на сервере текст, который просто не успел прийти.
	Если ЗнанияЗагружены Тогда
		Если ИМ_ЗаказыСайтаСервер.СохранитьЗнанияДляЧата(ЗнанияДляЧата, Ошибка) Тогда
			Состояние = Состояние + " Знания для чата сохранены — чат начнёт отвечать по ним в течение 10 минут.";
		Иначе
			Состояние = Состояние + " " + Ошибка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗнания()

	Ошибка = "";
	Текст = ИМ_ЗаказыСайтаСервер.ЗнанияДляЧата(Ошибка);
	ЗнанияЗагружены = (Текст <> Неопределено);
	Если ЗнанияЗагружены Тогда
		ЗнанияДляЧата = Текст;
	ИначеЕсли ПустаяСтрока(Состояние) Тогда
		Состояние = Ошибка;
	КонецЕсли;
	Элементы.ЗнанияДляЧата.ТолькоПросмотр = НЕ ЗнанияЗагружены;
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеОтветаСервера

// Сервер может не ответить разделом или прислать null — это не повод падать.

&НаСервереБезКонтекста
Функция Раздел(Данные, Ключ)

	Значение = Данные.Получить(Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);

КонецФункции

&НаСервереБезКонтекста
Функция МассивИз(Данные, Ключ)

	Значение = Данные.Получить(Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Массив"), Значение, Новый Массив);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИз(Контейнер, Ключ)

	Значение = Контейнер.Получить(Ключ);
	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ЦелоеИз(Контейнер, Ключ)

	Возврат Цел(ЧислоИз(Контейнер, Ключ));

КонецФункции

&НаСервереБезКонтекста
Функция СтрокаИз(Контейнер, Ключ)

	Значение = Контейнер.Получить(Ключ);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// "2026-09-18T12:06:21.356535" → дата 1С. Пусто или мусор — пустая дата, без исключения.
&НаСервереБезКонтекста
Функция ДатаИзISO(Значение)

	Если Значение = Неопределено Тогда
		Возврат '00010101';
	КонецЕсли;
	Текст = СтрЗаменить(Строка(Значение), "T", " ");
	Текст = Лев(Текст, 19);
	Попытка
		Части = СтрРазделить(Текст, " -:", Ложь);
		Если Части.Количество() < 6 Тогда
			Возврат '00010101';
		КонецЕсли;
		Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]),
			Число(Части[3]), Число(Части[4]), Число(Части[5]));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// «2026-09-24» — день, который прислал сервер. Он уже бишкекский, переводить не надо.
&НаСервереБезКонтекста
Функция ДеньИзISO(Значение)

	Возврат ДатаИзISO(Лев(Строка(Значение), 10) + "T00:00:00");

КонецФункции

// Сервер живёт по всемирному времени, владелец — по бишкекскому.
// Без перевода «обновлён 06:42» вместо 12:42 читается как «сайт завис».
&НаСервереБезКонтекста
Функция МестнаяДатаИзISO(Значение)

	Дата = ДатаИзISO(Значение);
	Возврат ?(Дата = '00010101', Дата, МестноеВремя(Дата));

КонецФункции

// Старый сервер не знает про период. Чтобы панель всё равно открылась,
// собираем из его ответа то же, что прислал бы новый, — за сегодня.
&НаСервереБезКонтекста
Функция ПериодИзСтарогоОтвета(Данные)

	Заказы     = Раздел(Данные, "orders");
	Визиты     = Раздел(Данные, "visits");
	Покупатели = Раздел(Данные, "customers");

	Итоги = Новый Соответствие;
	Итоги.Вставить("people", ЧислоИз(Визиты, "peopleToday"));
	Итоги.Вставить("views", ЧислоИз(Визиты, "viewsToday"));
	Итоги.Вставить("orders", ЧислоИз(Заказы, "today"));
	Итоги.Вставить("money", ЧислоИз(Заказы, "paidToday"));
	Итоги.Вставить("newCustomers", ЧислоИз(Покупатели, "newToday"));
	Итоги.Вставить("logins", ЧислоИз(Покупатели, "loginsToday"));

	Статусы = Новый Соответствие;
	Для Каждого Ключ Из СтрРазделить("awaitingPayment,paidWaiting1C,shipped,awaitingShipment,failed,cancelled", ",") Цикл
		Статусы.Вставить(Ключ, ЧислоИз(Заказы, Ключ));
	КонецЦикла;

	Сегодня = Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd");
	Результат = Новый Соответствие;
	Результат.Вставить("from", Сегодня);
	Результат.Вставить("to", Сегодня);
	Результат.Вставить("stats", Итоги);
	Результат.Вставить("statuses", Статусы);
	Результат.Вставить("orders", МассивИз(Данные, "recentOrders"));
	Результат.Вставить("ordersFound", ЧислоИз(Заказы, "total"));
	Возврат Результат;

КонецФункции

