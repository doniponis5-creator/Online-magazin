// Путь покупателя: сколько людей дошло до каждого шага. Где полоса резко
// короче — там люди уходят, туда и смотреть.
&НаСервереБезКонтекста
Функция ПутьПокупателя(Итоги)

	Люди = ЧислоИз(Итоги, "people");
	Шаги = Новый Массив;
	Шаги.Добавить(Новый Структура("Название, Значение", "Зашли на сайт", Люди));
	Шаги.Добавить(Новый Структура("Название, Значение", "Смотрели товары", ЧислоИз(Итоги, "productPeople")));
	Шаги.Добавить(Новый Структура("Название, Значение", "Открыли корзину", ЧислоИз(Итоги, "cartPeople")));
	Шаги.Добавить(Новый Структура("Название, Значение", "Начали оформление", ЧислоИз(Итоги, "checkoutPeople")));
	Шаги.Добавить(Новый Структура("Название, Значение", "Сделали заказ", ЧислоИз(Итоги, "orders")));
	Шаги.Добавить(Новый Структура("Название, Значение", "Оплатили", ЧислоИз(Итоги, "sales")));

	Если Люди = 0 Тогда
		Возврат "<div class='note'>За период на сайт никто не заходил.</div>";
	КонецЕсли;

	Части = Новый Массив;
	Для Индекс = 0 По Шаги.ВГраница() Цикл
		Шаг = Шаги[Индекс];
		Доля = Мин(100, Шаг.Значение / Люди * 100);
		Процент = ?(Индекс = 0, "", "<small>" + Ч(Доля) + "%</small>");
		Части.Добавить("<div class='fun'><div class='fl'><span class='n'>" + Э(Шаг.Название) + "</span>"
			+ "<span class='v'>" + Ч(Шаг.Значение) + Процент + "</span></div>"
			+ "<div class='fb'><i style='width:" + К(Доля) + "%'></i></div></div>");
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

