// «было 31 · ▲ 84%»: зелёным — стало больше, красным — меньше.
&НаСервереБезКонтекста
Функция Изменение(Сейчас, Прежде, Единица = "")

	Было = Ч(Прежде) + ?(ПустаяСтрока(Единица), "", " " + Единица);
	Если Прежде = 0 И Сейчас = 0 Тогда
		Знак = "<span class='same'>без изменений</span>";
	ИначеЕсли Прежде = 0 Тогда
		Знак = "<span class='up'>&#9650; с нуля</span>";
	Иначе
		Процент = Окр((Сейчас - Прежде) / Прежде * 100);
		Если Процент > 0 Тогда
			Знак = "<span class='up'>&#9650; " + Ч(Процент) + "%</span>";
		ИначеЕсли Процент < 0 Тогда
			Знак = "<span class='down'>&#9660; " + Ч(-Процент) + "%</span>";
		Иначе
			Знак = "<span class='same'>столько же</span>";
		КонецЕсли;
	КонецЕсли;
	Возврат "было " + Э(Было) + " · " + Знак;

