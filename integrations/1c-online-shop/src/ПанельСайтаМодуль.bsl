// Столбики по дням с числом над каждым. Дни вне выбранного периода — серые,
// сегодняшний — светлее: день ещё не кончился. Суббота и воскресенье
// подписаны красным — так виден недельный ритм магазина.
&НаСервереБезКонтекста
Функция График(Дни, Ключ, Цвет, ЦветСегодня, Деньги = Ложь)

	Количество = Дни.Количество();
	Если Количество = 0 Тогда
		Возврат "<div class='note'>Сервер пока не присылает историю по дням.</div>";
	КонецЕсли;

	Максимум = 0;
	Для Каждого День Из Дни Цикл
		Если ТипЗнч(День) = Тип("Соответствие") Тогда
			Максимум = Макс(Максимум, ЧислоИз(День, Ключ));
		КонецЕсли;
	КонецЦикла;

	ВысотаПоля = 100;
	ВсеЧисла = (Количество <= 31);
	// Под каждым столбиком число месяца, пока влезает; дальше — через шаг.
	ШагДат = ?(Количество <= 16, 1, Цел((Количество + 7) / 8));
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Последний = Количество - 1;
	ЕстьВнеПериода = Ложь;

	Части = Новый Массив;
	Части.Добавить("<table class='bars'><tr>");
	Для Индекс = 0 По Последний Цикл
		День = Дни[Индекс];
		Если ТипЗнч(День) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЧислоИз(День, Ключ);
		Дата = ДеньИзISO(СтрокаИз(День, "day"));
		ВПериоде = (День.Получить("inPeriod") <> Ложь);
		ЕстьВнеПериода = ЕстьВнеПериода ИЛИ НЕ ВПериоде;

		Высота = ?(Максимум = 0, 0, Окр(Значение / Максимум * ВысотаПоля));
		Если Значение > 0 И Высота < 2 Тогда
			Высота = 2;
		КонецЕсли;
		Если НЕ ВПериоде Тогда
			Заливка = "#d5dbe3";
		ИначеЕсли Дата = Сегодня Тогда
			Заливка = ЦветСегодня;
		Иначе
			Заливка = Цвет;
		КонецЕсли;
		Надпись = ?(Деньги, Коротко(Значение), Ч(Значение));
		Подсказка = ДеньНеделиКратко(Дата) + " " + Формат(Дата, "ДФ=dd.MM.yyyy") + " — "
			+ Ч(Значение) + ?(Деньги, " сом", "") + ?(Дата = Сегодня, " (день ещё идёт)", "");

		Ячейка = "<td title='" + Э(Подсказка) + "'><div class='bar'>";
		Если Высота > 0 Тогда
			Ячейка = Ячейка + "<i style='height:" + К(Высота) + "px;background:" + Заливка + "'></i>";
			Если ВсеЧисла ИЛИ Значение = Максимум Тогда
				Ячейка = Ячейка + "<span class='bv' style='bottom:" + К(Высота + 18) + "px'>" + Э(Надпись) + "</span>";
			КонецЕсли;
		КонецЕсли;
		ОтКонца = Последний - Индекс;
		Подпись = ?(ОтКонца - Цел(ОтКонца / ШагДат) * ШагДат = 0, Формат(Дата, "ДФ=dd"), "");
		КлассДаты = ?(ДеньНедели(Дата) >= 6, "bd we", "bd");
		Ячейка = Ячейка + "<span class='" + КлассДаты + "'>" + Подпись + "</span></div></td>";
		Части.Добавить(Ячейка);
	КонецЦикла;
	Части.Добавить("</tr></table>");

	Первый = ДеньИзISO(СтрокаИз(Дни[0], "day"));
	ПоследнийДень = ДеньИзISO(СтрокаИз(Дни[Последний], "day"));
	Легенда = Формат(Первый, "ДФ=dd.MM") + " — " + Формат(ПоследнийДень, "ДФ=dd.MM");
	Если ЕстьВнеПериода Тогда
		Легенда = Легенда + "<i style='background:" + Цвет + "'></i>выбранный период"
			+ "<i style='background:#d5dbe3'></i>для сравнения";
	КонецЕсли;
	Части.Добавить("<div class='legend'>" + Легенда + "</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

