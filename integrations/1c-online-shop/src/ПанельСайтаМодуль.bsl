// Панель сайта (расширение ИМ_ОнлайнМагазин): сводка по магазину и настройки сайта.
// Владелец смотрит и меняет всё отсюда, на сервер заходить не нужно.
// Сводка и настройки живут на сервере SBonus; здесь только показ и отправка.
//
// Сверху — период: сегодня, вчера, 7 дней, месяц или свои даты «с» и «по».
// Все цифры сводки считаются за этот период и сравниваются с прошлым таким же:
// «вчера» — с тем же днём неделю назад, «30 дней» — с предыдущими 30 днями.
//
// Четыре вкладки. «Сводка» — HTML-панель: плитки, графики по дням, карточки разделов,
// список заказов; HTML собирается здесь целиком, без интернета и внешних библиотек.
// «Склад и сайт» — таблица товаров, у которых склад и сайт не совпадают; считается
// прямо по 1С, двойной щелчок открывает карточку товара. «Настройки сайта» — поля.
// «Уведомления» — «на этот товар скидка» / «этот товар поступил» покупателям в
// приложение, по шаблону и только кнопкой; там же — пост этого товара в Instagram
// (картинку в оформлении smarket.kg рисует сайт, публикует сервер).
// «Баннеры» — картинки дизайнера на главной сайта: порядок, ссылка, даты (07.10).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период = "Сегодня";
	ОтборЗаказов = "Все заказы";
	ПоказатьРасхождения = "Все";
	УстановитьДатыПериода();
	ОбновитьВсёНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ПериодПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ДатаПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборЗаказовПриИзменении(Элемент)

	ЗагрузитьСводку();

КонецПроцедуры

// В сводке строка «Склад и сайт не совпадают» — ссылка на вкладку со списком.
&НаКлиенте
Процедура СводкаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Ссылка = "";
	Если ДанныеСобытия.Свойство("Href") И ДанныеСобытия.Href <> Неопределено Тогда
		Ссылка = Строка(ДанныеСобытия.Href);
	КонецЕсли;
	Если СтрНайти(Ссылка, "#sklad") > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСклад;
	КонецЕсли;

КонецПроцедуры

// Уведомления грузим, только когда вкладку открыли: панель не ждёт лишних запросов к серверу.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаУведомления И НЕ УведомленияЗагружены Тогда
		ЗагрузитьУведомленияНаСервере();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаБаннеры И НЕ БаннерыЗагружены Тогда
		ЗагрузитьБаннерыНаСервере();
		ВыделитьБаннер(0);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТоварыПриИзменении(Элемент)

	Элементы.ТоварыУведомлений.ОтборСтрок = ОтборТоваровУведомлений(ПоказатьТовары);
	// Смотрят скидки — значит, и шаблон «Скидка»; смотрят новинки — «Новинка».
	Если ПоказатьТовары = "Со скидкой" И Шаблон <> "Скидка" Тогда
		Шаблон = "Скидка";
		ВыбратьТоварУведомления(Элементы.ТоварыУведомлений.ТекущиеДанные);
		ОбновитьВидУведомленияНаСервере();
	ИначеЕсли ПоказатьТовары = "Новинки" И Шаблон <> "Новинка" Тогда
		Шаблон = "Новинка";
		ВыбратьТоварУведомления(Элементы.ТоварыУведомлений.ТекущиеДанные);
		ОбновитьВидУведомленияНаСервере();
	КонецЕсли;

КонецПроцедуры

// Строку выбирают щелчком или стрелками. Ждём долю секунды: при листании
// стрелками сервер не нужно спрашивать про каждую строку, мимо которой прошли.
&НаКлиенте
Процедура ТоварыУведомленийПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ТоварУведомленияВыбран", 0.3, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ТоварУведомленияВыбран()

	Данные = Элементы.ТоварыУведомлений.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ Данные.Код = КодТовараУведомления Тогда
		Возврат;
	КонецЕсли;
	ВыбратьТоварУведомления(Данные);
	ОбновитьВидУведомленияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ШаблонПриИзменении(Элемент)

	Если Шаблон = "Свой текст" Тогда
		// Свой текст — для объявлений без товара: поля пустые, нажатие откроет главную.
		ВыбратьТоварУведомления(Неопределено);
		ЗаголовокУведомления = "";
		ТекстУведомления = "";
	Иначе
		ВыбратьТоварУведомления(Элементы.ТоварыУведомлений.ТекущиеДанные);
	КонецЕсли;
	ОбновитьВидУведомленияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ТекстУведомленияПриИзменении(Элемент)

	ОбновитьВидУведомленияНаСервере();

КонецПроцедуры

// Пост в Instagram спрашиваем у сервера, только когда открыли его вкладку:
// кто шлёт одни уведомления, лишних запросов не ждёт.
&НаКлиенте
Процедура СтраницыКаналаПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница = Элементы.СтраницаИнстаграм Тогда
		ОбновитьВидПостаНаСервере();
	КонецЕсли;

КонецПроцедуры

// Пост в ленту или история: у истории подписи нет — всё на картинке, поле текста прячем.
&НаКлиенте
Процедура ВидПубликацииПриИзменении(Элемент)

	ОбновитьВидПостаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПодписьПостаПриИзменении(Элемент)

	ОбновитьВидПостаНаСервере();

КонецПроцедуры

// Двойной щелчок по строке поста — открыть пост в Instagram; не вышел — показать почему.
&НаКлиенте
Процедура РассылкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Данные = Элементы.Рассылки.ТекущиеДанные;
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если НЕ ПустаяСтрока(Данные.Ссылка) Тогда
		НачатьЗапускПриложения(Новый ОписаниеОповещения, Данные.Ссылка);
	Иначе
		ПоказатьПредупреждение(, Данные.Шаблон + ": " + Данные.Заголовок + Символы.ПС + Данные.Итог, , "Рассылки");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРасхожденияПриИзменении(Элемент)

	Элементы.Расхождения.ОтборСтрок = ОтборРасхождений(ПоказатьРасхождения);

КонецПроцедуры

// ВыбраннаяСтрока здесь не всегда номер строки: при быстром двойном щелчке 1С
// присылает и другое, и поиск строки по нему падал «Несоответствие типов».
// Поэтому карточку открываем по текущей строке таблицы — она всегда та, по которой щёлкнули.
&НаКлиенте
Процедура РасхожденияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьКарточкуТекущейСтроки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьВсёНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуРасхождения(Команда)

	ОткрытьКарточкуТекущейСтроки();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСайт(Команда)

	НачатьЗапускПриложения(Новый ОписаниеОповещения, "https://smarket.kg");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУведомления(Команда)

	ЗагрузитьУведомленияНаСервере();

КонецПроцедуры

// Перед вопросом «Отправить?» ещё раз спрашиваем сервер: за минуту, пока владелец
// правил текст, могло наступить 20:00 или кто-то отключил уведомления.
&НаКлиенте
Процедура ОтправитьУведомлениеКоманда(Команда)

	ОбновитьВидУведомленияНаСервере();
	Если НЕ ПустаяСтрока(ПричинаНельзя) Тогда
		ПоказатьПредупреждение(, "Отправить нельзя. " + ПричинаНельзя, , "Уведомление");
		Возврат;
	КонецЕсли;
	Вопрос = "Отправить уведомление " + Формат(Получателей, "ЧН=0; ЧГ=") + " " + Покупателям(Получателей) + "?"
		+ Символы.ПС + Символы.ПС + ЗаголовокУведомления + Символы.ПС + ТекстУведомления
		+ Символы.ПС + Символы.ПС + "Следующее уведомление можно будет отправить только завтра.";
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбОтправке", ЭтотОбъект), Вопрос,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Уведомление");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОбОтправке(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Итог = ОтправитьУведомлениеНаСервере();
	ПоказатьПредупреждение(, Итог.Текст, , "Уведомление");
	Если Итог.Отправлено Тогда
		// Сервер шлёт в фоне. Через несколько секунд сами заберём, сколько дошло.
		ЖдёмИтогаРассылки = 12;
		ПодключитьОбработчикОжидания("ПроверитьИтогРассылки", 5, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИтогРассылки()

	ЖдёмИтогаРассылки = ЖдёмИтогаРассылки - 1;
	Если ЗагрузитьРассылки() И ЖдёмИтогаРассылки > 0 Тогда
		ПодключитьОбработчикОжидания("ПроверитьИтогРассылки", 5, Истина);
	КонецЕсли;

КонецПроцедуры

// Как и с уведомлением: перед вопросом ещё раз спрашиваем сервер — товар мог
// кончиться, а пост с ним сегодня уже могли выпустить.
&НаКлиенте
Процедура ОпубликоватьВИнстаграм(Команда)

	ОбновитьВидПостаНаСервере();
	Если НЕ ПустаяСтрока(ПричинаНельзяПост) Тогда
		ПоказатьПредупреждение(, "Опубликовать нельзя. " + ПричинаНельзяПост, , "Instagram");
		Возврат;
	КонецЕсли;
	Если ВидПубликации = "Скидки недели (карусель)" Тогда
		Вопрос = "Опубликовать карусель «Скидки недели» в Instagram магазина?" + Символы.ПС + Символы.ПС
			+ "В неё войдут все товары со скидкой и фото (до 9), самые большие скидки первыми. "
			+ "Её сразу увидят все подписчики.";
	ИначеЕсли ВидПубликации = "История" Тогда
		Вопрос = "Опубликовать историю в Instagram магазина?" + Символы.ПС + Символы.ПС + ТоварУведомления
			+ Символы.ПС + Символы.ПС + "История висит 24 часа. Ответы на неё придут в Direct — робот знает этот товар.";
	Иначе
		Вопрос = "Опубликовать пост в Instagram магазина?" + Символы.ПС + Символы.ПС + ТоварУведомления
			+ Символы.ПС + Символы.ПС + "Его сразу увидят все подписчики. Удалить пост потом можно только в самом Instagram.";
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОПосте", ЭтотОбъект), Вопрос,
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет, "Instagram");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОПосте(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Итог = ОпубликоватьПостНаСервере();
	ПоказатьПредупреждение(, Итог.Текст, , "Instagram");
	Если Итог.Начато Тогда
		// Instagram обрабатывает картинку обычно 10–30 секунд, бывает до трёх минут. Сами заберём, чем кончилось.
		ЖдёмИтогаРассылки = 30;
		ПодключитьОбработчикОжидания("ПроверитьИтогРассылки", 8, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Карточка товара — та же, что в списке «Онлайн магазин»: там цена сайта и
// «Наличие на сайте». Закрыли карточку — список и сводка пересчитываются.
&НаКлиенте
Процедура ОткрытьКарточкуТекущейСтроки()

	Данные = Элементы.Расхождения.ТекущиеДанные;
	Если Данные = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Данные.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияКарточки", ЭтотОбъект);
	ОткрытьФорму("Обработка.ИМ_ОнлайнМагазин.Форма.КарточкаТовара",
		Новый Структура("Номенклатура", Данные.Номенклатура), ЭтотОбъект, Данные.Номенклатура, , ,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияКарточки(Результат, ДополнительныеПараметры) Экспорт

	ПослеЗакрытияКарточкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПослеЗакрытияКарточкиНаСервере()

	ЗагрузитьРасхождения();
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервере
Процедура ОбновитьВсёНаСервере()

	ЗагрузитьРасхождения();
	ЗагрузитьСводку();
	ЗагрузитьНастройки();
	ЗагрузитьЗнания();
	Если УведомленияЗагружены Тогда
		ЗагрузитьУведомленияНаСервере();
	КонецЕсли;

КонецПроцедуры

// Готовый период («Вчера», «7 дней»…) сам ставит даты «с» и «по».
&НаСервере
Процедура УстановитьДатыПериода()

	Если ПустаяСтрока(Период) Тогда
		Период = "Сегодня";
	КонецЕсли;
	Даты = ДатыПериода(Период, НачалоДня(ТекущаяДатаСеанса()));
	ДатаС = Даты.Начало;
	ДатаПо = Даты.Конец;

КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()

	// «Свой период» — даты не трогаем: владелец сейчас впишет их сам.
	Если Период <> "Свой период" Тогда
		УстановитьДатыПериода();
	КонецЕсли;
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()

	Если НЕ ЗначениеЗаполнено(ДатаПо) Тогда
		ДатаПо = ?(ЗначениеЗаполнено(ДатаС), ДатаС, НачалоДня(ТекущаяДатаСеанса()));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
		ДатаС = ДатаПо;
	КонецЕсли;
	Если ДатаС > ДатаПо Тогда
		Обмен = ДатаС;
		ДатаС = ДатаПо;
		ДатаПо = Обмен;
	КонецЕсли;
	ДатаС = НачалоДня(ДатаС);
	ДатаПо = НачалоДня(ДатаПо);
	// Даты совпали с готовым периодом — так и назовём: «Вчера» понятнее двух дат.
	Период = ПериодПоДатам(ДатаС, ДатаПо);
	ЗагрузитьСводку();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ГотовыеПериоды()

	Возврат СтрРазделить("Сегодня,Вчера,7 дней,30 дней,Этот месяц,Прошлый месяц", ",");

КонецФункции

&НаСервереБезКонтекста
Функция ДатыПериода(Имя, Сегодня)

	Если Имя = "Вчера" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 86400, Сегодня - 86400);
	ИначеЕсли Имя = "7 дней" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 6 * 86400, Сегодня);
	ИначеЕсли Имя = "30 дней" Тогда
		Возврат Новый Структура("Начало, Конец", Сегодня - 29 * 86400, Сегодня);
	ИначеЕсли Имя = "Этот месяц" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоМесяца(Сегодня), Сегодня);
	ИначеЕсли Имя = "Прошлый месяц" Тогда
		Прошлый = ДобавитьМесяц(НачалоМесяца(Сегодня), -1);
		Возврат Новый Структура("Начало, Конец", Прошлый, НачалоДня(КонецМесяца(Прошлый)));
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", Сегодня, Сегодня);

КонецФункции

&НаСервереБезКонтекста
Функция ПериодПоДатам(Начало, Конец)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Для Каждого Имя Из ГотовыеПериоды() Цикл
		Даты = ДатыПериода(Имя, Сегодня);
		Если Даты.Начало = Начало И Даты.Конец = Конец Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "Свой период";

КонецФункции

// Какие заказы перечислить в таблице внизу: слово на форме → ключ для сервера.
&НаСервереБезКонтекста
Функция КлючОтбора(Отбор)

	Если Отбор = "Продажи" Тогда
		Возврат "sales";
	ИначеЕсли Отбор = "Ждут оплаты" Тогда
		Возврат "awaiting";
	ИначеЕсли Отбор = "Не оплатили" Тогда
		Возврат "abandoned";
	ИначеЕсли Отбор = "Оплачены, не отгружены" Тогда
		Возврат "unshipped";
	ИначеЕсли Отбор = "Отменены" Тогда
		Возврат "cancelled";
	КонецЕсли;
	Возврат "all";

КонецФункции

// Склад и сайт не совпадают: таблица на вкладке, счётчики — для строки в сводке.
&НаСервере
Процедура ЗагрузитьРасхождения()

	Расхождения.Очистить();
	СкладБезОстатка = 0;
	СкладБезЦены = 0;
	СкладНетВНаличии = 0;
	СкладПредзаказ = 0;
	Для Каждого Найдено Из ИМ_ЗаказыСайтаСервер.РасхожденияСкладаИСайта() Цикл
		Строка = Расхождения.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Найдено);
		Если Найдено.Проблема = "Продаётся без остатка" Тогда
			СкладБезОстатка = СкладБезОстатка + 1;
			Строка.Порядок = 1;
		ИначеЕсли Найдено.Проблема = "Нет цены на сайте" Тогда
			СкладБезЦены = СкладБезЦены + 1;
			Строка.Порядок = 2;
		ИначеЕсли Найдено.Проблема = "Предзаказ, а товар пришёл" Тогда
			СкладПредзаказ = СкладПредзаказ + 1;
			Строка.Порядок = 4;
		Иначе
			СкладНетВНаличии = СкладНетВНаличии + 1;
			Строка.Порядок = 3;
		КонецЕсли;
	КонецЦикла;
	// Сначала то, что опаснее: продаётся без остатка; внутри — дорогие и многочисленные выше.
	Расхождения.Сортировать("Порядок, ЦенаСайта Убыв, Остаток Убыв");

	Всего = Расхождения.Количество();
	Элементы.СтраницаСклад.Заголовок = ?(Всего = 0, "Склад и сайт", "Склад и сайт (" + Формат(Всего, "ЧГ=0") + ")");
	Если Всего = 0 Тогда
		ИтогСклад = "Всё сходится: что на сайте «в наличии», то есть на складе.";
	Иначе
		ИтогСклад = "Продаётся без остатка: " + Формат(СкладБезОстатка, "ЧН=0; ЧГ=0")
			+ " · нет цены на сайте: " + Формат(СкладБезЦены, "ЧН=0; ЧГ=0")
			+ " · «нет в наличии» при остатке: " + Формат(СкладНетВНаличии, "ЧН=0; ЧГ=0")
			+ " · предзаказ, а товар пришёл: " + Формат(СкладПредзаказ, "ЧН=0; ЧГ=0")
			+ ". Двойной щелчок по строке — карточка товара: там цена сайта и «Наличие на сайте».";
	КонецЕсли;
	Элементы.Расхождения.ОтборСтрок = ОтборРасхождений(ПоказатьРасхождения);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОтборРасхождений(Показать)

	Если ПустаяСтрока(Показать) ИЛИ Показать = "Все" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый ФиксированнаяСтруктура("Проблема", Показать);

КонецФункции

&НаСервере
Процедура ЗагрузитьСводку()

	Если НЕ ЗначениеЗаполнено(ДатаС) ИЛИ НЕ ЗначениеЗаполнено(ДатаПо) Тогда
		УстановитьДатыПериода();
	КонецЕсли;
	Если ПустаяСтрока(ОтборЗаказов) Тогда
		ОтборЗаказов = "Все заказы";
	КонецЕсли;

	Ошибка = "";
	Отбор = Новый Структура("ДатаС, ДатаПо, Заказы", ДатаС, ДатаПо, КлючОтбора(ОтборЗаказов));
	Данные = ИМ_ЗаказыСайтаСервер.СводкаСайта(Ошибка, Отбор);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		ТекстHTML = ПанельОшибки(Ошибка);
		Возврат;
	КонецЕсли;

	Склад = Новый Структура("БезОстатка, БезЦены, НетВНаличии, Предзаказ",
		СкладБезОстатка, СкладБезЦены, СкладНетВНаличии, СкладПредзаказ);
	ТекстHTML = ТекстПанели(Данные, Период, ОтборЗаказов, Склад);

	Заказы  = Раздел(Данные, "orders");
	Каталог = Раздел(Данные, "catalog");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	Ошибки1С       = ЦелоеИз(Заказы, "failed");

	Состояние = "Обновлено " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ".";
	Если ТипЗнч(Данные.Получить("period")) <> Тип("Соответствие") Тогда
		Состояние = Состояние + " Сервер ещё старый: даты «с» и «по» заработают после его обновления.";
	КонецЕсли;
	Если ГотовыКПродаже = 0 Тогда
		Состояние = Состояние + " Внимание: купить на сайте нечего — ни у одного товара нет и цены, и остатка.";
	КонецЕсли;
	Если Ошибки1С > 0 Тогда
		Состояние = Состояние + " Заказов с ошибкой загрузки в 1С: " + Формат(Ошибки1С, "ЧН=0; ЧГ=") + ".";
	КонецЕсли;
	Если СкладБезОстатка > 0 Тогда
		Состояние = Состояние + " На сайте «В наличии», а на складе 0: " + Формат(СкладБезОстатка, "ЧН=0; ЧГ=")
			+ " товар(ов) — вкладка «Склад и сайт».";
	КонецЕсли;
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Состояние = Состояние + " Оплачено, но не отгружено: " + Формат(ЖдутОтгрузки, "ЧН=0; ЧГ=")
			+ " — товара не было на складе, надо привезти и отгрузить.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.НастройкиСайта(Ошибка);
	Если Данные = Неопределено Тогда
		Если ПустаяСтрока(Состояние) Тогда
			Состояние = Ошибка;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Список = Данные.Получить("settings");
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЕстьНастройкаИнстаграм = Ложь;
	ЕстьНастройкаАвтоИстории = Ложь;
	ЕстьНастройкаВсеТовары = Ложь;
	Для Каждого Настройка Из Список Цикл
		Ключ = Строка(Настройка.Получить("key"));
		Значение = Строка(Настройка.Получить("value"));
		Если Ключ = "SITE_WELCOME_BONUS_AMOUNT" Тогда
			ПриветственныйБонус = Число(Значение);
		ИначеЕсли Ключ = "SITE_BONUS_MAX_PCT" Тогда
			МаксимумБонусами = Число(Значение);
		ИначеЕсли Ключ = "SITE_BONUS_MAX_ORDER_SOM" Тогда
			МаксимумБонусамиСом = Число(Значение);
		ИначеЕсли Ключ = "SITE_CHAT_MARKUP_LARGE_PCT" Тогда
			НаценкаКрупная = Число(Значение);
		ИначеЕсли Ключ = "SITE_CHAT_MARKUP_SMALL_PCT" Тогда
			НаценкаМелкая = Число(Значение);
		ИначеЕсли Ключ = "SITE_WA_BOT" Тогда
			РоботВотсАп = (Значение = "1");
		ИначеЕсли Ключ = "SITE_WA_DELAY_MIN" Тогда
			РоботЖдатьМинут = Число(Значение);
		ИначеЕсли Ключ = "SITE_IG_BOT" Тогда
			РоботИнстаграм = (Значение = "1");
			ЕстьНастройкаИнстаграм = Истина;
		ИначеЕсли Ключ = "SITE_IG_AUTO_STORY" Тогда
			АвтоИсторияИнстаграм = (Значение = "1");
			ЕстьНастройкаАвтоИстории = Истина;
		ИначеЕсли Ключ = "SITE_IG_AUTO_ALL" Тогда
			ВсеТоварыИнстаграм = (Значение = "1");
			ЕстьНастройкаВсеТовары = Истина;
		ИначеЕсли Ключ = "SITE_GUEST_CHECKOUT" Тогда
			ЗаказБезВхода = (Значение = "1");
		КонецЕсли;
	КонецЦикла;
	// Сервер ещё старый (не знает SITE_IG_BOT) — галочку не показываем: она бы ничего не сохраняла.
	Элементы.РоботИнстаграм.Видимость = ЕстьНастройкаИнстаграм;
	Элементы.АвтоИсторияИнстаграм.Видимость = ЕстьНастройкаАвтоИстории;
	Элементы.ВсеТоварыИнстаграм.Видимость = ЕстьНастройкаВсеТовары;
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Значения = Новый Соответствие;
	Значения.Вставить("SITE_WELCOME_BONUS_AMOUNT", Формат(ПриветственныйБонус, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_BONUS_MAX_PCT", Формат(МаксимумБонусами, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_BONUS_MAX_ORDER_SOM", Формат(МаксимумБонусамиСом, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_GUEST_CHECKOUT", ?(ЗаказБезВхода, "1", "0"));
	Значения.Вставить("SITE_WA_BOT", ?(РоботВотсАп, "1", "0"));
	Значения.Вставить("SITE_WA_DELAY_MIN", Формат(РоботЖдатьМинут, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Если ЕстьНастройкаИнстаграм Тогда
		// Старый сервер не знает SITE_IG_BOT и отклонил бы всё сохранение — шлём, только если сервер её прислал.
		Значения.Вставить("SITE_IG_BOT", ?(РоботИнстаграм, "1", "0"));
	КонецЕсли;
	Если ЕстьНастройкаАвтоИстории Тогда
		Значения.Вставить("SITE_IG_AUTO_STORY", ?(АвтоИсторияИнстаграм, "1", "0"));
	КонецЕсли;
	Если ЕстьНастройкаВсеТовары Тогда
		Значения.Вставить("SITE_IG_AUTO_ALL", ?(ВсеТоварыИнстаграм, "1", "0"));
	КонецЕсли;
	Значения.Вставить("SITE_CHAT_MARKUP_LARGE_PCT", Формат(НаценкаКрупная, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_CHAT_MARKUP_SMALL_PCT", Формат(НаценкаМелкая, "ЧН=0; ЧГ=; ЧДЦ=0"));

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.СохранитьНастройкиСайта(Значения, Ошибка);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		Возврат;
	КонецЕсли;
	Состояние = "Настройки сохранены " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ". Сайт применяет их сразу.";
	ЗагрузитьНастройки();

	// Знания отправляем, только если они были загружены: иначе пустое поле
	// затёрло бы на сервере текст, который просто не успел прийти.
	Если ЗнанияЗагружены Тогда
		Если ИМ_ЗаказыСайтаСервер.СохранитьЗнанияДляЧата(ЗнанияДляЧата, Ошибка) Тогда
			Состояние = Состояние + " Знания для чата сохранены — чат начнёт отвечать по ним в течение 10 минут.";
		Иначе
			Состояние = Состояние + " " + Ошибка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗнания()

	Ошибка = "";
	Текст = ИМ_ЗаказыСайтаСервер.ЗнанияДляЧата(Ошибка);
	ЗнанияЗагружены = (Текст <> Неопределено);
	Если ЗнанияЗагружены Тогда
		ЗнанияДляЧата = Текст;
	ИначеЕсли ПустаяСтрока(Состояние) Тогда
		Состояние = Ошибка;
	КонецЕсли;
	Элементы.ЗнанияДляЧата.ТолькоПросмотр = НЕ ЗнанияЗагружены;
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти

#Область Уведомления

// Вкладка «Уведомления»: «на этот товар скидка» и «этот товар поступил» по готовым
// шаблонам. Не автоматически — только кнопкой «Отправить». Тексты шаблонов и цены
// присылает сервер из каталога 1С; можно ли слать сейчас (днём, раз в день, кому) —
// тоже решает сервер. Здесь — выбор, правка текста и показ.

&НаСервере
Процедура ЗагрузитьУведомленияНаСервере()

	УведомленияЗагружены = Истина;
	ЗагрузитьТоварыУведомлений();
	ЗагрузитьРассылки();
	Если ПустаяСтрока(ПоказатьТовары) Тогда
		// Скидок нет — начинаем с новинок, нет и новинок — со всех товаров.
		Если ТоварыУведомлений.НайтиСтроки(Новый Структура("Скидка", Истина)).Количество() > 0 Тогда
			ПоказатьТовары = "Со скидкой";
		ИначеЕсли ТоварыУведомлений.НайтиСтроки(Новый Структура("Новинка", Истина)).Количество() > 0 Тогда
			ПоказатьТовары = "Новинки";
		Иначе
			ПоказатьТовары = "Все товары";
		КонецЕсли;
		Шаблон = ?(ПоказатьТовары = "Со скидкой", "Скидка", "Новинка");
	КонецЕсли;
	Элементы.ТоварыУведомлений.ОтборСтрок = ОтборТоваровУведомлений(ПоказатьТовары);
	// Выбранный товар мог уйти из каталога — тогда выбора больше нет.
	Если НЕ ПустаяСтрока(КодТовараУведомления)
		И ТоварыУведомлений.НайтиСтроки(Новый Структура("Код", КодТовараУведомления)).Количество() = 0 Тогда
		КодТовараУведомления = "";
		ТоварУведомления = "";
	КонецЕсли;
	ОбновитьВидУведомленияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТоварыУведомлений()

	ТоварыУведомлений.Очистить();
	Ошибка = "";
	КодОтвета = 0;
	Данные = ИМ_ЗаказыСайтаСервер.ТоварыДляУведомлений(Ошибка, КодОтвета);
	Если Данные = Неопределено Тогда
		Состояние = ОшибкаУведомлений(Ошибка, КодОтвета);
		Возврат;
	КонецЕсли;
	Для Каждого Товар Из МассивИз(Данные, "items") Цикл
		Если ТипЗнч(Товар) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ряд = ТоварыУведомлений.Добавить();
		Ряд.Название = СтрокаИз(Товар, "name");
		Ряд.Код = СтрокаИз(Товар, "code");
		Ряд.Цена = ЧислоИз(Товар, "price");
		Ряд.СтараяЦена = ЧислоИз(Товар, "oldPrice");
		Ряд.Скидка = (Товар.Получить("sale") = Истина);
		Ряд.Новинка = (Товар.Получить("isNew") = Истина);
		Метки = Новый Массив;
		Если Ряд.Скидка Тогда
			Метки.Добавить("скидка");
		КонецЕсли;
		Если Ряд.Новинка Тогда
			Метки.Добавить("новинка");
		КонецЕсли;
		Ряд.Метка = СтрСоединить(Метки, ", ");
		Ряд.ЗаголовокСкидка = СтрокаИз(Товар, "saleTitle");
		Ряд.ТекстСкидка = СтрокаИз(Товар, "saleBody");
		Ряд.ЗаголовокНовинка = СтрокаИз(Товар, "newTitle");
		Ряд.ТекстНовинка = СтрокаИз(Товар, "newBody");
	КонецЦикла;

КонецПроцедуры

// Возвращает Истина, пока последняя рассылка ещё отправляется: тогда спросим ещё раз.
&НаСервере
Функция ЗагрузитьРассылки()

	Ошибка = "";
	КодОтвета = 0;
	Данные = ИМ_ЗаказыСайтаСервер.ИсторияУведомлений(Ошибка, КодОтвета);
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Рассылки.Очистить();
	Для Каждого Запись Из МассивИз(Данные, "items") Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Ряд = Рассылки.Добавить();
		Ряд.Когда = МестнаяДатаИзISO(Запись.Получить("at"));
		Ряд.Шаблон = ИмяШаблона(СтрокаИз(Запись, "kind"));
		Ряд.Заголовок = СтрокаИз(Запись, "title");
		Ряд.Получателей = ЦелоеИз(Запись, "recipients");
		Ряд.Доставлено = ЦелоеИз(Запись, "delivered");
		Ряд.Итог = ИтогРассылки(СтрокаИз(Запись, "status"));
	КонецЦикла;
	Идёт = Ложь;
	Если Рассылки.Количество() > 0 Тогда
		Последняя = Рассылки[0];
		Если Последняя.Итог = ИтогРассылки("sending") Тогда
			Состояние = "Уведомление «" + Последняя.Заголовок + "» отправляется: " + Формат(Последняя.Получателей, "ЧН=0; ЧГ=")
				+ " " + Покупателям(Последняя.Получателей) + ".";
			Идёт = Истина;
		ИначеЕсли НачалоДня(Последняя.Когда) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Состояние = "Уведомление «" + Последняя.Заголовок + "»: доставлено " + Формат(Последняя.Доставлено, "ЧН=0; ЧГ=")
				+ " из " + Формат(Последняя.Получателей, "ЧН=0; ЧГ=") + ".";
		КонецЕсли;
	КонецЕсли;
	// Посты в Instagram — в тот же список, по времени. Старый сервер постов не знает (404) — просто без них.
	Если ЗагрузитьПосты() Тогда
		Идёт = Истина;
	КонецЕсли;
	Возврат Идёт;

КонецФункции

// Возвращает Истина, пока последний пост ещё публикуется.
&НаСервере
Функция ЗагрузитьПосты()

	Ошибка = "";
	КодОтвета = 0;
	Данные = ИМ_ЗаказыСайтаСервер.ИсторияПостов(Ошибка, КодОтвета);
	Если Данные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Идёт = Ложь;
	Свежий = Неопределено;
	Для Каждого Запись Из МассивИз(Данные, "items") Цикл
		Если ТипЗнч(Запись) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Статус = СтрокаИз(Запись, "status");
		Ряд = Рассылки.Добавить();
		Ряд.Когда = МестнаяДатаИзISO(Запись.Получить("at"));
		Ряд.Шаблон = КудаПост(СтрокаИз(Запись, "format"), Запись.Получить("auto") = Истина) + ": " + ИмяШаблона(СтрокаИз(Запись, "kind"));
		Ряд.Заголовок = СтрокаИз(Запись, "name");
		Ряд.Итог = ИтогПоста(Статус, СтрокаИз(Запись, "note"));
		Ряд.Ссылка = СтрокаИз(Запись, "link");
		Если Свежий = Неопределено Тогда
			Свежий = Новый Структура("Когда, Заголовок, Итог, Ссылка", Ряд.Когда, Ряд.Заголовок, Ряд.Итог, Ряд.Ссылка);
		КонецЕсли;
		Если Статус = "sending" Тогда
			Идёт = Истина;
		КонецЕсли;
	КонецЦикла;
	Таблица = РеквизитФормыВЗначение("Рассылки");
	Таблица.Сортировать("Когда Убыв");
	ЗначениеВРеквизитФормы(Таблица, "Рассылки");
	// Итог свежего поста — в строку состояния, пока он ещё новость (10 минут).
	Если Свежий <> Неопределено И ТекущаяДатаСеанса() - Свежий.Когда < 600 Тогда
		Если Идёт Тогда
			Состояние = "Пост «" + Свежий.Заголовок + "» публикуется в Instagram…";
		ИначеЕсли НЕ ПустаяСтрока(Свежий.Ссылка) Тогда
			Состояние = "Пост «" + Свежий.Заголовок + "» опубликован в Instagram: " + Свежий.Ссылка;
		Иначе
			Состояние = "Пост «" + Свежий.Заголовок + "» " + Свежий.Итог;
		КонецЕсли;
	КонецЕсли;
	Возврат Идёт;

КонецФункции

// Сервер отвечает, сколько человек получит и почему нельзя слать, — ничего не отправляя.
// По ответу собираем справа, как уведомление увидит покупатель.
&НаСервере
Процедура ОбновитьВидУведомленияНаСервере()

	Ошибка = "";
	КодОтвета = 0;
	Ответ = ИМ_ЗаказыСайтаСервер.ПроверитьУведомление(ДанныеУведомления(), Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Получателей = 0;
		ПричинаНельзя = ОшибкаУведомлений(Ошибка, КодОтвета);
	Иначе
		Получателей = ЦелоеИз(Ответ, "recipients");
		ПричинаНельзя = СтрокаИз(Ответ, "blockedReason");
	КонецЕсли;
	Куда = ?(ПустаяСтрока(КодТовараУведомления), "", ТоварУведомления);
	ВидУведомленияHTML = ВидУведомления(ЗаголовокУведомления, ТекстУведомления, Куда, Получателей, ПричинаНельзя);
	Элементы.КнопкаОтправитьУведомление.Доступность = ПустаяСтрока(ПричинаНельзя);
	// Тот же выбор товара и шаблона — и для поста: вкладка открыта — обновляем сразу, нет — при открытии.
	Если Элементы.СтраницыКанала.ТекущаяСтраница = Элементы.СтраницаИнстаграм Тогда
		ОбновитьВидПостаНаСервере();
	КонецЕсли;

КонецПроцедуры

// Сервер отвечает картинкой поста, текстом по шаблону и тем, можно ли публиковать.
// Текст, который владелец не правил, меняется вместе с товаром; правленный не трогаем,
// пока товар и шаблон те же.
&НаСервере
Процедура ОбновитьВидПостаНаСервере()

	Ошибка = "";
	КодОтвета = 0;
	Если ПустаяСтрока(ВидПубликации) Тогда
		ВидПубликации = "Пост в ленту";
	КонецЕсли;
	Ключ = КлючПодписи();
	Свой = СвойТекстПоста(Ключ);
	Ответ = ИМ_ЗаказыСайтаСервер.ПроверитьПост(ДанныеПоста(Свой), Ошибка, КодОтвета);
	Картинка = "";
	Если Ответ = Неопределено Тогда
		ПричинаНельзяПост = ОшибкаУведомлений(Ошибка, КодОтвета);
	Иначе
		ПодписьПостаШаблон = СтрокаИз(Ответ, "template");
		Если НЕ Свой Тогда
			ПодписьПоста = ПодписьПостаШаблон;
		КонецЕсли;
		ПодписьПостаКлюч = Ключ;
		ПричинаНельзяПост = СтрокаИз(Ответ, "blockedReason");
		Картинка = СтрокаИз(Ответ, "imageUrl");
	КонецЕсли;
	История = (ВидПубликации = "История");
	ВидПостаHTML = ВидПоста(Картинка, ?(История, "", ПодписьПоста), ПричинаНельзяПост, История,
		ВидПубликации = "Скидки недели (карусель)");
	Элементы.ПодписьПоста.Видимость = НЕ История;
	Элементы.КнопкаОпубликоватьПост.Доступность = ПустаяСтрока(ПричинаНельзяПост);

КонецПроцедуры

&НаСервере
Функция ОпубликоватьПостНаСервере()

	Итог = Новый Структура("Начато, Текст", Ложь, "");
	Ошибка = "";
	КодОтвета = 0;
	Свой = СвойТекстПоста(КлючПодписи());
	Ответ = ИМ_ЗаказыСайтаСервер.ОпубликоватьПост(ДанныеПоста(Свой), Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Итог.Текст = "Не опубликовано. " + ОшибкаУведомлений(Ошибка, КодОтвета);
	ИначеЕсли Ответ.Получить("started") = Истина Тогда
		Итог.Начато = Истина;
		Что = ?(ВидПубликации = "История", "История", ?(ВидПубликации = "Скидки недели (карусель)", "Карусель", "Пост"));
		Итог.Текст = Что + " публикуется — Instagram обрабатывает картинку обычно 10–30 секунд."
			+ Символы.ПС + "Чем кончилось — в списке «Последние рассылки» внизу, он обновится сам."
			+ " Двойной щелчок по строке откроет публикацию.";
		Состояние = Что + " «" + ?(ВидПубликации = "Скидки недели (карусель)", "Скидки недели", ТоварУведомления) + "» публикуется в Instagram…";
	Иначе
		Итог.Текст = "Не опубликовано. " + СтрокаИз(Ответ, "blockedReason");
	КонецЕсли;
	ЗагрузитьРассылки();
	ОбновитьВидПостаНаСервере();
	Возврат Итог;

КонецФункции

// Владелец правил текст поста для этого же товара и шаблона — его и шлём; иначе сервер
// возьмёт текст по шаблону (пустой caption).
&НаСервере
Функция СвойТекстПоста(Ключ)

	Возврат НЕ ПустаяСтрока(ПодписьПоста) И ПодписьПоста <> ПодписьПостаШаблон И Ключ = ПодписьПостаКлюч;

КонецФункции

&НаСервере
Функция ДанныеПоста(Свой)

	Формат = ?(ВидПубликации = "История", "story", ?(ВидПубликации = "Скидки недели (карусель)", "carousel", "post"));
	Возврат Новый Структура("kind, code, caption, format", ВидШаблона(Шаблон), КодТовараУведомления,
		?(Свой, СокрЛП(ПодписьПоста), ""), Формат);

КонецФункции

// Для какого товара и шаблона текст поста: правленный текст не переносим на другой товар.
// У карусели товар не выбирают — её текст один.
&НаСервере
Функция КлючПодписи()

	Если ВидПубликации = "Скидки недели (карусель)" Тогда
		Возврат "carousel";
	КонецЕсли;
	Возврат ВидШаблона(Шаблон) + "|" + КодТовараУведомления;

КонецФункции

&НаСервере
Функция ОтправитьУведомлениеНаСервере()

	Итог = Новый Структура("Отправлено, Текст", Ложь, "");
	Ошибка = "";
	КодОтвета = 0;
	Ответ = ИМ_ЗаказыСайтаСервер.ОтправитьУведомление(ДанныеУведомления(), Ошибка, КодОтвета);
	Если Ответ = Неопределено Тогда
		Итог.Текст = "Не отправлено. " + ОшибкаУведомлений(Ошибка, КодОтвета);
	ИначеЕсли Ответ.Получить("sent") = Истина Тогда
		Сколько = ЦелоеИз(Ответ, "recipients");
		Итог.Отправлено = Истина;
		Итог.Текст = "Уведомление отправляется " + Формат(Сколько, "ЧН=0; ЧГ=") + " " + Покупателям(Сколько) + "."
			+ Символы.ПС + "Сколько дошло — в списке «Последние рассылки» внизу, он обновится сам через несколько секунд.";
		Состояние = "Уведомление «" + ЗаголовокУведомления + "» отправляется.";
	Иначе
		Итог.Текст = "Не отправлено. " + СтрокаИз(Ответ, "blockedReason");
	КонецЕсли;
	ЗагрузитьРассылки();
	ОбновитьВидУведомленияНаСервере();
	Возврат Итог;

КонецФункции

&НаСервере
Функция ДанныеУведомления()

	Возврат Новый Структура("kind, code, title, body", ВидШаблона(Шаблон), КодТовараУведомления,
		СокрЛП(ЗаголовокУведомления), СокрЛП(ТекстУведомления));

КонецФункции

// Выбрали товар — подставляем текст его шаблона. «Свой текст» не трогаем:
// его пишет владелец, товар только решает, какая страница откроется по нажатию.
&НаКлиенте
Процедура ВыбратьТоварУведомления(Данные)

	Если Данные = Неопределено Тогда
		КодТовараУведомления = "";
		ТоварУведомления = "";
	Иначе
		КодТовараУведомления = Данные.Код;
		ТоварУведомления = Данные.Название + " (" + Данные.Код + ")";
	КонецЕсли;
	Если Шаблон = "Свой текст" Тогда
		Возврат;
	КонецЕсли;
	Если Данные = Неопределено Тогда
		ЗаголовокУведомления = "";
		ТекстУведомления = "";
	ИначеЕсли Шаблон = "Скидка" Тогда
		// Нет старой цены — текста скидки нет: сервер объяснит, почему шаблон не подходит.
		ЗаголовокУведомления = Данные.ЗаголовокСкидка;
		ТекстУведомления = Данные.ТекстСкидка;
	Иначе
		ЗаголовокУведомления = Данные.ЗаголовокНовинка;
		ТекстУведомления = Данные.ТекстНовинка;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОтборТоваровУведомлений(Показать)

	Если Показать = "Со скидкой" Тогда
		Возврат Новый ФиксированнаяСтруктура("Скидка", Истина);
	ИначеЕсли Показать = "Новинки" Тогда
		Возврат Новый ФиксированнаяСтруктура("Новинка", Истина);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Слово на форме → ключ для сервера и обратно.
&НаСервереБезКонтекста
Функция ВидШаблона(Имя)

	Если Имя = "Скидка" Тогда
		Возврат "sale";
	ИначеЕсли Имя = "Новинка" Тогда
		Возврат "new";
	КонецЕсли;
	Возврат "custom";

КонецФункции

&НаСервереБезКонтекста
Функция ИмяШаблона(Вид)

	Если Вид = "sale" Тогда
		Возврат "Скидка";
	ИначеЕсли Вид = "new" Тогда
		Возврат "Новинка";
	ИначеЕсли Вид = "deal" Тогда
		Возврат "Товар дня";
	ИначеЕсли Вид = "hit" Тогда
		Возврат "Хит";
	ИначеЕсли Вид = "foryou" Тогда
		Возврат "Специально для вас";
	ИначеЕсли Вид = "week" Тогда
		Возврат "Скидки недели";
	КонецЕсли;
	Возврат "Свой текст";

КонецФункции

&НаСервереБезКонтекста
Функция ИтогРассылки(Статус)

	Если Статус = "sending" Тогда
		Возврат "отправляется…";
	ИначеЕсли Статус = "done" Тогда
		Возврат "отправлено";
	ИначеЕсли Статус = "failed" Тогда
		Возврат "не дошло ни до кого";
	ИначеЕсли Статус = "interrupted" Тогда
		Возврат "прервалось";
	КонецЕсли;
	Возврат Статус;

КонецФункции

&НаСервереБезКонтекста
Функция ИтогПоста(Статус, Пояснение)

	Если Статус = "sending" Тогда
		Возврат "публикуется…";
	ИначеЕсли Статус = "done" Тогда
		Возврат "опубликован";
	ИначеЕсли Статус = "interrupted" Тогда
		Возврат "прервалось — можно повторить";
	ИначеЕсли Статус = "unclear" Тогда
		Возврат "не ясно, вышел ли" + ?(ПустаяСтрока(Пояснение), "", ": " + Пояснение);
	КонецЕсли;
	Возврат "не опубликован" + ?(ПустаяСтрока(Пояснение), "", ": " + Пояснение);

КонецФункции

&НаСервереБезКонтекста
Функция КудаПост(Формат, Авто)

	Если Авто Тогда
		Возврат "Авто-история";
	ИначеЕсли Формат = "story" Тогда
		Возврат "История";
	ИначеЕсли Формат = "carousel" Тогда
		Возврат "Карусель";
	КонецЕсли;
	Возврат "Instagram";

КонецФункции

// «Отправить 1 покупателю», «Отправить 5 покупателям».
&НаКлиентеНаСервереБезКонтекста
Функция Покупателям(Сколько)

	Если Сколько % 10 = 1 И Сколько % 100 <> 11 Тогда
		Возврат "покупателю";
	КонецЕсли;
	Возврат "покупателям";

КонецФункции

&НаСервереБезКонтекста
Функция ОшибкаУведомлений(Ошибка, КодОтвета)

	Если КодОтвета = 404 Тогда
		Возврат "Сервер сайта ещё не обновлён — уведомления заработают после его обновления.";
	КонецЕсли;
	Возврат Ошибка;

КонецФункции

// Как уведомление увидит покупатель: карточка на экране телефона, под ней —
// что откроет нажатие, длина текста, сколько человек получит и можно ли слать.
&НаСервереБезКонтекста
Функция ВидУведомления(Заголовок, Текст, Товар, Получателей, Причина)

	Куски = Новый Массив;
	Куски.Добавить("<div class='wrap'><div class='phone'><div class='ntf'>");
	Куски.Добавить("<div class='ntf-top'><span class='ntf-ico'>S</span><span class='ntf-app'>S МАРКЕТ</span>"
		+ "<span class='ntf-when'>сейчас</span></div>");
	Куски.Добавить("<div class='ntf-t'>" + ?(ПустаяСтрока(Заголовок), "<span class='ntf-empty'>Заголовок</span>", Э(Заголовок)) + "</div>");
	Куски.Добавить("<div class='ntf-b'>" + ?(ПустаяСтрока(Текст), "<span class='ntf-empty'>Текст уведомления</span>", Э(Текст)) + "</div>");
	Куски.Добавить("</div></div>");
	Куски.Добавить("<div class='ntf-meta'>Нажатие откроет: " + ?(ПустаяСтрока(Товар), "главную страницу приложения",
		"страницу товара " + Э(Товар)) + ".</div>");
	Куски.Добавить("<div class='ntf-meta'>Заголовок: " + Ч(СтрДлина(Заголовок)) + " из 60 знаков, текст: "
		+ Ч(СтрДлина(Текст)) + " из 180.</div>");
	Куски.Добавить("<div class='ntf-who'>Получат: <b>" + Ч(Получателей) + "</b> чел. — те, кто включил «Новинки и скидки» в приложении.</div>");
	Если ПустаяСтрока(Причина) Тогда
		Куски.Добавить("<div class='ntf-ok'>Можно отправлять. Не больше одного уведомления в день, только с 10:00 до 20:00.</div>");
	Иначе
		Куски.Добавить("<div class='ntf-no'>" + Э(Причина) + "</div>");
	КонецЕсли;
	Куски.Добавить("</div>");
	Возврат Страница(СтрСоединить(Куски, ""));

КонецФункции

// Как пост увидят в ленте: картинка (её рисует сайт, грузится 1–3 секунды) и текст.
// У истории текста нет: всё на картинке, ответы приходят в Direct.
&НаСервереБезКонтекста
Функция ВидПоста(Картинка, Подпись, Причина, История = Ложь, Карусель = Ложь)

	Куски = Новый Массив;
	Куски.Добавить("<div class='wrap'>");
	Если Карусель Тогда
		Куски.Добавить("<div class='ntf-meta'>Товар выбирать не нужно: в карусель войдут все товары со скидкой и фото "
			+ "(до 9, самые большие скидки первыми). Ниже — первая картинка, дальше листаются карточки товаров.</div>");
	КонецЕсли;
	Куски.Добавить("<div class='ig'>");
	Куски.Добавить("<div class='ig-top'><span class='ig-ava'>S</span><b>smartcentrr</b></div>");
	Если ПустаяСтрока(Картинка) Тогда
		Куски.Добавить("<div class='ig-none'>Выберите товар слева — здесь появится картинка поста.</div>");
	Иначе
		Куски.Добавить("<img class='ig-img' src='" + Э(Картинка) + "' alt='Картинка поста загружается…'>");
	КонецЕсли;
	Если История Тогда
		Куски.Добавить("</div>");
		Куски.Добавить("<div class='ntf-meta'>История висит 24 часа. Подписи у истории нет — всё на картинке. "
			+ "Ответы на неё придут в Direct, робот знает этот товар.</div>");
	Иначе
		Текст = ?(ПустаяСтрока(Подпись), "<span class='ntf-empty'>Текст поста</span>", СтрЗаменить(Э(Подпись), Символы.ПС, "<br>"));
		Куски.Добавить("<div class='ig-cap'><b>smartcentrr</b> " + Текст + "</div>");
		Куски.Добавить("</div>");
		Куски.Добавить("<div class='ntf-meta'>Текст: " + Ч(СтрДлина(Подпись)) + " из 2200 знаков.</div>");
	КонецЕсли;
	Если ПустаяСтрока(Причина) Тогда
		Куски.Добавить("<div class='ntf-ok'>Можно публиковать. " + ?(История, "Историю", "Пост")
			+ " увидят все подписчики магазина; не больше 10 в день, один товар с одним шаблоном — раз в сутки.</div>");
	Иначе
		Куски.Добавить("<div class='ntf-no'>" + Э(Причина) + "</div>");
	КонецЕсли;
	Куски.Добавить("</div>");
	Возврат Страница(СтрСоединить(Куски, ""));

КонецФункции

