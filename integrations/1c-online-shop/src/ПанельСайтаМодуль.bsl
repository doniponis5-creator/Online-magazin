// Панель сайта (расширение ИМ_ОнлайнМагазин): сводка по магазину и настройки сайта.
// Владелец смотрит и меняет всё отсюда, на сервер заходить не нужно.
// Сводка и настройки живут на сервере SBonus; здесь только показ и отправка.
//
// Сводка рисуется как HTML-панель: плитки, графики за 14 дней, карточки разделов.
// Обычными полями ввода это выглядело свалкой — два десятка чисел в один столбец.
// HTML собирается здесь целиком, без интернета и без внешних библиотек: только
// разметка, стили и SVG. Настройки остались обычными полями 1С — их надо править.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьВсёНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьВсёНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСайт(Команда)

	НачатьЗапускПриложения(Новый ОписаниеОповещения, "https://smarket.kg");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьВсёНаСервере()

	ЗагрузитьСводку();
	ЗагрузитьНастройки();
	ЗагрузитьЗнания();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСводку()

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.СводкаСайта(Ошибка);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		ТекстHTML = ПанельОшибки(Ошибка);
		Возврат;
	КонецЕсли;

	ТекстHTML = ТекстПанели(Данные);

	Заказы  = Раздел(Данные, "orders");
	Каталог = Раздел(Данные, "catalog");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	Ошибки1С       = ЦелоеИз(Заказы, "failed");

	Состояние = "Обновлено " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ".";
	Если ГотовыКПродаже = 0 Тогда
		Состояние = Состояние + " Внимание: купить на сайте нечего — ни у одного товара нет и цены, и остатка.";
	КонецЕсли;
	Если Ошибки1С > 0 Тогда
		Состояние = Состояние + " Заказов с ошибкой загрузки в 1С: " + Формат(Ошибки1С, "ЧН=0; ЧГ=") + ".";
	КонецЕсли;
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Состояние = Состояние + " Оплачено, но не отгружено: " + Формат(ЖдутОтгрузки, "ЧН=0; ЧГ=")
			+ " — товара не было на складе, надо привезти и отгрузить.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.НастройкиСайта(Ошибка);
	Если Данные = Неопределено Тогда
		Если ПустаяСтрока(Состояние) Тогда
			Состояние = Ошибка;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Список = Данные.Получить("settings");
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Настройка Из Список Цикл
		Ключ = Строка(Настройка.Получить("key"));
		Значение = Строка(Настройка.Получить("value"));
		Если Ключ = "SITE_WELCOME_BONUS_AMOUNT" Тогда
			ПриветственныйБонус = Число(Значение);
		ИначеЕсли Ключ = "SITE_BONUS_MAX_PCT" Тогда
			МаксимумБонусами = Число(Значение);
		ИначеЕсли Ключ = "SITE_GUEST_CHECKOUT" Тогда
			ЗаказБезВхода = (Значение = "1");
		КонецЕсли;
	КонецЦикла;
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Значения = Новый Соответствие;
	Значения.Вставить("SITE_WELCOME_BONUS_AMOUNT", Формат(ПриветственныйБонус, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_BONUS_MAX_PCT", Формат(МаксимумБонусами, "ЧН=0; ЧГ=; ЧДЦ=0"));
	Значения.Вставить("SITE_GUEST_CHECKOUT", ?(ЗаказБезВхода, "1", "0"));

	Ошибка = "";
	Данные = ИМ_ЗаказыСайтаСервер.СохранитьНастройкиСайта(Значения, Ошибка);
	Если Данные = Неопределено Тогда
		Состояние = Ошибка;
		Возврат;
	КонецЕсли;
	Состояние = "Настройки сохранены " + Формат(ТекущаяДатаСеанса(), "ДЛФ=T") + ". Сайт применяет их сразу.";
	ЗагрузитьНастройки();

	// Знания отправляем, только если они были загружены: иначе пустое поле
	// затёрло бы на сервере текст, который просто не успел прийти.
	Если ЗнанияЗагружены Тогда
		Если ИМ_ЗаказыСайтаСервер.СохранитьЗнанияДляЧата(ЗнанияДляЧата, Ошибка) Тогда
			Состояние = Состояние + " Знания для чата сохранены — чат начнёт отвечать по ним в течение 10 минут.";
		Иначе
			Состояние = Состояние + " " + Ошибка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗнания()

	Ошибка = "";
	Текст = ИМ_ЗаказыСайтаСервер.ЗнанияДляЧата(Ошибка);
	ЗнанияЗагружены = (Текст <> Неопределено);
	Если ЗнанияЗагружены Тогда
		ЗнанияДляЧата = Текст;
	ИначеЕсли ПустаяСтрока(Состояние) Тогда
		Состояние = Ошибка;
	КонецЕсли;
	Элементы.ЗнанияДляЧата.ТолькоПросмотр = НЕ ЗнанияЗагружены;
	Модифицированность = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеОтветаСервера

// Сервер может не ответить разделом или прислать null — это не повод падать.

&НаСервереБезКонтекста
Функция Раздел(Данные, Ключ)

	Значение = Данные.Получить(Ключ);
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);

КонецФункции

&НаСервереБезКонтекста
Функция ЧислоИз(Контейнер, Ключ)

	Значение = Контейнер.Получить(Ключ);
	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

&НаСервереБезКонтекста
Функция ЦелоеИз(Контейнер, Ключ)

	Возврат Цел(ЧислоИз(Контейнер, Ключ));

КонецФункции

&НаСервереБезКонтекста
Функция СтрокаИз(Контейнер, Ключ)

	Значение = Контейнер.Получить(Ключ);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// "2026-09-18T12:06:21.356535" → дата 1С. Пусто или мусор — пустая дата, без исключения.
&НаСервереБезКонтекста
Функция ДатаИзISO(Значение)

	Если Значение = Неопределено Тогда
		Возврат '00010101';
	КонецЕсли;
	Текст = СтрЗаменить(Строка(Значение), "T", " ");
	Текст = Лев(Текст, 19);
	Попытка
		Части = СтрРазделить(Текст, " -:", Ложь);
		Если Части.Количество() < 6 Тогда
			Возврат '00010101';
		КонецЕсли;
		Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2]),
			Число(Части[3]), Число(Части[4]), Число(Части[5]));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Сервер живёт по всемирному времени, владелец — по бишкекскому.
// Без перевода «обновлён 06:42» вместо 12:42 читается как «сайт завис».
&НаСервереБезКонтекста
Функция МестнаяДатаИзISO(Значение)

	Дата = ДатаИзISO(Значение);
	Возврат ?(Дата = '00010101', Дата, МестноеВремя(Дата));

КонецФункции

#КонецОбласти

#Область СборкаHTML

// Числа в панели читает человек, поэтому разряды разделены пробелом,
// а ноль печатается нулём, а не пустым местом.
&НаСервереБезКонтекста
Функция Ч(Значение)

	Возврат Формат(Значение, "ЧДЦ=0; ЧН=0");

КонецФункции

// Координаты SVG: точка как разделитель дробной части, без разделителя разрядов.
&НаСервереБезКонтекста
Функция К(Значение)

	Возврат Формат(Значение, "ЧДЦ=1; ЧРД='.'; ЧГ=0; ЧН=0");

КонецФункции

&НаСервереБезКонтекста
Функция Э(Текст)

	Результат = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция Стили()

	// Движок HTML внутри 1С не понимает flexbox gap — отступы только полями,
	// а строки легенды остаются inline-block, иначе пробелы между словами пропадают.
	Правила = Новый Массив;
	Правила.Добавить("* { box-sizing: border-box; }");
	Правила.Добавить("html, body { height: 100%; margin: 0; font: 13px/1.4 'Segoe UI', Arial, sans-serif; color: #263244; background: #eef1f5; }");
	Правила.Добавить(".wrap { min-height: 100%; padding: 12px 12px 2px; display: flex; flex-direction: column; }");
	Правила.Добавить(".row { display: flex; flex-wrap: wrap; margin-left: -10px; flex: none; }");
	Правила.Добавить(".row.grow { flex: 1 1 auto; }");
	Правила.Добавить(".row.grow .card { display: flex; flex-direction: column; }");
	Правила.Добавить(".card { background: #fff; border: 1px solid #dde3ea; border-radius: 8px; padding: 10px 12px; margin: 0 0 10px 10px; flex: 1 1 180px; min-width: 168px; }");
	Правила.Добавить(".card.c3 { flex: 1 1 280px; }");
	Правила.Добавить(".card.full { flex: 1 1 100%; }");
	Правила.Добавить(".head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; }");
	Правила.Добавить(".head b { font-size: 13px; font-weight: 600; }");
	Правила.Добавить(".head span { color: #6b7889; font-size: 12px; padding-left: 10px; white-space: nowrap; }");
	Правила.Добавить(".kpi .lab { color: #5d6d7e; font-size: 12px; }");
	Правила.Добавить(".kpi .val { font-size: 28px; font-weight: 600; line-height: 1.1; margin: 2px 0 3px; }");
	Правила.Добавить(".kpi .val .cur { font-size: 14px; font-weight: 400; color: #5d6d7e; }");
	Правила.Добавить(".kpi .sub { color: #6b7889; font-size: 12px; }");
	Правила.Добавить(".kpi.warn .val { color: #d33b2e; }");
	Правила.Добавить(".line { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5px; }");
	Правила.Добавить(".line .n { color: #5d6d7e; padding-right: 10px; }");
	Правила.Добавить(".line .v { font-weight: 600; white-space: nowrap; }");
	Правила.Добавить(".line.sep { border-top: 1px solid #eef1f5; padding-top: 5px; }");
	Правила.Добавить(".stack { display: flex; height: 12px; border-radius: 6px; overflow: hidden; background: #eef1f5; margin-bottom: 8px; }");
	Правила.Добавить(".stack i { display: block; height: 100%; }");
	Правила.Добавить(".key { display: inline-block; color: #5d6d7e; margin: 0 14px 4px 0; white-space: nowrap; }");
	Правила.Добавить(".key i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; }");
	Правила.Добавить(".key b { color: #263244; }");
	Правила.Добавить(".dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }");
	Правила.Добавить(".chart { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 110px; }");
	Правила.Добавить(".chart svg { display: block; flex: 1 1 auto; width: 100%; height: 100%; min-height: 80px; border-bottom: 1px solid #dde3ea; }");
	Правила.Добавить(".xax { display: flex; justify-content: space-between; color: #6b7889; font-size: 11px; margin-top: 4px; }");
	Правила.Добавить(".note { flex: 1 1 auto; color: #6b7889; font-size: 12px; padding: 34px 0; text-align: center; }");
	Правила.Добавить("table { width: 100%; border-collapse: collapse; }");
	Правила.Добавить("th { text-align: left; font-weight: 400; color: #6b7889; font-size: 12px; padding: 0 10px 6px 0; border-bottom: 1px solid #eef1f5; }");
	Правила.Добавить("td { padding: 6px 10px 6px 0; border-bottom: 1px solid #f4f6f9; }");
	Правила.Добавить("th.num, td.num { text-align: right; white-space: nowrap; }");
	Правила.Добавить("td.num { font-weight: 600; }");
	Правила.Добавить("td.dim { color: #6b7889; white-space: nowrap; }");
	Правила.Добавить("td small { display: block; color: #6b7889; font-size: 12px; }");
	Правила.Добавить("td.goods { color: #263244; min-width: 220px; }");
	Правила.Добавить(".pill { display: inline-block; padding: 1px 9px; border-radius: 10px; font-size: 12px; white-space: nowrap; }");
	Правила.Добавить(".alert { margin: 24px; padding: 14px 16px; border-radius: 8px; background: #fdecea; border: 1px solid #f3c2bd; color: #93261c; }");

	Возврат СтрСоединить(Правила, Символы.ПС);

КонецФункции

&НаСервереБезКонтекста
Функция Страница(Тело)

	Куски = Новый Массив;
	Куски.Добавить("<!DOCTYPE html><html lang='ru'><head><meta charset='utf-8'>");
	Куски.Добавить("<meta http-equiv='X-UA-Compatible' content='IE=edge'><title>Панель сайта</title>");
	Куски.Добавить("<style>" + Стили() + "</style></head><body>");
	Куски.Добавить(Тело);
	Куски.Добавить("</body></html>");
	Возврат СтрСоединить(Куски, "");

КонецФункции

&НаСервереБезКонтекста
Функция ПанельОшибки(Ошибка)

	Возврат Страница("<div class='alert'>Сводка не загрузилась. " + Э(Ошибка) + "</div>");

КонецФункции

&НаСервереБезКонтекста
Функция Плитка(Подпись, Значение, Единица, Пояснение, Тревога = Ложь)

	Класс = ?(Тревога, "card kpi warn", "card kpi");
	Хвост = ?(ПустаяСтрока(Единица), "", " <span class='cur'>" + Э(Единица) + "</span>");
	Возврат "<div class='" + Класс + "'><div class='lab'>" + Э(Подпись) + "</div>"
		+ "<div class='val'>" + Э(Значение) + Хвост + "</div>"
		+ "<div class='sub'>" + Э(Пояснение) + "</div></div>";

КонецФункции

&НаСервереБезКонтекста
Функция Строчка(Название, Значение, Отделить = Ложь)

	Класс = ?(Отделить, "line sep", "line");
	Возврат "<div class='" + Класс + "'><span class='n'>" + Название + "</span>"
		+ "<span class='v'>" + Э(Значение) + "</span></div>";

КонецФункции

&НаСервереБезКонтекста
Функция Карточка(Заголовок, Примечание, Содержимое)

	Правое = ?(ПустаяСтрока(Примечание), "", "<span>" + Э(Примечание) + "</span>");
	Возврат "<div class='card'><div class='head'><b>" + Э(Заголовок) + "</b>" + Правое + "</div>"
		+ Содержимое + "</div>";

КонецФункции

// Столбики за 14 дней. Последний столбик — сегодня, он светлее: день ещё не кончился.
&НаСервереБезКонтекста
Функция ГрафикСтолбиками(Значения, Подписи, Цвет, ЦветСегодня)

	Количество = Значения.Количество();
	Если Количество = 0 Тогда
		Возврат "<div class='note'>Сервер пока не присылает историю по дням.</div>";
	КонецЕсли;

	Ширина = 560;
	Низ = 100;
	Высота = 96;
	Шаг = Ширина / Количество;
	ШиринаСтолбика = Макс(4, Шаг - 8);
	Отступ = (Шаг - ШиринаСтолбика) / 2;

	Максимум = 0;
	Для Каждого Значение Из Значения Цикл
		Максимум = Макс(Максимум, Значение);
	КонецЦикла;

	// preserveAspectRatio='none' растягивает картинку по высоте карточки.
	// Поэтому внутри только прямоугольники: текст и линии здесь расплющило бы.
	Части = Новый Массив;
	Части.Добавить("<div class='chart'><svg viewBox='0 0 560 100' preserveAspectRatio='none'>");
	Для Индекс = 0 По Количество - 1 Цикл
		Значение = Значения[Индекс];
		ВысотаСтолбика = ?(Максимум = 0, 0, Значение / Максимум * Высота);
		Если ВысотаСтолбика > 0 И ВысотаСтолбика < 2 Тогда
			ВысотаСтолбика = 2;
		КонецЕсли;
		Если ВысотаСтолбика <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Заливка = ?(Индекс = Количество - 1, ЦветСегодня, Цвет);
		Части.Добавить("<rect x='" + К(Индекс * Шаг + Отступ) + "' y='" + К(Низ - ВысотаСтолбика)
			+ "' width='" + К(ШиринаСтолбика) + "' height='" + К(ВысотаСтолбика)
			+ "' fill='" + Заливка + "'/>");
	КонецЦикла;
	Части.Добавить("</svg>");

	// Подписей четыре: больше не читается, меньше — не понять шкалу.
	Отметки = Новый Массив;
	Отметки.Добавить(0);
	Отметки.Добавить(Цел(Количество / 3));
	Отметки.Добавить(Цел(Количество * 2 / 3));
	Отметки.Добавить(Количество - 1);
	Метки = Новый Массив;
	Предыдущая = -1;
	Для Каждого Индекс Из Отметки Цикл
		Если Индекс <= Предыдущая ИЛИ Индекс >= Подписи.Количество() Тогда
			Продолжить;
		КонецЕсли;
		Предыдущая = Индекс;
		Метки.Добавить("<span>" + Э(Подписи[Индекс]) + "</span>");
	КонецЦикла;
	Части.Добавить("<div class='xax'>" + СтрСоединить(Метки, "") + "</div></div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

&НаСервереБезКонтекста
Функция ПолосаСтатусов(Статусы, Всего)

	Полоса = Новый Массив;
	Ключи = Новый Массив;
	Полоса.Добавить("<div class='stack'>");
	Для Каждого Статус Из Статусы Цикл
		Доля = ?(Всего = 0, 0, Статус.Значение / Всего * 100);
		Если Доля > 0 Тогда
			Полоса.Добавить("<i style='width:" + К(Доля) + "%;background:" + Статус.Цвет + "'></i>");
		КонецЕсли;
		Ключи.Добавить("<span class='key'><i style='background:" + Статус.Цвет + "'></i>"
			+ Э(Статус.Название) + "&#160;<b>" + Ч(Статус.Значение) + "</b></span>");
	КонецЦикла;
	Полоса.Добавить("</div><div class='keys'>" + СтрСоединить(Ключи, "") + "</div>");
	Возврат СтрСоединить(Полоса, "");

КонецФункции

&НаСервереБезКонтекста
Функция НовыйСтатус(Название, Значение, Цвет)

	Статус = Новый Структура("Название, Значение, Цвет", Название, Значение, Цвет);
	Возврат Статус;

КонецФункции

// Код статуса от сервера → человеческое слово и цвет наклейки.
&НаСервереБезКонтекста
Функция ВидСтатуса(Код, Отгружен = Ложь)

	Если Код = "awaiting_payment" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт оплаты", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "paid" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Оплачен, ждёт 1С", "#e7effd", "#1b4894");
	ИначеЕсли Код = "in_1c" Тогда
		Если Отгружен Тогда
			Возврат Новый Структура("Название, Фон, Цвет", "Отгружен", "#e4f3ec", "#14663c");
		КонецЕсли;
		// Деньги взяты, документы есть, товара на складе не было — заказ надо везти.
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт отгрузки", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "failed" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Ошибка загрузки", "#fbe7e5", "#93261c");
	ИначеЕсли Код = "cancelled" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Отменён", "#eef1f5", "#5d6d7e");
	КонецЕсли;
	Возврат Новый Структура("Название, Фон, Цвет", ?(ПустаяСтрока(Код), "—", Код), "#eef1f5", "#5d6d7e");

КонецФункции

// «сегодня 12:31» читается быстрее, чем «19.09.2026 12:31».
&НаСервереБезКонтекста
Функция КогдаЗаказ(Дата)

	Если Дата = '00010101' Тогда
		Возврат "—";
	КонецЕсли;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Если Дата >= Сегодня Тогда
		Возврат "сегодня " + Формат(Дата, "ДФ='HH:mm'");
	ИначеЕсли Дата >= Сегодня - 86400 Тогда
		Возврат "вчера " + Формат(Дата, "ДФ='HH:mm'");
	КонецЕсли;
	Возврат Формат(Дата, "ДФ='dd.MM HH:mm'");

КонецФункции

// Названия товаров заказа: до трёх строк, остальное числом.
// Сервер присылает только первые позиции, всего их — в itemsTotal.
&НаСервереБезКонтекста
Функция ТоварыЗаказа(Заказ)

	Позиции = Заказ.Получить("items");
	Если ТипЗнч(Позиции) <> Тип("Массив") ИЛИ Позиции.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Если ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Название = СтрокаИз(Позиция, "name");
		Если ПустаяСтрока(Название) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЧислоИз(Позиция, "qty");
		Части.Добавить(Э(Название) + ?(Количество > 1, " × " + Ч(Количество), ""));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Всего = ЦелоеИз(Заказ, "itemsTotal");
	Ещё = Всего - Части.Количество();
	Результат = СтрСоединить(Части, "<br>");
	Если Ещё > 0 Тогда
		Результат = Результат + "<small>и ещё " + Ч(Ещё) + "</small>";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТаблицаЗаказов(Список)

	Если ТипЗнч(Список) <> Тип("Массив") ИЛИ Список.Количество() = 0 Тогда
		Возврат "<div class='note'>Заказов с сайта пока нет.</div>";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Когда</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th class='num'>Бонусами</th><th>Статус</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Статус = ВидСтатуса(СтрокаИз(Заказ, "status"), Заказ.Получить("realized") = Истина);
		Бонусами = ЧислоИз(Заказ, "bonusSpent");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Покупатель = ?(ПустаяСтрока(Имя), "<span class='dim'>без имени</span>", Э(Имя))
			+ ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Э(КогдаЗаказ(МестнаяДатаИзISO(Заказ.Получить("createdAt")))) + "</td>"
			+ "<td>" + Покупатель + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td class='num'>" + ?(Бонусами > 0, Э(Ч(Бонусами)), "<span class='dim'>—</span>") + "</td>"
			+ "<td><span class='pill' style='background:" + Статус.Фон + ";color:" + Статус.Цвет + "'>"
			+ Э(Статус.Название) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");
	Возврат СтрСоединить(Строки, "");

КонецФункции

// Оплаченные заказы, по которым надо что-то сделать: привезти товар, вернуть
// деньги, оформить вручную. Покупатель о нехватке не знает — знает владелец.
&НаСервереБезКонтекста
Функция КарточкаВнимания(Список)

	Если ТипЗнч(Список) <> Тип("Массив") ИЛИ Список.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Оплачен</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th>Что сделать</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Вид = СтрокаИз(Заказ, "kind");
		Если Вид = "failed" Тогда
			Дело = "Не попал в 1С — оформите заказ вручную";
			Цвет = "#93261c";
			Фон = "#fbe7e5";
		ИначеЕсли Вид = "waiting_1c" Тогда
			Дело = "1С не забирает — включите компьютер с 1С";
			Цвет = "#1b4894";
			Фон = "#e7effd";
		Иначе
			Дело = "Товара нет на складе — привезите или верните деньги";
			Цвет = "#8a5a10";
			Фон = "#fdf0dc";
		КонецЕсли;
		Оплачен = МестнаяДатаИзISO(Заказ.Получить("paidAt"));
		Дней = ?(Оплачен = '00010101', 0, Цел((ТекущаяДатаСеанса() - Оплачен) / 86400));
		Когда = КогдаЗаказ(Оплачен) + ?(Дней > 0, "<small>ждёт " + Ч(Дней) + " дн.</small>", "");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Когда + "</td>"
			+ "<td>" + Э(Имя) + ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>") + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td><span class='pill' style='background:" + Фон + ";color:" + Цвет + "'>" + Э(Дело) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");

	Возврат "<div class='card full' style='border:2px solid #e8672d'><div class='head'>"
		+ "<b>⚠ Оплачено — нужно действие</b><span>" + Э(Ч(Список.Количество()) + " заказ(ов) · покупатель о нехватке не знает")
		+ "</span></div>" + СтрСоединить(Строки, "") + "</div>";

КонецФункции

&НаСервереБезКонтекста
Функция ТекстПанели(Данные)

	Заказы     = Раздел(Данные, "orders");
	Каталог    = Раздел(Данные, "catalog");
	Покупатели = Раздел(Данные, "customers");
	Визиты     = Раздел(Данные, "visits");
	Коды       = Раздел(Данные, "codes");
	Каналы     = Раздел(Данные, "channels");

	ТоваровВсего   = ЦелоеИз(Каталог, "items");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	ДатаКаталога   = МестнаяДатаИзISO(Каталог.Получить("updatedAt"));

	// ── Плитки ───────────────────────────────────────────────────────────────
	Плитки = Новый Массив;
	Плитки.Добавить(Плитка("Заказов сегодня", Ч(ЦелоеИз(Заказы, "today")), "",
		"за 7 дней " + Ч(ЦелоеИз(Заказы, "week")) + " · всего " + Ч(ЦелоеИз(Заказы, "total"))));
	Плитки.Добавить(Плитка("Оплачено сегодня", Ч(ЧислоИз(Заказы, "paidToday")), "сом",
		"за 7 дней " + Ч(ЧислоИз(Заказы, "paidWeek")) + " · всего " + Ч(ЧислоИз(Заказы, "paidTotal"))));
	Плитки.Добавить(Плитка("Людей на сайте сегодня", Ч(ЦелоеИз(Визиты, "peopleToday")), "",
		"за 7 дней " + Ч(ЦелоеИз(Визиты, "peopleWeek")) + " · страниц " + Ч(ЦелоеИз(Визиты, "viewsToday"))));
	Плитки.Добавить(Плитка("Готовы к продаже", Ч(ГотовыКПродаже), "",
		"из " + Ч(ТоваровВсего) + " товаров в каталоге", ГотовыКПродаже = 0));
	// Пятая плитка появляется только когда есть оплаченные, но не отгруженные
	// заказы: так её замечают, а в спокойный день она не мозолит глаза.
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Плитки.Добавить(Плитка("Ждут отгрузки", Ч(ЖдутОтгрузки), "",
			"оплачены, но товара не было на складе", Истина));
	КонецЕсли;

	// ── Графики за 14 дней ───────────────────────────────────────────────────
	ЗаказыПоДням = Новый Массив;
	ДеньгиПоДням = Новый Массив;
	ЛюдиПоДням = Новый Массив;
	Подписи = Новый Массив;
	СуммаЗаказов = 0;
	СуммаДенег = 0;
	СуммаЛюдей = 0;
	Ряд = Данные.Получить("daily");
	Если ТипЗнч(Ряд) = Тип("Массив") Тогда
		Для Каждого День Из Ряд Цикл
			Если ТипЗнч(День) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			ЗаказовЗаДень = ЦелоеИз(День, "orders");
			ДенегЗаДень = ЧислоИз(День, "paid");
			ЛюдейЗаДень = ЦелоеИз(День, "people");
			ЗаказыПоДням.Добавить(ЗаказовЗаДень);
			ДеньгиПоДням.Добавить(ДенегЗаДень);
			ЛюдиПоДням.Добавить(ЛюдейЗаДень);
			СуммаЗаказов = СуммаЗаказов + ЗаказовЗаДень;
			СуммаДенег = СуммаДенег + ДенегЗаДень;
			СуммаЛюдей = СуммаЛюдей + ЛюдейЗаДень;
			ДеньДата = ДатаИзISO(СтрокаИз(День, "day") + "T00:00:00");
			Подписи.Добавить(?(ДеньДата = '00010101', "", Формат(ДеньДата, "ДФ='dd.MM'")));
		КонецЦикла;
	КонецЕсли;
	Дней = ЗаказыПоДням.Количество();

	Графики = Новый Массив;
	Графики.Добавить("<div class='card c3'><div class='head'><b>Заказы по дням</b><span>"
		+ Э(Ч(Дней) + " дней · всего " + Ч(СуммаЗаказов)) + "</span></div>"
		+ ГрафикСтолбиками(ЗаказыПоДням, Подписи, "#2563eb", "#93b4f5") + "</div>");
	Графики.Добавить("<div class='card c3'><div class='head'><b>Деньги по дням</b><span>"
		+ Э(Ч(Дней) + " дней · всего " + Ч(СуммаДенег) + " сом") + "</span></div>"
		+ ГрафикСтолбиками(ДеньгиПоДням, Подписи, "#7a5af8", "#bfb0fb") + "</div>");
	Графики.Добавить("<div class='card c3'><div class='head'><b>Люди на сайте по дням</b><span>"
		+ Э(Ч(Дней) + " дней · всего " + Ч(СуммаЛюдей)) + "</span></div>"
		+ ГрафикСтолбиками(ЛюдиПоДням, Подписи, "#1f9254", "#6ec295") + "</div>");

	// ── Что с заказами сейчас ────────────────────────────────────────────────
	Статусы = Новый Массив;
	Статусы.Добавить(НовыйСтатус("Ждут оплаты", ЦелоеИз(Заказы, "awaitingPayment"), "#e8a33d"));
	Статусы.Добавить(НовыйСтатус("Оплачены, ждут 1С", ЦелоеИз(Заказы, "paidWaiting1C"), "#2563eb"));
	Ждут = ЦелоеИз(Заказы, "awaitingShipment");
	Отгружено = ЦелоеИз(Заказы, "shipped");
	// Старый сервер не присылает разбивку — тогда показываем всё одной строкой.
	Если Ждут + Отгружено = 0 Тогда
		Статусы.Добавить(НовыйСтатус("Проведены в 1С", ЦелоеИз(Заказы, "in1C"), "#1f9254"));
	Иначе
		Статусы.Добавить(НовыйСтатус("Ждут отгрузки", Ждут, "#e8672d"));
		Статусы.Добавить(НовыйСтатус("Отгружены", Отгружено, "#1f9254"));
	КонецЕсли;
	Статусы.Добавить(НовыйСтатус("С ошибкой", ЦелоеИз(Заказы, "failed"), "#d33b2e"));
	Статусы.Добавить(НовыйСтатус("Отменены", ЦелоеИз(Заказы, "cancelled"), "#b6c0cd"));
	ВсегоСтатусов = 0;
	Для Каждого Статус Из Статусы Цикл
		ВсегоСтатусов = ВсегоСтатусов + Статус.Значение;
	КонецЦикла;

	ТелоСтатусов = ПолосаСтатусов(Статусы, ВсегоСтатусов)
		+ "<div class='lines' style='margin-top:8px'>"
		+ Строчка("Бонусами оплачено", Ч(ЧислоИз(Заказы, "bonusSpent")) + " сом", Истина)
		+ "</div>";

	ТелоКаталога = "<div class='lines'>"
		+ Строчка("Товаров в каталоге", Ч(ТоваровВсего))
		+ Строчка("Из них с ценой", Ч(ЦелоеИз(Каталог, "withPrice")))
		+ Строчка("Готовы к продаже", Ч(ГотовыКПродаже))
		+ Строчка("Обновлён", ?(ДатаКаталога = '00010101', "ещё не выгружался",
			Формат(ДатаКаталога, "ДФ='dd.MM.yyyy HH:mm'")), Истина)
		+ "</div>";

	ТелоПокупателей = "<div class='lines'>"
		+ Строчка("Всего в SBonus", Ч(ЦелоеИз(Покупатели, "active")))
		+ Строчка("Зарегистрировались на сайте", Ч(ЦелоеИз(Покупатели, "fromSite")))
		+ Строчка("Вошло в кабинет · сегодня / 7 дней",
			Ч(ЦелоеИз(Покупатели, "loginsToday")) + " / " + Ч(ЦелоеИз(Покупатели, "loginsWeek")), Истина)
		+ Строчка("Новых покупателей · сегодня / 7 дней",
			Ч(ЦелоеИз(Покупатели, "newToday")) + " / " + Ч(ЦелоеИз(Покупатели, "newWeek")))
		+ "</div>";

	Телеграм = СтрокаИз(Каналы, "telegram");
	ВотсАп = СтрокаИз(Каналы, "whatsapp");
	ТелоКаналов = "<div class='lines'>"
		+ Строчка(Огонёк(Телеграм) + "Telegram", Телеграм)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "telegramToday")) + " / " + Ч(ЦелоеИз(Коды, "telegramWeek")))
		+ Строчка(Огонёк(ВотсАп) + "WhatsApp (запасной)", ВотсАп, Истина)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "whatsappToday")) + " / " + Ч(ЦелоеИз(Коды, "whatsappWeek")))
		+ "</div>";

	Разделы = Новый Массив;
	Разделы.Добавить(Карточка("Что с заказами сейчас", "всего " + Ч(ВсегоСтатусов), ТелоСтатусов));
	Разделы.Добавить(Карточка("Каталог на сайте", "", ТелоКаталога));
	Разделы.Добавить(Карточка("Покупатели", "", ТелоПокупателей));
	Разделы.Добавить(Карточка("Код для входа на сайт", "", ТелоКаналов));

	Последние = Данные.Получить("recentOrders");
	ТаблицаПоследних = "<div class='card full'><div class='head'><b>Последние заказы</b>"
		+ "<span>" + Э("всего " + Ч(ЦелоеИз(Заказы, "total"))) + "</span></div>"
		+ ТаблицаЗаказов(Последние) + "</div>";

	// Самое срочное — сразу под плитками: деньги взяты, а товара нет.
	Внимание = КарточкаВнимания(Данные.Получить("attention"));

	Тело = "<div class='wrap'>"
		+ "<div class='row'>" + СтрСоединить(Плитки, "") + "</div>"
		+ ?(ПустаяСтрока(Внимание), "", "<div class='row grow'>" + Внимание + "</div>")
		+ "<div class='row grow'>" + СтрСоединить(Графики, "") + "</div>"
		+ "<div class='row'>" + СтрСоединить(Разделы, "") + "</div>"
		+ "<div class='row grow'>" + ТаблицаПоследних + "</div>"
		+ "</div>";
	Возврат Страница(Тело);

КонецФункции

// Зелёный кружок — канал отвечает, красный — нет. Сервер пишет состояние словами.
&НаСервереБезКонтекста
Функция Огонёк(СостояниеКанала)

	Цвет = ?(НРег(СостояниеКанала) = "работает", "#1f9254", "#d33b2e");
	Возврат "<i class='dot' style='background:" + Цвет + "'></i>";

КонецФункции

#КонецОбласти
