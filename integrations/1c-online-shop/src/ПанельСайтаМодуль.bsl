&НаСервереБезКонтекста
Функция ПолосаСтатусов(Статусы, Всего)

	Полоса = Новый Массив;
	Ключи = Новый Массив;
	Полоса.Добавить("<div class='stack'>");
	Для Каждого Статус Из Статусы Цикл
		Доля = ?(Всего = 0, 0, Статус.Значение / Всего * 100);
		Если Доля > 0 Тогда
			Полоса.Добавить("<i style='width:" + К(Доля) + "%;background:" + Статус.Цвет + "'></i>");
		КонецЕсли;
		Ключи.Добавить("<span class='key'><i style='background:" + Статус.Цвет + "'></i>"
			+ Э(Статус.Название) + "&#160;<b>" + Ч(Статус.Значение) + "</b></span>");
	КонецЦикла;
	Полоса.Добавить("</div><div class='keys'>" + СтрСоединить(Ключи, "") + "</div>");
	Возврат СтрСоединить(Полоса, "");

КонецФункции

&НаСервереБезКонтекста
Функция НовыйСтатус(Название, Значение, Цвет)

	Статус = Новый Структура("Название, Значение, Цвет", Название, Значение, Цвет);
	Возврат Статус;

КонецФункции

// Код статуса от сервера → человеческое слово и цвет наклейки.
// Счёт O!Деньги живёт сутки: кто не заплатил за сутки, уже не заплатит.
&НаСервереБезКонтекста
Функция ВидСтатуса(Код, Отгружен = Ложь, Создан = '00010101')

	Если Код = "awaiting_payment" Тогда
		Если Создан <> '00010101' И ТекущаяДатаСеанса() - Создан > 86400 Тогда
			Возврат Новый Структура("Название, Фон, Цвет", "Не оплатил", "#eef1f5", "#5d6d7e");
		КонецЕсли;
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт оплаты", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "paid" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Оплачен, ждёт 1С", "#e7effd", "#1b4894");
	ИначеЕсли Код = "in_1c" Тогда
		Если Отгружен Тогда
			Возврат Новый Структура("Название, Фон, Цвет", "Отгружен", "#e4f3ec", "#14663c");
		КонецЕсли;
		// Деньги взяты, документы есть, товара на складе не было — заказ надо везти.
		Возврат Новый Структура("Название, Фон, Цвет", "Ждёт отгрузки", "#fdf0dc", "#8a5a10");
	ИначеЕсли Код = "failed" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Ошибка загрузки", "#fbe7e5", "#93261c");
	ИначеЕсли Код = "cancelled" Тогда
		Возврат Новый Структура("Название, Фон, Цвет", "Отменён", "#eef1f5", "#5d6d7e");
	КонецЕсли;
	Возврат Новый Структура("Название, Фон, Цвет", ?(ПустаяСтрока(Код), "—", Код), "#eef1f5", "#5d6d7e");

КонецФункции

// «сегодня 12:31» читается быстрее, чем «19.09.2026 12:31».
&НаСервереБезКонтекста
Функция КогдаЗаказ(Дата)

	Если Дата = '00010101' Тогда
		Возврат "—";
	КонецЕсли;
	Сегодня = НачалоДня(ТекущаяДатаСеанса());
	Если Дата >= Сегодня Тогда
		Возврат "сегодня " + Формат(Дата, "ДФ='HH:mm'");
	ИначеЕсли Дата >= Сегодня - 86400 Тогда
		Возврат "вчера " + Формат(Дата, "ДФ='HH:mm'");
	ИначеЕсли Год(Дата) = Год(Сегодня) Тогда
		Возврат Формат(Дата, "ДФ='dd.MM HH:mm'");
	КонецЕсли;
	Возврат Формат(Дата, "ДФ='dd.MM.yy HH:mm'");

КонецФункции

// Названия товаров заказа: до трёх строк, остальное числом.
// Сервер присылает только первые позиции, всего их — в itemsTotal.
&НаСервереБезКонтекста
Функция ТоварыЗаказа(Заказ)

	Позиции = Заказ.Получить("items");
	Если ТипЗнч(Позиции) <> Тип("Массив") ИЛИ Позиции.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Позиция Из Позиции Цикл
		Если ТипЗнч(Позиция) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Название = СтрокаИз(Позиция, "name");
		Если ПустаяСтрока(Название) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЧислоИз(Позиция, "qty");
		Части.Добавить(Э(Название) + ?(Количество > 1, " × " + Ч(Количество), ""));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат "<span class='dim'>—</span>";
	КонецЕсли;

	Всего = ЦелоеИз(Заказ, "itemsTotal");
	Ещё = Всего - Части.Количество();
	Результат = СтрСоединить(Части, "<br>");
	Если Ещё > 0 Тогда
		Результат = Результат + "<small>и ещё " + Ч(Ещё) + "</small>";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Заказы за период: когда сделан, когда оплачен, кто, что, на сколько.
&НаСервереБезКонтекста
Функция ТаблицаЗаказов(Список)

	Если Список.Количество() = 0 Тогда
		Возврат "<div class='note'>Таких заказов за период нет.</div>";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Создан</th><th>Оплачен</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th class='num'>Бонусами</th><th>Статус</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Создан = МестнаяДатаИзISO(Заказ.Получить("createdAt"));
		Оплачен = МестнаяДатаИзISO(Заказ.Получить("paidAt"));
		Статус = ВидСтатуса(СтрокаИз(Заказ, "status"), Заказ.Получить("realized") = Истина, Создан);
		Бонусами = ЧислоИз(Заказ, "bonusSpent");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Покупатель = ?(ПустаяСтрока(Имя), "<span class='dim'>без имени</span>", Э(Имя))
			+ ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Э(КогдаЗаказ(Создан)) + "</td>"
			+ "<td class='dim'>" + ?(Оплачен = '00010101', "—", Э(КогдаЗаказ(Оплачен))) + "</td>"
			+ "<td>" + Покупатель + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td class='num'>" + ?(Бонусами > 0, Э(Ч(Бонусами)), "<span class='dim'>—</span>") + "</td>"
			+ "<td><span class='pill' style='background:" + Статус.Фон + ";color:" + Статус.Цвет + "'>"
			+ Э(Статус.Название) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");
	Возврат СтрСоединить(Строки, "");

КонецФункции

// Оплаченные заказы, по которым надо что-то сделать: привезти товар, вернуть
// деньги, оформить вручную. Покупатель о нехватке не знает — знает владелец.
// Показывается всегда, какой бы период ни был выбран: такое нельзя пропустить.
&НаСервереБезКонтекста
Функция КарточкаВнимания(Список)

	Если Список.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Строки = Новый Массив;
	Строки.Добавить("<table><tr><th>Заказ</th><th>Оплачен</th><th>Покупатель</th><th>Товар</th>"
		+ "<th class='num'>Сумма</th><th>Что сделать</th><th>№ в 1С</th></tr>");
	Для Каждого Заказ Из Список Цикл
		Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Вид = СтрокаИз(Заказ, "kind");
		Если Вид = "failed" Тогда
			Дело = "Не попал в 1С — оформите заказ вручную";
			Цвет = "#93261c";
			Фон = "#fbe7e5";
		ИначеЕсли Вид = "waiting_1c" Тогда
			Дело = "1С не забирает — включите компьютер с 1С";
			Цвет = "#1b4894";
			Фон = "#e7effd";
		Иначе
			Дело = "Товара нет на складе — привезите или верните деньги";
			Цвет = "#8a5a10";
			Фон = "#fdf0dc";
		КонецЕсли;
		Оплачен = МестнаяДатаИзISO(Заказ.Получить("paidAt"));
		Дней = ?(Оплачен = '00010101', 0, Цел((ТекущаяДатаСеанса() - Оплачен) / 86400));
		Когда = Э(КогдаЗаказ(Оплачен)) + ?(Дней > 0, "<small>ждёт " + Ч(Дней) + " дн.</small>", "");
		Имя = СтрокаИз(Заказ, "customerName");
		Телефон = СтрокаИз(Заказ, "customerPhone");
		Номер1С = СтрокаИз(Заказ, "number1C");
		Строки.Добавить("<tr><td>" + Э(СтрокаИз(Заказ, "orderId")) + "</td>"
			+ "<td class='dim'>" + Когда + "</td>"
			+ "<td>" + Э(Имя) + ?(ПустаяСтрока(Телефон), "", "<small>" + Э(Телефон) + "</small>") + "</td>"
			+ "<td class='goods'>" + ТоварыЗаказа(Заказ) + "</td>"
			+ "<td class='num'>" + Э(Ч(ЧислоИз(Заказ, "total"))) + "</td>"
			+ "<td><span class='pill' style='background:" + Фон + ";color:" + Цвет + "'>" + Э(Дело) + "</span></td>"
			+ "<td class='dim'>" + ?(ПустаяСтрока(Номер1С), "—", Э(Номер1С)) + "</td></tr>");
	КонецЦикла;
	Строки.Добавить("</table>");

	Возврат "<div class='card full' style='border:2px solid #e8672d'><div class='head'>"
		+ "<b>&#9888; Оплачено — нужно действие</b><span>" + Э(Ч(Список.Количество()) + " заказ(ов) · покупатель о нехватке не знает")
		+ "</span></div>" + СтрСоединить(Строки, "") + "</div>";

КонецФункции

// Склад и сайт не совпадают — одна строка: сколько и где смотреть. Сам список
// на вкладке «Склад и сайт»: длинный, он заслонял графики.
&НаСервереБезКонтекста
Функция СтрокаСклада(Склад)

	Части = Новый Массив;
	Если Склад.БезОстатка > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#fbe7e5;color:#93261c;font-weight:600'>на сайте «В наличии», на складе 0: "
			+ Ч(Склад.БезОстатка) + "</span>");
	КонецЕсли;
	Если Склад.БезЦены > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#e7effd;color:#1b4894'>на складе есть, цены нет: "
			+ Ч(Склад.БезЦены) + "</span>");
	КонецЕсли;
	Если Склад.НетВНаличии > 0 Тогда
		Части.Добавить("<span class='pill' style='background:#eef1f5;color:#5d6d7e'>на складе есть, на сайте «нет»: "
			+ Ч(Склад.НетВНаличии) + "</span>");
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "<div class='strip'><b>&#9888; Склад и сайт не совпадают</b>" + СтрСоединить(Части, "")
		+ "<a href='#sklad'>открыть список &#8594;</a></div>";

КонецФункции

&НаСервереБезКонтекста
Функция ТекстПанели(Данные, НазваниеПериода, НазваниеОтбора, Склад)

	Заказы     = Раздел(Данные, "orders");
	Каталог    = Раздел(Данные, "catalog");
	Покупатели = Раздел(Данные, "customers");
	Коды       = Раздел(Данные, "codes");
	Каналы     = Раздел(Данные, "channels");

	СтарыйСервер = (ТипЗнч(Данные.Получить("period")) <> Тип("Соответствие"));
	ЗаПериод = ?(СтарыйСервер, ПериодИзСтарогоОтвета(Данные), Раздел(Данные, "period"));
	Итоги     = Раздел(ЗаПериод, "stats");
	Сравнение = Раздел(ЗаПериод, "compare");
	Было      = Раздел(Сравнение, "stats");

	// ── Какой период на экране и с чем сравниваем ─────────────────────────────
	НачалоПериода = ДеньИзISO(СтрокаИз(ЗаПериод, "from"));
	КонецПериода  = ДеньИзISO(СтрокаИз(ЗаПериод, "to"));
	Шапка = "<div class='cap'><b>" + Э(?(СтарыйСервер, "Сегодня", НазваниеПериода)) + "</b>" + Э(ОписаниеДат(НачалоПериода, КонецПериода));
	Если НЕ СтарыйСервер Тогда
		Шапка = Шапка + " · сравниваем: " + Э(СтрокаИз(Сравнение, "label")) + " ("
			+ Э(ОписаниеДат(ДеньИзISO(СтрокаИз(Сравнение, "from")), ДеньИзISO(СтрокаИз(Сравнение, "to")))) + ")";
	КонецЕсли;
	Шапка = Шапка + "</div>";
	Если СтарыйСервер Тогда
		Шапка = Шапка + "<div class='hint'>Сервер ещё не обновлён: показано только «сегодня», без сравнения. "
			+ "Даты «с» и «по» заработают после обновления сервера.</div>";
	КонецЕсли;

	// ── Плитки за период ─────────────────────────────────────────────────────
	Люди = ЧислоИз(Итоги, "people");
	Продаж = ЧислоИз(Итоги, "sales");
	Плитки = Новый Массив;
	Плитки.Добавить(Плитка("Люди на сайте", Ч(Люди), "",
		"страниц открыто " + Ч(ЧислоИз(Итоги, "views")),
		?(СтарыйСервер, "", Изменение(Люди, ЧислоИз(Было, "people")))));
	Плитки.Добавить(Плитка("Заказы", Ч(ЧислоИз(Итоги, "orders")), "",
		"оплачено " + Ч(Продаж),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "orders"), ЧислоИз(Было, "orders")))));
	Плитки.Добавить(Плитка("Выручка", Ч(ЧислоИз(Итоги, "money")), "сом",
		"деньгами через O!Деньги" + ?(ЧислоИз(Итоги, "bonus") > 0, " · бонусами " + Ч(ЧислоИз(Итоги, "bonus")), ""),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "money"), ЧислоИз(Было, "money"), "сом"))));
	Плитки.Добавить(Плитка("Средний чек", Ч(ЧислоИз(Итоги, "avgCheck")), "сом",
		"купили " + Формат(ЧислоИз(Итоги, "conversion"), "ЧДЦ=1; ЧН=0") + "% зашедших",
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "avgCheck"), ЧислоИз(Было, "avgCheck"), "сом"))));
	Плитки.Добавить(Плитка("Новые покупатели", Ч(ЧислоИз(Итоги, "newCustomers")), "",
		"входов в кабинет " + Ч(ЧислоИз(Итоги, "logins")),
		?(СтарыйСервер, "", Изменение(ЧислоИз(Итоги, "newCustomers"), ЧислоИз(Было, "newCustomers")))));
	// Эта плитка — про всё время, не про период: неотгруженный заказ ждёт, пока его не отвезут.
	ЖдутОтгрузки = ЦелоеИз(Заказы, "awaitingShipment");
	Если ЖдутОтгрузки > 0 Тогда
		Плитки.Добавить(Плитка("Ждут отгрузки", Ч(ЖдутОтгрузки), "",
			"оплачены, но товара не было на складе", "", Истина));
	КонецЕсли;

	// ── Графики по дням ──────────────────────────────────────────────────────
	Дни = МассивИз(Данные, "daily");
	Графики = Новый Массив;
	Графики.Добавить(КарточкаГрафика("Люди на сайте по дням", Ч(Люди) + " чел.",
		Дни, "people", "#1f9254", "#7cc79d"));
	Графики.Добавить(КарточкаГрафика("Заказы по дням", Ч(ЧислоИз(Итоги, "orders")),
		Дни, "orders", "#2563eb", "#93b4f5"));
	Графики.Добавить(КарточкаГрафика("Выручка по дням (по дню оплаты)", Ч(ЧислоИз(Итоги, "money")) + " сом",
		Дни, "paid", "#7a5af8", "#bfb0fb", Истина));

	// ── Путь покупателя, что покупают, что смотрят, статусы ──────────────────
	Статусы = Раздел(ЗаПериод, "statuses");
	СписокСтатусов = Новый Массив;
	СписокСтатусов.Добавить(НовыйСтатус("Ждут оплаты", ЦелоеИз(Статусы, "awaitingPayment"), "#e8a33d"));
	СписокСтатусов.Добавить(НовыйСтатус("Не оплатили", ЦелоеИз(Статусы, "abandoned"), "#c9cfd8"));
	СписокСтатусов.Добавить(НовыйСтатус("Оплачены, ждут 1С", ЦелоеИз(Статусы, "paidWaiting1C"), "#2563eb"));
	СписокСтатусов.Добавить(НовыйСтатус("Ждут отгрузки", ЦелоеИз(Статусы, "awaitingShipment"), "#e8672d"));
	СписокСтатусов.Добавить(НовыйСтатус("Отгружены", ЦелоеИз(Статусы, "shipped"), "#1f9254"));
	СписокСтатусов.Добавить(НовыйСтатус("С ошибкой", ЦелоеИз(Статусы, "failed"), "#d33b2e"));
	СписокСтатусов.Добавить(НовыйСтатус("Отменены", ЦелоеИз(Статусы, "cancelled"), "#8e99a8"));
	ВсегоСтатусов = 0;
	Для Каждого Статус Из СписокСтатусов Цикл
		ВсегоСтатусов = ВсегоСтатусов + Статус.Значение;
	КонецЦикла;
	ТелоСтатусов = ?(ВсегоСтатусов = 0, "<div class='note'>За период заказов не было.</div>",
		ПолосаСтатусов(СписокСтатусов, ВсегоСтатусов))
		+ "<div class='lines' style='margin-top:8px'>"
		+ Строчка("Бонусами оплачено за период", Ч(ЧислоИз(Итоги, "bonus")) + " сом", Истина)
		+ Строчка("Бонусами за всё время", Ч(ЧислоИз(Заказы, "bonusSpent")) + " сом")
		+ "</div>";

	Анализ = Новый Массив;
	Анализ.Добавить(Карточка("Путь покупателя", "сколько людей дошло", ПутьПокупателя(Итоги), "card c4"));
	Анализ.Добавить(Карточка("Что покупают", "шт · сом", ЧтоПокупают(МассивИз(ЗаПериод, "topProducts")), "card c4"));
	Анализ.Добавить(Карточка("Что смотрят", "разных людей", ЧтоСмотрят(МассивИз(ЗаПериод, "topViewed")), "card c4"));
	Анализ.Добавить(Карточка("Заказы за период", "всего " + Ч(ВсегоСтатусов), ТелоСтатусов, "card c4"));

	// ── Сайт сейчас: каталог, покупатели, код входа (от периода не зависят) ──
	ТоваровВсего   = ЦелоеИз(Каталог, "items");
	ГотовыКПродаже = ЦелоеИз(Каталог, "readyToSell");
	ДатаКаталога   = МестнаяДатаИзISO(Каталог.Получить("updatedAt"));
	ТелоКаталога = "<div class='lines'>"
		+ Строчка("Товаров в каталоге", Ч(ТоваровВсего))
		+ Строчка("Из них с ценой", Ч(ЦелоеИз(Каталог, "withPrice")))
		+ Строчка("Готовы к продаже", Ч(ГотовыКПродаже))
		+ Строчка("Обновлён", ?(ДатаКаталога = '00010101', "ещё не выгружался",
			Формат(ДатаКаталога, "ДФ='dd.MM.yyyy HH:mm'")), Истина)
		+ "</div>";

	ТелоПокупателей = "<div class='lines'>"
		+ Строчка("Всего в SBonus", Ч(ЦелоеИз(Покупатели, "active")))
		+ Строчка("Зарегистрировались на сайте", Ч(ЦелоеИз(Покупатели, "fromSite")))
		+ Строчка("Заказов с сайта за всё время", Ч(ЦелоеИз(Заказы, "total")), Истина)
		+ Строчка("Оплачено за всё время", Ч(ЧислоИз(Заказы, "paidTotal")) + " сом")
		+ "</div>";

	Телеграм = СтрокаИз(Каналы, "telegram");
	ВотсАп = СтрокаИз(Каналы, "whatsapp");
	ТелоКаналов = "<div class='lines'>"
		+ Строчка(Огонёк(Телеграм) + "Telegram", Телеграм)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "telegramToday")) + " / " + Ч(ЦелоеИз(Коды, "telegramWeek")))
		+ Строчка(Огонёк(ВотсАп) + "WhatsApp (запасной)", ВотсАп, Истина)
		+ Строчка("Кодов · сегодня / 7 дней",
			Ч(ЦелоеИз(Коды, "whatsappToday")) + " / " + Ч(ЦелоеИз(Коды, "whatsappWeek")))
		+ "</div>";

	Сейчас = Новый Массив;
	Сейчас.Добавить(Карточка("Каталог на сайте", "сейчас", ТелоКаталога));
	Сейчас.Добавить(Карточка("Покупатели", "всё время", ТелоПокупателей));
	Сейчас.Добавить(Карточка("Код для входа на сайт", "сейчас", ТелоКаналов));

	// ── Список заказов за период ─────────────────────────────────────────────
	СписокЗаказов = МассивИз(ЗаПериод, "orders");
	Найдено = ЦелоеИз(ЗаПериод, "ordersFound");
	Примечание = "найдено " + Ч(Найдено);
	Если ЧислоИз(ЗаПериод, "ordersAmount") > 0 Тогда
		Примечание = Примечание + " на " + Ч(ЧислоИз(ЗаПериод, "ordersAmount")) + " сом";
	КонецЕсли;
	Если Найдено > СписокЗаказов.Количество() Тогда
		Примечание = Примечание + " · показаны последние " + Ч(СписокЗаказов.Количество());
	КонецЕсли;
	Заголовок = ?(СтарыйСервер, "Последние заказы", "Заказы за период: " + НРег(НазваниеОтбора));
	ТаблицаПериода = "<div class='card full'><div class='head'><b>" + Э(Заголовок) + "</b>"
		+ "<span>" + Э(Примечание) + "</span></div>"
		+ ТаблицаЗаказов(СписокЗаказов) + "</div>";

	// Самое срочное — сразу под плитками: деньги взяты, а товара нет.
	Внимание = КарточкаВнимания(МассивИз(Данные, "attention"));

	Тело = "<div class='wrap'>" + Шапка + СтрокаСклада(Склад)
		+ "<div class='row'>" + СтрСоединить(Плитки, "") + "</div>"
		+ ?(ПустаяСтрока(Внимание), "", "<div class='row'>" + Внимание + "</div>")
		+ "<div class='row'>" + СтрСоединить(Графики, "") + "</div>"
		+ "<div class='row'>" + СтрСоединить(Анализ, "") + "</div>"
		+ "<div class='row'>" + ТаблицаПериода + "</div>"
		+ "<div class='row'>" + СтрСоединить(Сейчас, "") + "</div>"
		+ "</div>";
	Возврат Страница(Тело);

КонецФункции

// Зелёный кружок — канал отвечает, красный — нет. Сервер пишет состояние словами.
&НаСервереБезКонтекста
Функция Огонёк(СостояниеКанала)

	Цвет = ?(НРег(СостояниеКанала) = "работает", "#1f9254", "#d33b2e");
	Возврат "<i class='dot' style='background:" + Цвет + "'></i>";

КонецФункции

#КонецОбласти
