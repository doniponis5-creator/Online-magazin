# ════════════════════════════════════════════════════════════════════════════
# ОБРАЗЕЦ НАСТРОЕК САЙТА SMART CENTR (попадает в git, секретов здесь нет)
# Скопируйте в .env.local и заполните.
# ════════════════════════════════════════════════════════════════════════════

# ── 1. Сервер заказов SBonus ────────────────────────────────────────────────
SHOP_API_URL=https://api.smartcentr.store
# Значение SHOP_SITE_SECRET из /opt/sbonus/.env.production на сервере
SHOP_API_SECRET=

# ── 2. Режим оплаты ─────────────────────────────────────────────────────────
# Пусто — настоящая оплата O!Деньги; mock — тестовая оплата без денег
SHOP_PAYMENT_MODE=

# ── Демонстрационный вход для проверяющего из Apple ───────────────────────────
# Apple проверяет приложение вручную и не может получить код в Telegram на
# кыргызский номер. Один номер входит по заранее известному коду: в SBonus его
# нет, бонусы ему не начисляются, в 1С он не попадает.
# Пустые значения — демо-входа нет вообще.
# Эти же номер и код вписываются в App Store Connect → App Review Information.
SITE_DEMO_PHONE=
SITE_DEMO_CODE=
SITE_DEMO_NAME=Apple Review
SITE_DEMO_QR=SB-DEMO000001
SITE_DEMO_BALANCE=1500

# ── 3. Онлайн-консультант (чат на сайте) ────────────────────────────────────
# Ключ Google Gemini: https://aistudio.google.com/apikey — бесплатный тариф есть.
# Пусто — чат работает запасным режимом: поиск по каталогу и телефон магазина.
GEMINI_API_KEY=
# Модель. Пусто — gemini-3.5-flash-lite (быстрая и дешёвая).
GEMINI_MODEL=
# Журнал вопросов из чата: страница /panel/questions?key=…
# Пусто — страницы нет вовсе. Придумайте любое длинное слово и откройте
# https://smarket.kg/panel/questions?key=<это слово>
ASSISTANT_LOG_KEY=
# Где лежит журнал. Пусто — папка data рядом с сайтом.
ASSISTANT_LOG_DIR=

# ── 4. Телеграм-бот (тот же консультант в Telegram) ─────────────────────────
# Токен от @BotFather. Пусто — бота нет.
TELEGRAM_BOT_TOKEN=
# Условное слово, которым Telegram подписывает свои запросы к сайту.
# Придумайте любое длинное слово; оно же указывается при включении webhook.
TELEGRAM_WEBHOOK_SECRET=

# ── 5. Каталог прямо из 1С для чата ─────────────────────────────────────────
# Чат берёт цены и наличие с сервера заказов (п.1) раз в 10 минут.
# Отдельных настроек не нужно: работает, как только заполнены
# SHOP_API_URL и SHOP_API_SECRET. Пока они пустые — чат отвечает по каталогу,
# вшитому при сборке сайта.

# Сколько ответов языковой модели в день. Пусто — 1500.
# Норма кончилась — чат не замолкает, а отвечает поиском по каталогу.
ASSISTANT_DAILY_LIMIT=
