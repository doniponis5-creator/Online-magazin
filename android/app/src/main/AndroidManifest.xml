<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Свои экраны: бонусная карта и каталог без интернета. -->
        <activity
            android:name=".BonusCardActivity"
            android:theme="@style/AppTheme.Card"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".OfflineCatalogActivity"
            android:theme="@style/AppTheme.Catalog"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Как выглядят уведомления магазина (их показывает Firebase, а при
             открытом приложении — плагин push по тем же настройкам):
             белый знак «S» в строке состояния, лимонный акцент бренда и
             канал «Заказы» (его создаёт MainActivity при запуске).
             Без google-services.json Firebase в сборке нет и эти строки
             просто никто не читает. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_s" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_lemon" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="orders" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ показывает уведомления только с разрешения покупателя.
         Системное окно открывает сайт после входа (requestPermissions). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
